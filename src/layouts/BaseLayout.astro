---
import '../styles/global.css';
import BootLoader from '@/components/BootLoader.astro';
import ParticleBackground from '@/components/ParticleBackground.astro';
import { profile } from '@/data/profile';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = `${profile.name} | DevOps / Cloud Engineer | AWS | Kubernetes | Terraform`,
  description = profile.summary,
  canonical = Astro.url.pathname
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site || 'https://example.com').toString();
const personSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bengaluru',
    addressCountry: 'India'
  },
  sameAs: [profile.linkedin, profile.github]
};

if (profile.showPhone) {
  personSchema.telephone = profile.phone;
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${profile.name} Portfolio`,
  url: new URL('/', Astro.site || 'https://example.com').toString()
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#14161A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/og-image.svg', Astro.site || 'https://example.com').toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Google Fonts: Plus Jakarta Sans + Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Inline palette and theme initializer script to prevent FOUC -->
    <script is:inline>
      (function() {
        const PALETTE_BG = {
          'obsidian-violet': '#0B0B10',
          'cloud-daylight': '#F4F8FA'
        };

        let storedPalette = localStorage.getItem('portfolio-palette');
        // Migrate legacy palettes to Obsidian Violet
        if (storedPalette === 'midnight-cloud' || storedPalette === 'graphite-copper') {
          storedPalette = 'obsidian-violet';
          localStorage.setItem('portfolio-palette', storedPalette);
        }

        if (storedPalette !== 'obsidian-violet' && storedPalette !== 'cloud-daylight') {
          const storedTheme = localStorage.getItem('theme');
          const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'light' || (!storedTheme && !systemPrefersDark)) {
            storedPalette = 'cloud-daylight';
          } else {
            storedPalette = 'obsidian-violet';
          }
        }

        const isDark = storedPalette !== 'cloud-daylight';
        document.documentElement.setAttribute('data-palette', storedPalette);
        if (isDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }

        const metaThemeColor = document.querySelector('meta[name="theme-color"]');
        if (metaThemeColor && PALETTE_BG[storedPalette]) {
          metaThemeColor.setAttribute('content', PALETTE_BG[storedPalette]);
        }
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify([personSchema, websiteSchema])} />
  </head>
  <body class="bg-slate-50 dark:bg-ink text-slate-800 dark:text-slate-100 antialiased selection:bg-cyan/25 transition-colors duration-300 font-sans">
    <ParticleBackground />
    <BootLoader />
    <slot />
  </body>
</html>


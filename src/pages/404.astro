---
import Footer from '@/components/Footer.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';
---

<BaseLayout title={`404 | ${profile.name}`} description="The requested route does not exist.">
  <SiteHeader />
  <main class="grid min-h-[70vh] place-items-center px-4 py-20 text-center">
    <div class="max-w-xl rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-white/10 bg-white/90 dark:bg-panel2/80 p-8 sm:p-10 shadow-lg backdrop-blur-md">
      <p class="text-xs font-mono font-semibold uppercase tracking-[0.24em] text-cyan">404 — Route Not Found</p>
      <h1 class="mt-4 text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white font-display">Looks like this route does not exist.</h1>
      <p class="mt-3.5 text-sm sm:text-base text-slate-600 dark:text-slate-300">Return to the portfolio homepage to view verified DevOps, cloud, and SRE-focused work.</p>
      <a href="/" class="mt-6 inline-flex rounded-xl bg-slate-900 dark:bg-cyan px-6 py-3 text-sm font-semibold text-white dark:text-ink shadow-sm transition hover:scale-105">Return Home</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

---
import { ExternalLink } from '@lucide/astro';
import ArchitectureDiagram from '@/components/ArchitectureDiagram.astro';
import Footer from '@/components/Footer.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { profile, projects } from '@/data/profile';
import BaseLayout from '@/layouts/BaseLayout.astro';

const statusMap: Record<string, { label: string; cls: string }> = {
  'eks-microservices-gitops-observability': { label: 'deployed', cls: 'bg-mint/15 text-mint' },
  'terraform-aws-cloud-migration': { label: 'production', cls: 'bg-cyan/15 text-cyan' },
  'aks-elastic-stack-monitoring': { label: 'operational', cls: 'bg-violet/15 text-violet' }
};
---

<BaseLayout title={`Projects | ${profile.name} DevOps Portfolio`} description={`Resume-backed DevOps, cloud migration, Kubernetes, and observability project case studies by ${profile.name}.`}>
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <section class="py-10">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.24em] text-violet dark:text-violet">ls projects/</p>
      <div class="mt-5 grid gap-8 lg:grid-cols-[0.86fr_1.14fr] lg:items-end">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold leading-tight text-slate-900 dark:text-white font-display">Selected engineering work</h1>
        <p class="max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
          Infrastructure, Kubernetes, automation, and reliability case studies based on production resume experience.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        {['Infrastructure as Code', 'Kubernetes Platform', 'GitOps & CI/CD', 'Observability & SRE'].map((item) => (
          <span class="rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/[0.04] px-4 py-1.5 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 shadow-sm">{item}</span>
        ))}
      </div>
    </section>

    <section class="grid gap-7 py-8">
      {projects.map((project, index) => {
        const status = statusMap[project.slug] || { label: 'deployed', cls: 'bg-mint/15 text-mint' };
        return (
          <article class="grid gap-6 rounded-2xl sm:rounded-3xl p-6 lg:p-8 lg:grid-cols-[0.82fr_1.18fr] border border-slate-200 dark:border-white/[0.08] bg-white/90 dark:bg-panel2/80 shadow-md backdrop-blur-md">
            <div>
              <div class="flex items-center justify-between gap-3">
                <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">0{index + 1} | {project.category}</p>
                <span class:list={['rounded-full px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.14em]', status.cls]}>{status.label}</span>
              </div>
              <h2 class="mt-4 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white font-display">{project.name}</h2>
              <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300 text-sm sm:text-base">{project.problem}</p>
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                {project.metrics.map((metric) => (
                  <div class="rounded-xl border border-slate-200 dark:border-white/5 bg-slate-50 dark:bg-ink/50 p-3.5 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">{metric}</div>
                ))}
              </div>
              <p class="mt-6 font-mono text-xs text-slate-500 dark:text-slate-400">{project.stack.join(' · ')}</p>
              <a href={`/projects/${project.slug}`} class="mt-6 inline-flex items-center gap-2 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-ink px-5 py-3 text-sm font-semibold transition hover:-translate-y-0.5 shadow-sm">
                Read case study <ExternalLink size={16} />
              </a>
            </div>
            <div class="rounded-xl sm:rounded-2xl p-4 bg-slate-950 text-white overflow-hidden shadow-inner flex flex-col justify-center">
              <ArchitectureDiagram groups={project.architecture} />
            </div>
          </article>
        );
      })}
    </section>
  </main>
  <Footer />
</BaseLayout>

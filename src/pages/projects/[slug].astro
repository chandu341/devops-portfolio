---
import { ArrowLeft, ArrowRight, CircleCheckBig, Cpu, Layers, ShieldCheck, Sparkles } from '@lucide/astro';
import ArchitectureDiagram from '@/components/ArchitectureDiagram.astro';
import Footer from '@/components/Footer.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { profile, projects } from '@/data/profile';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BackToTop from '@/components/BackToTop.astro';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prevProject: projects[index - 1] || null,
      nextProject: projects[index + 1] || null
    }
  }));
}

const { project, prevProject, nextProject } = Astro.props;
---

<BaseLayout title={`${project.name} | ${profile.name}`} description={project.summary} canonical={`/projects/${project.slug}`}>
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12 sm:py-16 sm:px-6 lg:px-8">

    <!-- Breadcrumb Navigation -->
    <div class="mb-8 font-mono text-[11px] uppercase tracking-[0.18em] text-slate-500 dark:text-muted flex items-center gap-2 reveal-up">
      <a href="/projects" class="inline-flex items-center gap-1.5 text-violet hover:text-cyan transition font-semibold">
        <ArrowLeft size={14} /> ~/projects/
      </a>
      <span class="text-slate-400 dark:text-slate-400">/</span>
      <span class="text-slate-800 dark:text-slate-300 font-bold">{project.slug}</span>
    </div>

    <article class="space-y-10 sm:space-y-12">

      <!-- Header Section -->
      <header class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end border-b border-slate-200/80 dark:border-white/[0.08] pb-8 reveal-up">
        <div>
          <div class="flex items-center gap-2.5 mb-3">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.24em] text-violet dark:text-violet inline-flex items-center gap-2">
              <span class="inline-block h-1.5 w-3 rounded-full bg-cyan" aria-hidden="true"></span>
              {project.category}
            </span>
            {project.client && (
              <span class="rounded bg-cyan/10 dark:bg-cyan/15 border border-cyan/30 px-2 py-0.5 font-mono text-[10px] font-bold text-cyan">
                Client: {project.client}
              </span>
            )}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-slate-900 dark:text-white font-display">
            {project.name}
          </h1>
        </div>
        <div class="flex flex-col justify-between gap-4">
          <p class="text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300">
            {project.summary}
          </p>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded-full border border-mint/40 bg-mint/10 px-3 py-1 text-mint font-mono text-[10px] font-bold uppercase tracking-[0.14em] inline-flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse"></span>
              Production Verified
            </span>
            <span class="rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.04] px-3 py-1 font-mono text-slate-600 dark:text-slate-300">
              Zero-Downtime Deployment
            </span>
          </div>
        </div>
      </header>

      <!-- Key Outcomes & Telemetry Metrics Cards -->
      <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 reveal-up">
        {project.metrics.map((metric) => (
          <div class="surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-muted">Metric</span>
              <Sparkles size={14} class="text-cyan" />
            </div>
            <p class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white font-display">
              {metric.split(' ')[0]}
            </p>
            <p class="mt-2 text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-300">
              {metric}
            </p>
          </div>
        ))}
      </section>

      <!-- Interactive Architecture Topology Overview -->
      <section class="rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-white/[0.08] bg-white/90 dark:bg-panel2/80 p-6 sm:p-8 shadow-sm reveal-up">
        <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between border-b border-slate-200 dark:border-white/[0.08] pb-4">
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-violet dark:text-violet inline-flex items-center gap-2">
              <Layers size={14} class="text-cyan" />
              Architecture Flow
            </p>
            <h2 class="mt-1.5 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white font-display">
              Implementation Topology
            </h2>
          </div>
          <p class="max-w-md text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            End-to-end delivery topology structured from verified production experience and responsibilities.
          </p>
        </div>
        <div class="rounded-xl sm:rounded-2xl p-4 sm:p-6 bg-slate-950 text-white overflow-hidden shadow-inner border border-white/10">
          <ArchitectureDiagram groups={project.architecture} />
        </div>
      </section>

      <!-- Deep Dive Grid: Sidebar Meta + Problem, Solution, Outcomes -->
      <section class="grid gap-8 lg:grid-cols-[0.7fr_1.3fr] pt-2 reveal-up">

        <!-- Sidebar: Toolchain Stack & Evidence Integrity -->
        <aside class="space-y-6">
          <div class="surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-5 shadow-sm">
            <div class="flex items-center gap-2 mb-3">
              <Cpu size={16} class="text-cyan" />
              <h3 class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-violet dark:text-violet">
                Toolchain Stack
              </h3>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <span class="rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/90 dark:bg-white/[0.04] px-2.5 py-1 font-mono text-[11px] font-semibold text-slate-700 dark:text-slate-300">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-5 shadow-sm">
            <div class="flex items-center gap-2 mb-2.5">
              <ShieldCheck size={16} class="text-mint" />
              <h3 class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-violet dark:text-violet">
                Evidence Integrity
              </h3>
            </div>
            <p class="text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              Every deliverable and topology node is directly backed by validated production work at GENPACT / MNP Technologies.
            </p>
          </div>
        </aside>

        <!-- Main Narrative: Challenge, Approach & Deliverables -->
        <div class="space-y-6">
          <!-- Problem Statement -->
          <section class="surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-6 shadow-sm">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-violet dark:text-violet">
              01 // The Problem
            </p>
            <h2 class="mt-1.5 text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-display">
              The Operational Challenge
            </h2>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300">
              {project.problem}
            </p>
          </section>

          <!-- Technical Solution -->
          <section class="surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-6 shadow-sm">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-cyan">
              02 // The Solution
            </p>
            <h2 class="mt-1.5 text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-display">
              Engineering Architecture &amp; Delivery
            </h2>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300">
              {project.solution}
            </p>
          </section>

          <!-- Key Deliverables & Measurable Outcomes -->
          <section class="surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-6 shadow-sm">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-mint">
              03 // The Impact
            </p>
            <h2 class="mt-1.5 text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-display">
              Quantifiable Production Outcomes
            </h2>
            <ul class="mt-4 grid gap-3">
              {project.outcomes.map((outcome) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-300 rounded-xl bg-slate-50 dark:bg-white/[0.02] p-3 border border-slate-200/60 dark:border-white/5">
                  <CircleCheckBig class="mt-0.5 flex-shrink-0 text-mint" size={16} />
                  <span>{outcome}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>

      </section>

      <!-- Pagination / Next-Prev Project Navigation -->
      <nav class="border-t border-slate-200/80 dark:border-white/[0.08] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 reveal-up" aria-label="Case study pagination">
        {prevProject ? (
          <a
            href={`/projects/${prevProject.slug}`}
            class="flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-cyan transition"
          >
            <ArrowLeft size={16} />
            <span>Previous: {prevProject.name}</span>
          </a>
        ) : (
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Start of case studies</span>
        )}

        {nextProject ? (
          <a
            href={`/projects/${nextProject.slug}`}
            class="flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-cyan transition"
          >
            <span>Next: {nextProject.name}</span>
            <ArrowRight size={16} />
          </a>
        ) : (
          <a
            href="/projects"
            class="flex items-center gap-2 text-xs sm:text-sm font-semibold text-violet hover:text-cyan transition"
          >
            <span>All Projects</span>
            <ArrowRight size={16} />
          </a>
        )}
      </nav>

    </article>
  </main>
  <BackToTop />
  <Footer />
</BaseLayout>

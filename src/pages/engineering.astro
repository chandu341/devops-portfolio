---
import Footer from '@/components/Footer.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';

const futureNotes = [
  'Kubernetes pod failure troubleshooting checklist',
  'Terraform workflow for AWS environment provisioning',
  'Synthetic monitoring patterns with Selenium and Catchpoint',
  'CI/CD security checks with SonarQube and Trivy'
];
---

<BaseLayout title={`Engineering Notes | ${profile.name}`} description="Future engineering notes planned for Kubernetes, Terraform, CI/CD, monitoring, and cloud operations.">
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <SectionTitle eyebrow="Engineering Notes" title="A place for technical writing" description="Planned engineering write-ups covering production Kubernetes, Infrastructure as Code, CI/CD automation, and Observability." />
    <div class="grid gap-4 sm:grid-cols-2">
      {futureNotes.map((note) => (
        <article class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white/80 dark:bg-panel2/75 p-5 shadow-sm">
          <p class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan">Planned note</p>
          <h2 class="mt-2.5 text-lg font-bold text-slate-900 dark:text-white font-display">{note}</h2>
          <p class="mt-2.5 text-xs leading-relaxed text-slate-600 dark:text-slate-300">Resume-aligned engineering knowledge article.</p>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>

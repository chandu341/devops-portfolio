---
import { Award, Building2, Calendar, CircleCheck, ExternalLink, MapPin, Sparkles } from '@lucide/astro';
import ArchitectureDiagram from '@/components/ArchitectureDiagram.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactSection from '@/components/ContactSection.astro';
import FloatingContact from '@/components/FloatingContact.astro';
import BackToTop from '@/components/BackToTop.astro';
import TechIcon from '@/components/TechIcon.astro';
import { achievements, certifications, education, experiences, impactMetrics, profile, projects, skillGroups, stackYaml } from '@/data/profile';
import { allTechnologies } from '@/data/technologies';

const principleCards = [
  { id: '01', title: 'Automate toil', text: 'Reduce repetitive manual deployment and support work through reusable automation and IaC.' },
  { id: '02', title: 'Build reliable systems', text: 'Design for resilient infrastructure, health checks, and production-grade recovery paths.' },
  { id: '03', title: 'Observe everything', text: 'Document, monitor, and troubleshoot environments with structured observability and feedback loops.' }
];

const currentProject = projects[0];
---

<BaseLayout>
  <SiteHeader />
  <main id="main-content">
    <Hero />

    <!-- 02 — STATS / Production Impact & Telemetry -->
    <section id="stats" class="section-pad border-y border-slate-200 dark:border-white/[0.07] bg-slate-100/60 dark:bg-white/[0.02]" aria-label="Impact metrics">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">
        <div class="mb-6 sm:mb-8 reveal-up">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
            <span class="inline-block h-1 w-2.5 rounded-full bg-cyan" aria-hidden="true"></span>
            02 — git diff --stat
          </p>
          <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
            The career, diffed.
          </h2>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 xl:grid-cols-6">
          {impactMetrics.map((metric, i) => (
            <div class="metric-card p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-white/[0.06] bg-white/80 dark:bg-white/[0.03] flex flex-col justify-between h-full reveal-up shadow-sm dark:shadow-none" style={`animation-delay:${i * 60}ms`}>
              <div>
                <p class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white stat-counter font-display" data-target={metric.value}>{metric.value}</p>
                <p class="mt-1.5 font-mono text-[10px] sm:text-[11px] font-semibold uppercase tracking-[0.18em] text-violet dark:text-violet">{metric.label}</p>
              </div>
              <p class="mt-2.5 text-xs leading-5 text-slate-600 dark:text-muted">{metric.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 — WHOAMI / Philosophy & Engineering Principles -->
    <section id="about" class="section-pad">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">
        <div class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 reveal-up">
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
              <span class="inline-block h-1 w-2.5 rounded-full bg-cyan" aria-hidden="true"></span>
              03 — whoami
            </p>
            <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
              Reliability is built, not assumed.
            </h2>
          </div>
          <span class="hidden sm:inline-flex rounded-full border border-cyan/40 bg-cyan/[0.08] px-3.5 py-1 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan">
            {profile.availability}
          </span>
        </div>

        <div class="space-y-6 sm:space-y-8 reveal-up">
          <!-- Professional Narrative Summary (Philosophy & Working Approach) -->
          <div class="rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-white/[0.07] bg-white/80 dark:bg-white/[0.02] p-6 sm:p-8 space-y-4 text-base sm:text-lg leading-relaxed sm:leading-8 text-slate-700 dark:text-slate-300 shadow-sm dark:shadow-none">
            <p>Production systems should be predictable and resilient. My engineering approach centers on eliminating operational guesswork through deterministic infrastructure as code, automated verification gates, and deep runtime telemetry across cloud platforms.</p>
            <p>Rather than treating DevOps as a collection of disjointed tools, I focus on building unified delivery feedback loops—where code flows safely to production, infrastructure drifts are caught automatically, and incidents lead directly to self-healing runbooks and systemic hardening.</p>
          </div>

          <!-- Engineering Principles 3-Col Grid -->
          <div class="grid gap-4 md:grid-cols-3">
            {principleCards.map((card) => (
              <article class="engineering-principle surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-5 sm:p-6 transition hover:-translate-y-1 flex flex-col justify-between shadow-sm">
                <div>
                  <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-violet">{card.id}</span>
                  <h3 class="mt-2.5 text-lg sm:text-xl font-bold text-slate-900 dark:text-white font-display">{card.title}</h3>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{card.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 04 — EXPERIENCE / Career Deployment History -->
    <section id="experience" class="section-pad bg-slate-100/60 dark:bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">

        <div class="mb-8 sm:mb-12 reveal-up">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
            <span class="inline-block h-1 w-2.5 rounded-full bg-cyan" aria-hidden="true"></span>
            04 — git log --career
          </p>
          <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
            Deployment history.
          </h2>
          <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl font-normal">
            Production cloud operations, Kubernetes platform delivery, and automated infrastructure across enterprise environments.
          </p>
        </div>

        <div class="career-timeline">
          {experiences.map((job, index) => {
            const isCurrent = index === 0;
            return (
              <article class="career-timeline__item reveal-up" style={`animation-delay:${index * 80}ms`}>
                <div class:list={["career-timeline__marker", isCurrent && "career-timeline__marker--current"]} aria-hidden="true"></div>

                <div class:list={[
                  "career-timeline__content rounded-2xl sm:rounded-3xl surface border p-5 sm:p-7 lg:p-8 transition-all duration-300",
                  isCurrent
                    ? "border-cyan/40 dark:border-cyan/30 shadow-md ring-1 ring-cyan/15 dark:ring-cyan/20"
                    : "border-slate-200 dark:border-white/[0.08] shadow-sm"
                ]}>

                  <!-- Top Row: Release Meta & Status Badge -->
                  <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/80 dark:border-white/[0.07] pb-4 mb-5">
                    <div class="flex items-center gap-2.5">
                      <span class="font-mono text-[11px] sm:text-xs font-bold uppercase tracking-[0.18em] text-cyan">
                        release/{job.dates.split(' to ')[1] ? job.dates.split(' to ')[1].toLowerCase().replace(/\s+/g, '-') : 'current'}{isCurrent ? ' — HEAD' : ''}
                      </span>
                    </div>

                    {isCurrent ? (
                      <span class="self-start sm:self-auto inline-flex items-center gap-2 rounded-full border border-mint/40 bg-mint/[0.08] px-3.5 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-mint shadow-2xs">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
                        </span>
                        Current / Active Deployment
                      </span>
                    ) : (
                      <span class="self-start sm:self-auto inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.04] px-3 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-600 dark:text-slate-300">
                        <span class="h-1.5 w-1.5 rounded-full bg-slate-400 dark:bg-slate-500"></span>
                        Completed Deployment
                      </span>
                    )}
                  </div>

                  <!-- Role Title & Company / Client Header -->
                  <div>
                    <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
                      {job.role}
                    </h3>

                    <div class="mt-3 flex flex-wrap items-center gap-y-2 gap-x-3 text-xs sm:text-sm">
                      <!-- Company Tag -->
                      <div class="inline-flex items-center gap-1.5 font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-white/[0.08] px-2.5 py-1 rounded-md border border-slate-200 dark:border-white/10">
                        <Building2 size={14} class="text-violet" />
                        <span>{job.company}</span>
                      </div>

                      <!-- Client Tag (if applicable) -->
                      {job.client && (
                        <div class="inline-flex items-center gap-1.5 rounded-md bg-cyan/10 dark:bg-cyan/15 border border-cyan/30 px-2.5 py-1 text-xs font-bold text-cyan-900 dark:text-cyan-300">
                          <span class="text-cyan font-mono text-[10px] uppercase tracking-wider">Client:</span>
                          <span>{job.client}</span>
                        </div>
                      )}

                      <!-- Location -->
                      {job.location && (
                        <div class="inline-flex items-center gap-1 text-slate-600 dark:text-slate-400 font-normal">
                          <MapPin size={13} class="text-slate-400" />
                          <span>{job.location}</span>
                        </div>
                      )}

                      <!-- Dates -->
                      <div class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-slate-600 dark:text-slate-400">
                        <Calendar size={13} class="text-slate-400" />
                        <span>{job.dates}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Highlight Achievements -->
                  <div class="mt-6">
                    <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mb-3">
                      Key Deliverables &amp; Engineering Outcomes
                    </p>
                    <ul class="grid gap-3 text-sm leading-relaxed text-slate-700 dark:text-slate-300 lg:grid-cols-2">
                      {job.highlights.map((item) => (
                        <li class="flex items-start gap-2.5 rounded-xl bg-slate-50/90 dark:bg-white/[0.025] border border-slate-200/70 dark:border-white/[0.04] p-3.5 transition-colors hover:border-cyan/30">
                          <CircleCheck size={16} class="mt-0.5 text-cyan flex-shrink-0" />
                          <span class="text-xs sm:text-sm font-normal text-slate-700 dark:text-slate-300 leading-snug">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Declared Technology Stack -->
                  <div class="mt-6 pt-5 border-t border-slate-200/80 dark:border-white/[0.07]">
                    <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mb-2.5">
                      Verified Toolchain &amp; Technologies
                    </p>
                    <div class="flex flex-wrap gap-1.5 sm:gap-2">
                      {job.technologies.map((tech) => (
                        <span class="inline-flex items-center gap-1 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-100/90 dark:bg-white/[0.04] px-2.5 py-1 font-mono text-[10px] sm:text-[11px] font-semibold text-slate-800 dark:text-slate-200 transition-all hover:border-cyan/50 hover:bg-cyan/10 hover:text-cyan-800 dark:hover:text-cyan-300">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>

                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 05 — PROJECTS -->
    <section id="projects" class="section-pad">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">
        <div class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 reveal-up">
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
              <span class="inline-block h-1 w-2.5 rounded-full bg-cyan" aria-hidden="true"></span>
              05 — ls projects/
            </p>
            <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
              Things I've shipped.
            </h2>
          </div>
          <a href="/projects" class="self-start sm:self-auto inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-white dark:bg-white/[0.03] px-4 py-2 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 hover:border-cyan/40 shadow-sm">
            All projects <ExternalLink size={14} />
          </a>
        </div>
        <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
          <article class="project-card project-card--featured surface rounded-2xl sm:rounded-3xl p-5 sm:p-6 lg:p-8 reveal-up shadow-md">
            <div class="flex items-center justify-between gap-3">
              <p class="font-mono text-[10px] sm:text-xs font-semibold uppercase tracking-[0.18em] text-slate-600 dark:text-slate-400">01 | {currentProject.category}</p>
              <span class="rounded-full bg-mint/12 px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-mint">deployed</span>
            </div>
            <h3 class="mt-3 sm:mt-4 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white font-display">{currentProject.name}</h3>
            <p class="mt-3 sm:mt-4 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">{currentProject.problem}</p>
            <div class="mt-5 sm:mt-6 grid gap-2.5 sm:gap-3 sm:grid-cols-3">
              {currentProject.metrics.map((metric) => <div class="rounded-xl bg-slate-100 dark:bg-ink/50 p-3.5 sm:p-4 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-white/5">{metric}</div>)}
            </div>
            <div class="mt-5 sm:mt-6 rounded-xl sm:rounded-2xl bg-slate-950 p-3.5 sm:p-4 text-white overflow-hidden shadow-inner">
              <ArchitectureDiagram groups={currentProject.architecture} />
            </div>
            <a href={`/projects/${currentProject.slug}`} class="mt-5 sm:mt-6 inline-flex items-center gap-2 rounded-xl bg-slate-900 dark:bg-white px-5 py-3 text-sm font-semibold text-white dark:text-ink transition hover:-translate-y-0.5 shadow-md">
              Read case study <ExternalLink size={16} />
            </a>
          </article>
          <div class="grid gap-5 sm:gap-6">
            {projects.slice(1).map((project, index) => (
              <article class="project-card surface rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-white/[0.08] p-5 sm:p-6 reveal-up flex flex-col justify-between shadow-sm" style={`animation-delay:${index * 80}ms`}>
                <div>
                  <div class="flex items-center justify-between gap-3">
                    <p class="font-mono text-[10px] sm:text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-muted">0{index + 2} | {project.category}</p>
                    <span class="rounded-full bg-violet/10 px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-violet">production</span>
                  </div>
                  <h3 class="mt-3 text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-display">{project.name}</h3>
                  <p class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{project.problem}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {project.metrics.map((metric) => <span class="rounded-lg bg-slate-100 dark:bg-white/[0.06] border border-slate-200 dark:border-white/5 px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-slate-700 dark:text-slate-200 font-mono">{metric}</span>)}
                  </div>
                </div>
                <a href={`/projects/${project.slug}`} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-violet hover:text-cyan transition">
                  Open case study <ExternalLink size={15} />
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 06 — VISUAL SKILLS & TOOLCHAIN ECOSYSTEM -->
    <section id="skills" class="section-pad bg-slate-100/60 dark:bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">
        
        <div class="mb-8 sm:mb-10 reveal-up">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
            <span class="inline-block h-1 w-2.5 rounded-full bg-cyan" aria-hidden="true"></span>
            06 — visual toolchain &amp; declared stack
          </p>
          <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
            The technical ecosystem, visualized.
          </h2>
          <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl font-normal">
            Technologies and tooling verified across 5+ years of production cloud engineering, Kubernetes delivery, and automated infrastructure.
          </p>
        </div>

        <!-- 1. Visual Tool Cards Grid (6 Columns x 3 Rows) -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-3.5 mb-10 reveal-up">
          {allTechnologies.map((tool) => (
            <div class="group flex flex-col justify-between rounded-2xl border border-slate-200/90 dark:border-white/[0.08] bg-white/90 dark:bg-panel2 p-3.5 sm:p-4 shadow-2xs hover:shadow-md transition-all duration-200 hover:-translate-y-1 hover:border-cyan/50 dark:hover:border-cyan/40">
              <!-- Top Header: Logo + Tag -->
              <div class="flex items-center justify-between gap-2">
                <span class="transition-transform duration-200 group-hover:scale-110 flex-shrink-0">
                  <TechIcon name={tool.id} size={28} />
                </span>
                <span class="rounded-md border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.05] px-1.5 py-0.5 font-mono text-[8px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex-shrink-0">
                  {tool.tag}
                </span>
              </div>
              <!-- Content: Name + Description -->
              <div class="mt-3">
                <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate font-display">{tool.name}</h3>
                <p class="mt-0.5 font-mono text-[10px] text-slate-500 dark:text-slate-400 truncate">{tool.shortDesc}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- 2. Side-by-Side: Interactive YAML Manifest + Categorized Skill Groups -->
        <div class="grid gap-6 lg:grid-cols-[1fr_1.1fr]">

          <!-- YAML Manifest Viewer -->
          <div class="stack-panel rounded-2xl sm:rounded-3xl border border-slate-300 dark:border-white/10 bg-slate-900 text-slate-100 overflow-hidden reveal-up shadow-md flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between border-b border-white/[0.08] px-4 py-3 bg-black/30">
                <div class="flex items-center gap-2">
                  <span class="status-dot red"></span><span class="status-dot amber"></span><span class="status-dot green"></span>
                  <span class="ml-2 font-mono text-[10px] tracking-widest text-slate-400 uppercase">infra/stack.yaml</span>
                </div>
                <span class="font-mono text-[9px] text-mint uppercase tracking-wider">● drift-checked</span>
              </div>
              <pre class="overflow-x-auto p-4 sm:p-5 font-mono text-xs leading-relaxed text-slate-200 m-0 bg-transparent"><code><span class="yaml-line"><span class="yaml-comment"># infra/stack.yaml — declarative toolchain</span></span>
<span class="yaml-line"><span class="yaml-key">stack:</span></span>
{Object.entries(stackYaml).map(([key, vals]) => (
  <span class="yaml-line">  <span class="yaml-key">{key}:</span><span class="yaml-val"> [{vals.join(', ')}]</span></span>
))}
<span class="yaml-line"><span class="yaml-comment"># mode: zero-downtime · observable · resilient</span></span>
</code></pre>
            </div>
            <div class="border-t border-white/[0.08] p-4 bg-black/20 text-xs font-mono text-slate-400 flex items-center justify-between">
              <span>Environment: Multi-AZ Production</span>
              <span class="text-cyan">AWS &amp; Azure Ready</span>
            </div>
          </div>

          <!-- Structured Capability Pillars (All 10 Categories) -->
          <div class="grid gap-3 sm:grid-cols-2 reveal-up" style="animation-delay:100ms">
            {skillGroups.map((group) => (
              <article class="surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-3.5 sm:p-4 transition hover:-translate-y-0.5 shadow-sm flex flex-col justify-between">
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white font-display leading-tight">{group.name}</h3>
                    <span class="rounded-full bg-slate-100 dark:bg-white/[0.05] px-1.5 py-0.5 font-mono text-[8px] font-semibold uppercase tracking-wider text-slate-600 dark:text-muted flex-shrink-0">{group.tier}</span>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-300">{group.skills.join(' · ')}</p>
                </div>
              </article>
            ))}
          </div>

        </div>

      </div>
    </section>

    <!-- 07 — CREDENTIALS -->
    <section id="credentials" class="section-pad">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">
        <div class="mb-8 sm:mb-10 reveal-up">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
            <span class="inline-block h-1 w-2.5 rounded-full bg-cyan" aria-hidden="true"></span>
            07 — ls -la credentials/
          </p>
          <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
            Proof, not promises.
          </h2>
        </div>

        <div class="mb-8 sm:mb-10 reveal-up">
          <p class="mb-3 sm:mb-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-muted">Certifications</p>

          <p class="mb-3 sm:mb-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-muted">Recognition</p>
          <div class="grid gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
            {achievements.map((item, i) => (
              <article class="credential-card surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-4 sm:p-5 reveal-up flex flex-col justify-between shadow-sm" style={`animation-delay:${i * 60}ms`}>

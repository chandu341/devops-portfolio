---
interface Props {
  groups: Array<{ group: string; nodes: string[] }>;
}

const { groups } = Astro.props;
---

<div class="architecture-flow" style={`--cols: ${groups.length || 4}`}>
  {groups.map((group, index) => (
    <div class="architecture-group group/card transition-all duration-300 hover:border-cyan/40">
      <div class="flex items-center justify-between gap-2 border-b border-slate-200/80 dark:border-white/[0.08] pb-2.5 mb-3">
        <p class="font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-cyan font-bold flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan animate-pulse"></span>
          {group.group}
        </p>
        <span class="font-mono text-[9px] text-slate-500">Tier 0{index + 1}</span>
      </div>

      <div class="grid gap-2">
        {group.nodes.map((node) => (
          <div class="rounded-xl border border-slate-200/90 dark:border-white/10 bg-slate-50/80 dark:bg-white/[0.04] px-3 py-2 text-xs sm:text-sm font-mono text-slate-800 dark:text-slate-200 transition-colors duration-200 hover:bg-slate-100 dark:hover:bg-white/[0.08] hover:border-cyan/30 flex items-center justify-between gap-2">
            <span class="truncate">{node}</span>
            <span class="h-1 w-1 rounded-full bg-mint/70 flex-shrink-0" title="Active node"></span>
          </div>
        ))}
      </div>

      {index < groups.length - 1 && (
        <span class="architecture-connector" aria-hidden="true">
          <span class="connector-pulse"></span>
        </span>
      )}
    </div>
  ))}
</div>

<style>
  .architecture-flow {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: 1.25rem;
    position: relative;
  }

  .architecture-group {
    position: relative;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1rem 1.15rem;
    min-height: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  :global(.dark) .architecture-group {
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .architecture-connector {
    position: absolute;
    top: 50%;
    right: -1.25rem;
    width: 1.25rem;
    height: 2px;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    z-index: 10;
  }

  :global(.dark) .architecture-connector {
    background: linear-gradient(90deg, var(--primary), var(--secondary));
  }

  .connector-pulse {
    position: absolute;
    top: -2px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary-glow);
    animation: connectorTravel 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  :global(.dark) .connector-pulse {
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary-glow);
  }

  .architecture-connector::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -3px;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--secondary);
    border-right: 2px solid var(--secondary);
    transform: rotate(45deg);
  }

  :global(.dark) .architecture-connector::after {
    border-top: 2px solid var(--secondary);
    border-right: 2px solid var(--secondary);
  }

  @keyframes connectorTravel {
    0% {
      left: 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .architecture-flow {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .architecture-connector {
      left: 50%;
      right: auto;
      top: auto;
      bottom: -1.5rem;
      width: 2px;
      height: 1.5rem;
      transform: translateX(-50%);
    }

    .connector-pulse {
      top: 0;
      left: -2px;
      animation: connectorTravelVertical 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    .architecture-connector::after {
      right: auto;
      left: -3px;
      top: auto;
      bottom: -1px;
      transform: rotate(135deg);
    }
  }

  @keyframes connectorTravelVertical {
    0% {
      top: 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connector-pulse {
      display: none !important;
    }
  }
</style>

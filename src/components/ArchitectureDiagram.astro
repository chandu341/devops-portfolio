---
interface Props {
  groups: Array<{ group: string; nodes: string[] }>;
}

const { groups } = Astro.props;
---

<div class="architecture-flow" style={`--cols: ${groups.length || 4}`}>
  {groups.map((group, index) => (
    <div class="architecture-group group/card transition-all duration-300 hover:border-cyan/40">
      <div class="flex items-center justify-between gap-1.5 border-b border-slate-200/80 dark:border-white/[0.08] pb-2 mb-2.5">
        <p class="font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.14em] text-cyan font-bold flex items-center gap-1.5 min-w-0">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan animate-pulse flex-shrink-0"></span>
          <span class="truncate" title={group.group}>{group.group}</span>
        </p>
        <span class="font-mono text-[9px] text-slate-400 dark:text-slate-500 flex-shrink-0">T0{index + 1}</span>
      </div>

      <div class="grid gap-1.5">
        {group.nodes.map((node) => (
          <div class="rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/80 dark:bg-white/[0.04] px-2.5 py-1.5 text-[11px] sm:text-xs font-mono text-slate-800 dark:text-slate-200 transition-colors duration-200 hover:bg-slate-100 dark:hover:bg-white/[0.08] hover:border-cyan/30 flex items-center justify-between gap-1.5 min-w-0">
            <span class="leading-snug break-words min-w-0 flex-1">{node}</span>
            <span class="h-1 w-1 rounded-full bg-mint/80 flex-shrink-0 ml-1" title="Active node"></span>
          </div>
        ))}
      </div>

      {index < groups.length - 1 && (
        <span class="architecture-connector hidden md:block" aria-hidden="true">
          <span class="connector-pulse"></span>
        </span>
      )}
    </div>
  ))}
</div>

<style>
  .architecture-flow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.875rem;
    position: relative;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .architecture-flow {
      grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .architecture-group {
    position: relative;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.85rem 0.95rem;
    min-width: 0;
    box-sizing: border-box;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  :global(.dark) .architecture-group {
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .architecture-connector {
    position: absolute;
    top: 50%;
    right: -1.25rem;
    width: 1.25rem;
    height: 2px;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    z-index: 10;
  }

  :global(.dark) .architecture-connector {
    background: linear-gradient(90deg, var(--primary), var(--secondary));
  }

  .connector-pulse {
    position: absolute;
    top: -2px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary-glow);
    animation: connectorTravel 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  :global(.dark) .connector-pulse {
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary-glow);
  }

  .architecture-connector::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -3px;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--secondary);
    border-right: 2px solid var(--secondary);
    transform: rotate(45deg);
  }

  :global(.dark) .architecture-connector::after {
    border-top: 2px solid var(--secondary);
    border-right: 2px solid var(--secondary);
  }

  @keyframes connectorTravel {
    0% {
      left: 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connector-pulse {
      display: none !important;
    }
  }
</style>

---
import {
  Award,
  CircleCheck,
  ExternalLink,
  GraduationCap,
  ShieldCheck,
  Sparkles,
  Trophy
} from '@lucide/astro';
import { achievements, certifications, education, profile } from '@/data/profile';
---

<section id="credentials" class="section-pad relative overflow-hidden" aria-label="Professional Certifications & Recognition">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">

    <!-- Section Header -->
    <div class="mb-10 sm:mb-12 reveal-up">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
            <span class="inline-block h-1 w-2.5 rounded-full bg-cyan" aria-hidden="true"></span>
            08 — credentials &amp; recognition
          </p>
          <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
            Proof, not promises.
          </h2>
        </div>
        <div class="flex items-center gap-2 rounded-full border border-amber/40 bg-amber/10 px-3.5 py-1.5 font-mono text-xs font-semibold text-amber">
          <ShieldCheck size={14} />
          <span>Verified Credentials</span>
        </div>
      </div>
      <p class="mt-4 max-w-3xl text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Demonstrated technical competence through industry certifications, enterprise delivery recognition, and continuous professional development.
      </p>
    </div>

    <!-- Certifications Pills Grid -->
    <div class="mb-10 reveal-up">
      <p class="mb-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 flex items-center gap-2">
        <Award size={14} class="text-amber" />
        <span>Industry Certifications</span>
      </p>
      <div class="flex flex-wrap gap-3">
        {certifications.map((cert) => (
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="cred-pill rounded-xl border border-slate-200 dark:border-white/10 bg-white/90 dark:bg-white/[0.03] px-4 py-3 text-xs sm:text-sm text-slate-800 dark:text-slate-200 transition hover:border-amber/50 hover:shadow-md inline-flex items-center gap-2.5 font-medium backdrop-blur-xs"
          >
            <span class="p-1 rounded-md bg-amber/10 text-amber">
              <Award size={16} />
            </span>
            <span>{cert}</span>
            <ExternalLink size={13} class="text-slate-400 ml-1" />
          </a>
        ))}
      </div>
    </div>

    <!-- Recognition & Key Achievements Cards -->
    <div class="mb-10 reveal-up">
      <p class="mb-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 flex items-center gap-2">
        <Trophy size={14} class="text-mint" />
        <span>Enterprise Impact &amp; Recognition</span>
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {achievements.map((item, i) => (
          <article
            class="surface rounded-2xl border border-slate-200 dark:border-white/[0.08] p-5 shadow-sm flex flex-col justify-between hover:border-mint/40 transition"
            style={`animation-delay: ${i * 60}ms`}
          >
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-mint bg-mint/10 border border-mint/20 px-2 py-0.5 rounded">
                Impact Metric 0{i + 1}
              </span>
              <Sparkles size={15} class="text-mint flex-shrink-0" />
            </div>
            <p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-300 font-sans">
              {item}
            </p>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/5 flex items-center gap-1.5 font-mono text-[10px] text-slate-500 dark:text-slate-400">
              <CircleCheck size={12} class="text-mint" />
              <span>Production Verified</span>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Academic Education -->
    <div class="reveal-up">
      <p class="mb-4 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 flex items-center gap-2">
        <GraduationCap size={14} class="text-cyan" />
        <span>Formal Education</span>
      </p>
      <div class="surface rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-white/[0.08] p-6 sm:p-7 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-cyan">
            {education.date}
          </span>
          <h3 class="mt-1.5 text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-display">
            {education.degree}
          </h3>
          <p class="mt-1 text-sm sm:text-base text-slate-600 dark:text-slate-300">
            {education.institution}
          </p>
        </div>
        <div class="flex items-center gap-2 rounded-xl bg-cyan/10 border border-cyan/20 px-3.5 py-2 font-mono text-xs text-cyan font-bold">
          <span>Bachelor of Technology</span>
        </div>
      </div>
    </div>

  </div>
</section>

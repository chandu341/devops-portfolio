---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="mb-10 max-w-3xl">
  <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet inline-flex items-center gap-2">
    <span class="inline-block h-1 w-2.5 rounded-full bg-cyan/80" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 class="text-4xl font-semibold tracking-normal text-white sm:text-5xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-muted sm:text-lg">{description}</p>}
</div>

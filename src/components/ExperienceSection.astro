---
import { Building2, Calendar, CircleCheck, GitCommitVertical, GitPullRequest, MapPin } from '@lucide/astro';
import { experiences } from '@/data/profile';

const releaseTags = [
  { commit: '7f9a2d1', tag: 'release/v2.4-honeywell', branch: 'main (HEAD)' },
  { commit: '4c8e1b3', tag: 'release/v2.0-ge-migration', branch: 'releases/prod' },
  { commit: '1a5f9c0', tag: 'release/v1.0-trainee-foundations', branch: 'releases/archive' }
];
---

<section id="experience" class="section-pad border-t border-slate-200 dark:border-white/[0.07] bg-slate-100/60 dark:bg-white/[0.02]" aria-label="Career experience and deployment history">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">

    <!-- Section Header -->
    <div class="mb-10 sm:mb-12 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 reveal-up">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
          <span class="inline-block h-1.5 w-3 rounded-full bg-cyan" aria-hidden="true"></span>
          04 — git log --career
        </p>
        <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
          Deployment history &amp; career log.
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl font-normal">
          5+ years of verified production cloud operations, Kubernetes platform delivery, and automated infrastructure across enterprise environments.
        </p>
      </div>

      <!-- Quick Summary Stat Badge -->
      <div class="hidden md:flex items-center gap-2 rounded-xl border border-slate-200 dark:border-white/10 bg-white/80 dark:bg-panel p-2.5 shadow-xs">
        <div class="grid h-8 w-8 place-items-center rounded-lg bg-cyan/10 text-cyan">
          <GitPullRequest size={16} />
        </div>
        <div class="text-left pr-2">
          <p class="font-mono text-[9px] uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold">Total Experience</p>
          <p class="font-mono text-xs font-bold text-slate-900 dark:text-white">5+ Years Verified</p>
        </div>
      </div>
    </div>

    <!-- Interactive Career Timeline -->
    <div class="career-timeline">
      {experiences.map((job, index) => {
        const isCurrent = index === 0;
        const release = releaseTags[index] || { commit: '0000000', tag: `release/v${index}`, branch: 'main' };

        return (
          <article class="career-timeline__item reveal-up" style={`animation-delay:${index * 80}ms`}>
            <!-- Timeline Track Node Marker -->
            <div class:list={["career-timeline__marker", isCurrent && "career-timeline__marker--current"]} aria-hidden="true"></div>

            <!-- Card Body Container -->
            <div class:list={[
              "career-timeline__content rounded-2xl sm:rounded-3xl surface border p-5 sm:p-7 lg:p-8 transition-all duration-300",
              isCurrent
                ? "border-cyan/50 dark:border-cyan/40 shadow-md ring-1 ring-cyan/20 dark:ring-cyan/30 bg-white/95 dark:bg-panel2"
                : "border-slate-200 dark:border-white/[0.08] shadow-sm bg-white/90 dark:bg-panel"
            ]}>

              <!-- Top Row: Git Release Meta & Deployment Status Badge -->
              <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/80 dark:border-white/[0.07] pb-4 mb-5">
                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                  <!-- Commit SHA -->
                  <span class="inline-flex items-center gap-1 font-mono text-[10px] sm:text-[11px] font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-white/[0.05] px-2 py-0.5 rounded border border-slate-200 dark:border-white/10">
                    <GitCommitVertical size={12} class="text-cyan" />
                    {release.commit}
                  </span>
                  <!-- Release Tag -->
                  <span class="font-mono text-[11px] sm:text-xs font-bold uppercase tracking-[0.16em] text-cyan">
                    {release.tag}
                  </span>
                  <!-- Branch -->
                  <span class="hidden sm:inline-block font-mono text-[10px] text-slate-600 dark:text-slate-300">
                    on {release.branch}
                  </span>
                </div>

                <!-- Status Badge -->
                {isCurrent ? (
                  <span class="self-start sm:self-auto inline-flex items-center gap-2 rounded-full border border-mint/40 bg-mint/[0.08] px-3.5 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-mint shadow-2xs">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
                    </span>
                    Active Production Deployment
                  </span>
                ) : (
                  <span class="self-start sm:self-auto inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.04] px-3 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-600 dark:text-slate-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400 dark:bg-slate-500"></span>
                    Archived Deployment
                  </span>
                )}
              </div>

              <!-- Role Title & Company Header -->
              <div>
                <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
                  {job.role}
                </h3>

                <div class="mt-3 flex flex-wrap items-center gap-y-2 gap-x-3 text-xs sm:text-sm">
                  <!-- Company -->
                  <div class="inline-flex items-center gap-1.5 font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-white/[0.08] px-2.5 py-1 rounded-md border border-slate-200 dark:border-white/10">
                    <Building2 size={14} class="text-violet" />
                    <span>{job.company}</span>
                  </div>

                  <!-- Client (if applicable) -->
                  {job.client && (
                    <div class="inline-flex items-center gap-1.5 rounded-md bg-cyan/10 dark:bg-cyan/15 border border-cyan/30 px-2.5 py-1 text-xs font-bold text-cyan">
                      <span class="text-cyan font-mono text-[10px] uppercase tracking-wider">Client:</span>
                      <span>{job.client}</span>
                    </div>
                  )}

                  <!-- Location -->
                  {job.location && (
                    <div class="inline-flex items-center gap-1 text-slate-600 dark:text-slate-400 font-normal">
                      <MapPin size={13} class="text-slate-400" />
                      <span>{job.location}</span>
                    </div>
                  )}

                  <!-- Dates -->
                  <div class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-slate-600 dark:text-slate-400">
                    <Calendar size={13} class="text-slate-400" />
                    <span>{job.dates}</span>
                  </div>
                </div>
              </div>

              <!-- Highlight Achievements & Outcomes -->
              <div class="mt-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-600 dark:text-slate-300 mb-3 font-semibold">
                  Key Deliverables &amp; Engineering Outcomes
                </p>
                <ul class="grid gap-3 text-sm leading-relaxed text-slate-700 dark:text-slate-300 lg:grid-cols-2">
                  {job.highlights.map((item) => (
                    <li class="flex items-start gap-2.5 rounded-xl bg-slate-50/90 dark:bg-white/[0.025] border border-slate-200/70 dark:border-white/[0.04] p-3.5 transition-colors hover:border-cyan/30">
                      <CircleCheck size={16} class="mt-0.5 text-cyan flex-shrink-0" />
                      <span class="text-xs sm:text-sm font-normal text-slate-700 dark:text-slate-300 leading-snug">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Declared Technology Stack Tags -->
              <div class="mt-6 pt-5 border-t border-slate-200/80 dark:border-white/[0.07]">
                <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-600 dark:text-slate-300 mb-2.5 font-semibold">
                  Verified Toolchain &amp; Stack
                </p>
                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  {job.technologies.map((tech) => (
                    <span class="inline-flex items-center gap-1 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-100/90 dark:bg-white/[0.04] px-2.5 py-1 font-mono text-[10px] sm:text-[11px] font-semibold text-slate-800 dark:text-slate-200 transition-all hover:border-cyan/50 hover:bg-cyan/10 hover:text-cyan">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

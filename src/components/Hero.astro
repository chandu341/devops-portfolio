<!-- Interactive Pipeline Node Relationship Engine (IDLE, HOVER, CONNECTED) -->
<script is:inline>
  (function () {
    const canvas = document.getElementById('devops-pipeline-canvas');
    if (!canvas) return;

    const nodes = canvas.querySelectorAll('.pipeline-node');
    const profileNode = document.getElementById('node-profile');
    const paths = canvas.querySelectorAll('.pipeline-path');

    function highlightNetwork(activeNode) {
      const activeId = activeNode.getAttribute('data-tech-id');
      const connStr = activeNode.getAttribute('data-connections') || '';
      const connectedIds = connStr.split(',').filter(Boolean);
      connectedIds.push(activeId);

      // Node state styling
      nodes.forEach((node) => {
        const id = node.getAttribute('data-tech-id');
        const pill = node.querySelector('.node-pill');
        if (id === activeId) {
          node.classList.add('is-hovered');
          node.classList.remove('is-dimmed', 'is-connected');
          if (pill) pill.classList.add('ring-2', 'ring-cyan', 'scale-105', 'bg-white', 'dark:bg-panel');
        } else if (connectedIds.includes(id)) {
          node.classList.add('is-connected');
          node.classList.remove('is-dimmed', 'is-hovered');
          if (pill) pill.classList.add('ring-1', 'ring-violet/60', 'scale-102');
        } else {
          node.classList.add('is-dimmed');
          node.classList.remove('is-hovered', 'is-connected');
        }
      });

      // Highlight matching SVG paths
      paths.forEach((path) => {
        const from = path.getAttribute('data-from');
        const to = path.getAttribute('data-to');
        if (
          (from === activeId && connectedIds.includes(to)) ||
          (to === activeId && connectedIds.includes(from)) ||
          (connectedIds.includes(from) && connectedIds.includes(to))
        ) {
          path.classList.add('is-active-path');
          path.setAttribute('stroke-width', '2.5');
          path.style.opacity = '1';
        } else {
          path.classList.remove('is-active-path');
          path.setAttribute('stroke-width', '1');
          path.style.opacity = '0.15';
        }
      });
    }

    function resetNetwork() {
      nodes.forEach((node) => {
        node.classList.remove('is-hovered', 'is-connected', 'is-dimmed');
        const pill = node.querySelector('.node-pill');
        if (pill) {
          pill.classList.remove('ring-2', 'ring-1', 'ring-cyan', 'ring-violet/60', 'scale-105', 'scale-102', 'bg-white', 'dark:bg-panel');
        }
      });

      paths.forEach((path) => {
        path.classList.remove('is-active-path');
        path.setAttribute('stroke-width', '1.5');
        path.style.opacity = '';
      });
    }

    nodes.forEach((node) => {
      node.addEventListener('mouseenter', () => highlightNetwork(node));
      node.addEventListener('focus', () => highlightNetwork(node));
      node.addEventListener('mouseleave', resetNetwork);
      node.addEventListener('blur', resetNetwork);
    });

    if (profileNode) {
      profileNode.addEventListener('mouseenter', () => highlightNetwork(profileNode));
      profileNode.addEventListener('mouseleave', resetNetwork);
    }
  })();
</script>

<style>
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate-in {
    animation: heroFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Pipeline Path Dash Animation */
  @keyframes pipelineFlowDrift {
    to {
      stroke-dashoffset: -16;
    }
  }

  .pipeline-path[stroke-dasharray] {
    animation: pipelineFlowDrift 2.5s linear infinite;
  }

  /* Node State Transitions */
  .pipeline-node.is-dimmed {
    opacity: 0.35;
    transform: translate(-50%, -50%) scale(0.96);
  }

  .pipeline-node.is-connected {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.02);
  }

  .pipeline-node.is-hovered {
    opacity: 1;
    z-index: 30;
    transform: translate(-50%, -50%) scale(1.08);
  }

  .pipeline-path.is-active-path {
    filter: drop-shadow(0 0 4px rgba(2, 132, 199, 0.6));
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-animate-in,
    .pipeline-path {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

---
import { 
  ArrowRight, 
  BriefcaseBusiness, 
  Code2, 
  Download, 
  Mail, 
  MapPin, 
  ShieldCheck 
} from '@lucide/astro';
import { profile } from '@/data/profile';
import TechIcon from '@/components/TechIcon.astro';
import { primaryTechnologies, secondaryTechnologies } from '@/data/technologies';
---

<section class="relative overflow-hidden pt-8 sm:pt-12 lg:pt-16 pb-14 lg:pb-20" id="top">
  <!-- Refined Ambient Lighting Halo (Adapts naturally to Light and Dark modes) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 left-1/4 h-[500px] w-[500px] rounded-full bg-cyan/[0.06] dark:bg-cyan/[0.07] blur-[120px]"></div>
    <div class="absolute top-1/4 right-0 h-[450px] w-[450px] rounded-full bg-violet/[0.05] dark:bg-violet/[0.07] blur-[120px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14 xl:gap-16">

      <!-- ========================================================================= -->
      <!-- LEFT COLUMN: Identity, Value Proposition & Intentional Actions            -->
      <!-- ========================================================================= -->
      <div class="space-y-6 sm:space-y-7">
        
        <!-- 1. Availability Status Indicator -->
        <div class="hero-animate-in flex items-center gap-3" style="animation-delay: 0ms;">
          <span class="inline-flex items-center gap-2 rounded-full border border-mint/40 bg-mint/[0.08] px-3 py-1 font-mono text-[11px] font-semibold text-mint">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
            </span>
            <span>Available for DevOps &amp; Cloud Opportunities</span>
          </span>
        </div>

        <!-- 2. Candidate Identity & Professional Designation -->
        <div class="hero-animate-in space-y-2" style="animation-delay: 80ms;">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white font-display leading-[1.08]">
            {profile.name}
          </h1>
          <p class="text-lg sm:text-xl lg:text-2xl font-semibold text-slate-700 dark:text-slate-300 font-display">
            DevOps &amp; Cloud Engineer
          </p>
        </div>

        <!-- 3. Short Professional Value Proposition (Fast Recruiter Scan) -->
        <div class="hero-animate-in space-y-3" style="animation-delay: 150ms;">
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl font-normal">
            Building reliable cloud infrastructure, Kubernetes platforms, and automated delivery systems.
          </p>
          <div class="flex items-center gap-2 font-mono text-xs text-slate-500 dark:text-slate-400">
            <MapPin size={13} class="text-cyan flex-shrink-0" />
            <span>{profile.location}</span>
            <span class="text-slate-300 dark:text-slate-600">·</span>
            <span>5+ Years Production Experience</span>
          </div>
        </div>

        <!-- 4. Primary CTAs (Strictly Max 2 High-Contrast Actions) -->
        <div class="hero-animate-in pt-1 flex flex-wrap items-center gap-3.5" style="animation-delay: 220ms;">
          <!-- Primary CTA -->
          <a
            href="/projects"
            class="group inline-flex items-center gap-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-ink px-6 py-3.5 text-sm sm:text-base font-semibold shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Explore Case Studies</span>
            <ArrowRight size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
          </a>

          <!-- Secondary CTA -->
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-300 dark:border-white/15 bg-white dark:bg-white/[0.04] text-slate-800 dark:text-slate-200 px-5 py-3.5 text-sm sm:text-base font-semibold transition-all duration-200 hover:border-slate-400 dark:hover:border-white/30 hover:bg-slate-50 dark:hover:bg-white/[0.08] active:scale-[0.98] shadow-sm"
          >
            <Download size={16} />
            <span>Resume</span>
          </a>
        </div>

        <!-- 5. Compact Social & Direct Contact Links (No Cluttered Heavy Cards) -->
        <div class="hero-animate-in pt-2 flex items-center gap-4 text-xs font-medium text-slate-600 dark:text-slate-400" style="animation-delay: 290ms;">
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-slate-950 dark:hover:text-white transition-colors"
            aria-label="GitHub Profile"
          >
            <Code2 size={16} class="text-slate-500 dark:text-slate-400" />
            <span>GitHub</span>
          </a>

          <span class="text-slate-300 dark:text-slate-700">/</span>

          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-violet transition-colors"
            aria-label="LinkedIn Profile"
          >
            <BriefcaseBusiness size={16} class="text-slate-500 dark:text-slate-400" />
            <span>LinkedIn</span>
          </a>

          <span class="text-slate-300 dark:text-slate-700">/</span>

          <a
            href={`mailto:${profile.email}`}
            class="flex items-center gap-1.5 hover:text-cyan transition-colors"
            aria-label="Send Email"
          >
            <Mail size={16} class="text-slate-500 dark:text-slate-400" />
            <span>Email</span>
          </a>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- RIGHT COLUMN: Major Profile Focal Centerpiece & Technology Ecosystem      -->
      <!-- ========================================================================= -->
      <div class="hero-animate-in relative flex flex-col items-center" style="animation-delay: 150ms;">
        
        <!-- Profile Portrait with Ambient Halo Glow -->
        <div class="relative group">
          
          <!-- Soft Ambient Light Glow -->
          <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-cyan/30 via-violet/20 to-mint/20 opacity-70 blur-xl transition duration-500 group-hover:opacity-90"></div>

          <!-- Profile Portrait Frame -->
          <div class="relative h-48 w-48 sm:h-56 sm:w-56 lg:h-64 lg:w-64 overflow-hidden rounded-3xl border-2 border-white/80 dark:border-white/20 bg-slate-100 dark:bg-panel2 shadow-xl">
            <img
              src={profile.photo}
              alt={profile.name}
              class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
          </div>

          <!-- Refined Experience Badge -->
          <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-white/15 bg-white/95 dark:bg-panel2/95 px-3 py-1 font-mono text-[10px] font-semibold text-slate-800 dark:text-slate-200 shadow-md backdrop-blur-md">
              <ShieldCheck size={13} class="text-mint" />
              <span>5+ Yrs Production Ops</span>
            </span>
          </div>

        </div>

        <!-- Visual Technology Ecosystem (Connected Directly Below Profile) -->
        <div class="mt-8 w-full max-w-lg space-y-3">
          
          <!-- Primary Tier: Core Pillars (Kubernetes, Terraform, AWS, Docker) Matching Reference Image -->
          <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
            {primaryTechnologies.map((tech) => (
              <div 
                class="group flex flex-col justify-between rounded-2xl border border-slate-300/80 dark:border-white/[0.09] bg-[#CFD6E0] dark:bg-[#18202E] p-3 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-cyan/50"
                title={`${tech.name} · ${tech.category}`}
              >
                <!-- Top Row: Icon on Left, Tag on Right -->
                <div class="flex items-center justify-between gap-1.5">
                  <span class="transition-transform duration-200 group-hover:scale-110 flex-shrink-0">
                    <TechIcon name={tech.id} size={28} />
                  </span>
                  <span class="rounded-md border border-slate-400/40 dark:border-white/15 bg-slate-300/60 dark:bg-white/[0.06] px-1.5 py-0.5 font-mono text-[8px] font-bold uppercase tracking-wider text-slate-800 dark:text-slate-300 flex-shrink-0">
                    {tech.tag}
                  </span>
                </div>

                <!-- Middle & Bottom: Tech Name & Short Description -->
                <div class="mt-2.5">
                  <span class="block text-xs font-bold text-slate-950 dark:text-white truncate font-display">{tech.name}</span>
                  <span class="block font-mono text-[9px] text-slate-600 dark:text-slate-400 truncate mt-0.5">{tech.shortDesc}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Secondary Tier: Supporting Ecosystem Nodes (Compact Row with Real Logos) -->
          <div class="flex flex-wrap items-center justify-center gap-1.5 pt-1">
            {secondaryTechnologies.slice(0, 8).map((tech) => (
              <span 
                class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200/80 dark:border-white/[0.08] bg-white/80 dark:bg-white/[0.02] px-2.5 py-1 text-xs text-slate-700 dark:text-slate-300 transition-colors hover:border-cyan/40 hover:bg-slate-100 dark:hover:bg-white/[0.06]"
                title={`${tech.name} · ${tech.category}`}
              >
                <TechIcon name={tech.id} size={14} />
                <span class="font-medium text-[11px]">{tech.name}</span>
              </span>
            ))}
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

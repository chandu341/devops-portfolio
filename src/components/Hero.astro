---
import {
  ArrowRight,
  BriefcaseBusiness,
  CodeXml,
  Download,
  Layers,
  Mail,
  MapPin,
  ShieldCheck,
  Sparkles
} from '@lucide/astro';
import { profile } from '@/data/profile';
import TechIcon from '@/components/TechIcon.astro';

// Exactly 8 Curated Core Technologies for the Hero Constellation
// Primary Ring (Inner, 4 nodes): AWS, Terraform, Kubernetes, Docker
// Secondary Ring (Outer, 4 nodes): Azure, GitHub Actions, Prometheus, Grafana
const constellationNodes = [
  // Primary Ring (Inner 4 nodes around profile)
  {
    id: 'aws',
    name: 'AWS',
    tag: 'Cloud',
    domain: 'Public Cloud',
    accent: 'cyan',
    ring: 'primary',
    x: 170,
    y: 140,
    pathD: 'M 170 140 Q 205 165, 235 195',
    dur: '3.2s',
    begin: '0.4s'
  },
  {
    id: 'terraform',
    name: 'Terraform',
    tag: 'IaC',
    domain: 'Cloud Provisioning',
    accent: 'violet',
    ring: 'primary',
    x: 390,
    y: 140,
    pathD: 'M 390 140 Q 355 165, 325 195',
    dur: '3.2s',
    begin: '0.8s'
  },
  {
    id: 'kubernetes',
    name: 'Kubernetes',
    tag: 'Platform',
    domain: 'Container Orchestration',
    accent: 'cyan',
    ring: 'primary',
    x: 390,
    y: 340,
    pathD: 'M 390 340 Q 355 315, 325 285',
    dur: '3.2s',
    begin: '2.0s'
  },
  {
    id: 'docker',
    name: 'Docker',
    tag: 'Containers',
    domain: 'Container Runtime',
    accent: 'cyan',
    ring: 'primary',
    x: 170,
    y: 340,
    pathD: 'M 170 340 Q 205 315, 235 285',
    dur: '3.2s',
    begin: '2.4s'
  },

  // Secondary Ring (Outer 4 nodes filling the corners)
  {
    id: 'grafana',
    name: 'Grafana',
    tag: 'Dashboards',
    domain: 'APM & Telemetry',
    accent: 'mint',
    ring: 'secondary',
    x: 75,
    y: 65,
    pathD: 'M 75 65 Q 160 125, 230 185',
    dur: '3.5s',
    begin: '0s'
  },
  {
    id: 'azure',
    name: 'Azure',
    tag: 'Cloud',
    domain: 'Public Cloud',
    accent: 'cyan',
    ring: 'secondary',
    x: 485,
    y: 65,
    pathD: 'M 485 65 Q 400 125, 330 185',
    dur: '3.5s',
    begin: '1.2s'
  },
  {
    id: 'githubactions',
    name: 'GitHub Actions',
    tag: 'CI/CD',
    domain: 'Automated Delivery',
    accent: 'violet',
    ring: 'secondary',
    x: 485,
    y: 415,
    pathD: 'M 485 415 Q 400 355, 330 295',
    dur: '3.5s',
    begin: '1.6s'
  },
  {
    id: 'prometheus',
    name: 'Prometheus',
    tag: 'Metrics',
    domain: 'Monitoring & Alerts',
    accent: 'mint',
    ring: 'secondary',
    x: 75,
    y: 415,
    pathD: 'M 75 415 Q 160 355, 230 295',
    dur: '3.5s',
    begin: '2.8s'
  }
];
---

<section class="relative overflow-hidden pt-6 sm:pt-10 lg:pt-14 pb-12 sm:pb-16 lg:pb-24" id="top">

  <!-- Ambient Background Glow Mesh (Theme-adaptive) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 left-1/4 h-[550px] w-[550px] rounded-full bg-cyan/[0.07] dark:bg-cyan/[0.08] blur-[130px]"></div>
    <div class="absolute top-1/3 right-0 h-[500px] w-[500px] rounded-full bg-violet/[0.06] dark:bg-violet/[0.08] blur-[130px]"></div>
    <div class="absolute -bottom-20 left-1/3 h-[400px] w-[400px] rounded-full bg-mint/[0.04] dark:bg-mint/[0.05] blur-[120px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0">

    <!-- Main Hero Layout: Left Column (Identity, Values, Proofs, CTAs) + Right Column (Constellation Layout) -->
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1.15fr] lg:gap-12 xl:gap-16">

      <!-- ========================================================================= -->
      <!-- LEFT COLUMN: Editorial Identity, Proven Value & High-Contrast CTAs       -->
      <!-- ========================================================================= -->
      <div class="space-y-6 sm:space-y-7">

        <!-- 1. Live Availability & Location Status Badge -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2.5" style="animation-delay: 0ms;">
          <span class="inline-flex items-center gap-2 rounded-full border border-mint/40 bg-mint/[0.08] px-3.5 py-1 font-mono text-[11px] font-semibold text-mint">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
            </span>
            <span>Available for DevOps &amp; Cloud Roles</span>
          </span>

          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">
            <MapPin size={13} class="text-cyan flex-shrink-0" />
            <span>{profile.location}</span>
          </span>
        </div>

        <!-- 2. Masterpiece Typographic Name & Title -->
        <div class="hero-animate-in space-y-3" style="animation-delay: 80ms;">
          <div class="space-y-1">
            <span class="block font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] text-cyan font-bold">
              Engineering Portfolio
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight font-display leading-[1.05] text-slate-900 dark:text-white">
              <span class="inline sm:block">Chandu</span>{' '}
              <span class="inline sm:block bg-gradient-to-r from-cyan via-violet to-mint bg-clip-text text-transparent">
                Venna
              </span>
            </h1>
          </div>

          <!-- Professional Designation Pill Bar -->
          <div class="flex items-center gap-3 pt-1">
            <div class="h-1 w-12 rounded-full bg-gradient-to-r from-cyan to-violet"></div>
            <p class="text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 dark:text-slate-200 font-display">
              DevOps &amp; Cloud Engineer
            </p>
          </div>
        </div>

        <!-- 3. Value Proposition Statement -->
        <div class="hero-animate-in space-y-4" style="animation-delay: 150ms;">
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl font-normal">
            Building reliable cloud infrastructure, Kubernetes platforms, and automated delivery systems across AWS and Azure.
          </p>
        </div>

        <!-- ========================================================================= -->
        <!-- MOBILE-ONLY VIEW (< 768px): Standalone Profile + 8-Node Clean Grid        -->
        <!-- ========================================================================= -->
        <div class="block lg:hidden space-y-5 pt-1 pb-1">

          <!-- Standalone Mobile Profile Picture Anchor -->
          <div class="flex items-center gap-4 p-4 rounded-2xl border border-slate-200/90 dark:border-white/[0.08] bg-white/80 dark:bg-panel2/80 backdrop-blur-md shadow-sm">
            <div class="relative flex-shrink-0">
              <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-cyan via-violet to-mint opacity-60 blur-sm"></div>
              <div class="relative h-16 w-16 overflow-hidden rounded-2xl border-2 border-white dark:border-white/20 bg-slate-100 dark:bg-panel shadow-md">
                <img
                  src={profile.photo}
                  alt={profile.name}
                  class="h-full w-full object-cover object-center"
                  loading="eager"
                  width="64"
                  height="64"
                />
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="font-display font-bold text-base text-slate-900 dark:text-white truncate">
                  {profile.name}
                </span>
                <span class="inline-flex items-center rounded-full bg-mint/10 px-2 py-0.5 font-mono text-[9px] font-bold text-mint">
                  ● 5+ Yrs Ops
                </span>
              </div>
              <p class="font-mono text-xs text-slate-600 dark:text-slate-300 truncate">
                DevOps &amp; Cloud Platform Engineer
              </p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5">
                AWS · Azure · Kubernetes · Terraform
              </p>
            </div>
          </div>

          <!-- Mobile 8-Node Technology Grid (No lines, clean fallback) -->
          <div class="rounded-2xl border border-slate-200/90 dark:border-white/[0.08] bg-slate-50/90 dark:bg-panel/90 p-4 space-y-3">
            <div class="flex items-center justify-between px-0.5">
              <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Core Technology Ecosystem
              </span>
              <span class="font-mono text-[9px] text-cyan uppercase tracking-wider">
                8 Core Tools
              </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              {constellationNodes.map((t) => (
                <div class="flex items-center gap-2 p-2 rounded-xl border border-slate-200/80 dark:border-white/[0.06] bg-white dark:bg-panel2 shadow-2xs">
                  <span class="flex-shrink-0">
                    <TechIcon name={t.id} size={18} />
                  </span>
                  <div class="min-w-0">
                    <span class="block text-xs font-bold text-slate-900 dark:text-white truncate leading-tight">
                      {t.name}
                    </span>
                    <span class="block font-mono text-[8px] uppercase tracking-wider text-slate-500 dark:text-slate-400 truncate">
                      {t.tag}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>

        <!-- 4. Resume-Verified Proof Points (Max 3 Points) -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2 pt-1 font-mono text-xs text-slate-600 dark:text-slate-300" style="animation-delay: 200ms;">
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <ShieldCheck size={13} class="text-cyan" />
            <span>5+ Yrs Production Ops</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <Layers size={13} class="text-violet" />
            <span>Multi-AZ K8s &amp; IaC</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <Sparkles size={13} class="text-mint" />
            <span>60% Faster Deployments</span>
          </span>
        </div>

        <!-- 5. High-Contrast Primary & Secondary CTAs -->
        <div class="hero-animate-in pt-1 flex flex-wrap items-center gap-3.5" style="animation-delay: 240ms;">
          <!-- Primary CTA -->
          <a
            href="/projects"
            class="group inline-flex items-center gap-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-ink px-6 py-3.5 text-sm sm:text-base font-semibold shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Explore Case Studies</span>
            <ArrowRight size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
          </a>

          <!-- Secondary CTA -->
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-300 dark:border-white/15 bg-white dark:bg-white/[0.04] text-slate-800 dark:text-slate-200 px-5 py-3.5 text-sm sm:text-base font-semibold transition-all duration-200 hover:border-slate-400 dark:hover:border-white/30 hover:bg-slate-50 dark:hover:bg-white/[0.08] active:scale-[0.98] shadow-sm"
          >
            <Download size={16} />
            <span>Resume</span>
          </a>
        </div>

        <!-- 6. Compact Social & Direct Contact Channels -->
        <div class="hero-animate-in pt-1 flex items-center gap-4 text-xs font-medium text-slate-600 dark:text-slate-400" style="animation-delay: 290ms;">
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-slate-950 dark:hover:text-white transition-colors"
            aria-label="GitHub Profile"
          >
            <CodeXml size={16} class="text-slate-500 dark:text-slate-400" />
            <span>GitHub</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-violet transition-colors"
            aria-label="LinkedIn Profile"
          >
            <BriefcaseBusiness size={16} class="text-slate-500 dark:text-slate-400" />
            <span>LinkedIn</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={`mailto:${profile.email}`}
            class="flex items-center gap-1.5 hover:text-cyan transition-colors"
            aria-label="Send Email"
          >
            <Mail size={16} class="text-slate-500 dark:text-slate-400" />
            <span>Email</span>
          </a>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- RIGHT COLUMN: Desktop Constellation Layout with SVG Lines & Pulses        -->
      <!-- ========================================================================= -->
      <div class="hero-animate-in relative hidden lg:block" style="animation-delay: 150ms;">

        <div
          class="relative w-full h-[520px] select-none rounded-3xl border border-slate-200/90 dark:border-white/[0.08] bg-slate-50/40 dark:bg-panel/50 backdrop-blur-xl p-4 overflow-hidden shadow-xl"
          id="hero-constellation-canvas"
        >

          <!-- Ambient Radial Backdrop -->
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-30 dark:opacity-20" aria-hidden="true">
            <div class="h-96 w-96 rounded-full border border-dashed border-cyan/40"></div>
            <div class="absolute h-64 w-64 rounded-full border border-dashed border-violet/40"></div>
          </div>

          <!-- =================================================================== -->
          <!-- SVG CONNECTOR LINES & DATA STREAM PULSES                             -->
          <!-- =================================================================== -->
          <svg
            class="absolute inset-0 h-full w-full pointer-events-none overflow-visible z-0"
            viewBox="0 0 560 520"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            id="constellation-svg"
          >
            <defs>
              <!-- Glowing Filter for Traveling Pulses -->
              <filter id="pulse-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="2.5" result="coloredBlur"/>
                <feMerge>
                  <feMergeNode in="coloredBlur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>

              <!-- Line Gradients -->
              <linearGradient id="line-cyan" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0284C7" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.3" />
              </linearGradient>
              <linearGradient id="line-violet" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#6366F1" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#818CF8" stop-opacity="0.3" />
              </linearGradient>
              <linearGradient id="line-mint" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#059669" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#34D399" stop-opacity="0.3" />
              </linearGradient>
            </defs>

            <!-- 8 Curved Connection Paths from each Node into the Center Profile Circle -->
            {constellationNodes.map((node) => (
              <path
                id={`path-${node.id}`}
                data-node-id={node.id}
                d={node.pathD}
                class="constellation-path"
                stroke={node.accent === 'mint' ? 'url(#line-mint)' : node.accent === 'violet' ? 'url(#line-violet)' : 'url(#line-cyan)'}
                stroke-width="1.2"
                stroke-dasharray="4 4"
              />
            ))}

            <!-- Continuous Data Stream Pulses traveling along each path into the center profile -->
            {constellationNodes.map((node) => (
              <circle
                r="3.5"
                fill={node.accent === 'mint' ? '#059669' : node.accent === 'violet' ? '#6366F1' : '#0284C7'}
                class="pulse-particle"
                filter="url(#pulse-glow)"
              >
                <animateMotion
                  dur={node.dur}
                  begin={node.begin}
                  repeatCount="indefinite"
                  path={node.pathD}
                />
              </circle>
            ))}
          </svg>

          <!-- =================================================================== -->
          <!-- CENTER ANCHOR: Circular Profile (~140px) with 5+ Yrs Ops Badge      -->
          <!-- =================================================================== -->
          <div
            class="absolute z-20 flex flex-col items-center justify-center text-center cursor-default group"
            style="left: 280px; top: 240px; transform: translate(-50%, -50%);"
            id="center-profile"
          >
            <!-- Glowing Halo & Profile Portrait -->
            <div class="relative">
              <div class="absolute -inset-2.5 rounded-full bg-gradient-to-tr from-cyan via-violet to-mint opacity-55 blur-xl transition duration-500 group-hover:opacity-85 group-hover:blur-2xl"></div>

              <!-- Circular Profile Container (~140px diameter) -->
              <div class="relative h-[140px] w-[140px] rounded-full border-2 border-white dark:border-white/25 bg-slate-100 dark:bg-panel2 shadow-2xl overflow-hidden ring-4 ring-slate-900/5 dark:ring-white/10 transition-transform duration-500 group-hover:scale-105">
                <img
                  src={profile.photo}
                  alt={profile.name}
                  class="h-full w-full object-cover object-center"
                  loading="eager"
                  width="140"
                  height="140"
                />
              </div>

              <!-- Experience Badge Beneath Portrait -->
              <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border border-slate-300 dark:border-white/15 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-3 py-1 shadow-md flex items-center gap-1.5 z-30 transition-transform duration-300 group-hover:scale-105">
                <span class="h-2 w-2 rounded-full bg-mint animate-pulse" aria-hidden="true"></span>
                <span class="font-mono text-[9.5px] font-bold tracking-wider text-slate-800 dark:text-slate-200 uppercase">
                  5+ YRS OPS
                </span>
              </div>
            </div>

            <!-- Name & Title Beneath Badge -->
            <div class="mt-4 space-y-0.5">
              <span class="block font-display font-bold text-sm sm:text-base text-slate-900 dark:text-white leading-tight">
                {profile.name}
              </span>
              <span class="block font-mono text-[9px] text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                DevOps &amp; Cloud Engineer
              </span>
            </div>
          </div>

          <!-- =================================================================== -->
          <!-- 8 FLOATING CONSTELLATION NODES (Primary & Secondary Rings)          -->
          <!-- =================================================================== -->
          {constellationNodes.map((node) => (
            <div
              class="constellation-node absolute z-10 -translate-x-1/2 -translate-y-1/2 group cursor-pointer transition-all duration-200"
              style={`left: ${node.x}px; top: ${node.y}px;`}
              data-node-id={node.id}
              tabindex="0"
              role="button"
              aria-label={`${node.name} - ${node.domain}`}
            >
              <!-- Interactive Glass Capsule Pill -->
              <div
                class:list={[
                  "node-capsule flex items-center gap-2 rounded-2xl border px-3 py-1.5 shadow-sm transition-all duration-200 backdrop-blur-md",
                  "bg-white/90 dark:bg-panel2/90 border-slate-200/90 dark:border-white/10",
                  "hover:scale-[1.08] hover:shadow-md hover:bg-white dark:hover:bg-panel",
                  node.accent === 'cyan' && "hover:border-cyan/70 dark:hover:border-cyan/60 hover:ring-2 hover:ring-cyan/30",
                  node.accent === 'violet' && "hover:border-violet/70 dark:hover:border-violet/60 hover:ring-2 hover:ring-violet/30",
                  node.accent === 'mint' && "hover:border-mint/70 dark:hover:border-mint/60 hover:ring-2 hover:ring-mint/30"
                ]}
              >
                <!-- Brand SVG Vector Icon -->
                <span class="flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                  <TechIcon name={node.id} size={18} />
                </span>

                <!-- Node Label & Micro Domain -->
                <div class="min-w-0">
                  <span class="block font-display font-bold text-[11.5px] text-slate-900 dark:text-white leading-tight truncate">
                    {node.name}
                  </span>
                  <span class="block font-mono text-[8px] uppercase tracking-wider text-slate-500 dark:text-slate-400 truncate">
                    {node.tag}
                  </span>
                </div>
              </div>
            </div>
          ))}

        </div>

      </div>

    </div>
  </div>
</section>

<!-- Hover Interaction Engine for Constellation Nodes & SVG Lines -->
<script is:inline>
  (function () {
    const canvas = document.getElementById('hero-constellation-canvas');
    if (!canvas) return;

    const nodes = canvas.querySelectorAll('.constellation-node');

    nodes.forEach((node) => {
      const nodeId = node.getAttribute('data-node-id');
      const targetPath = canvas.querySelector(`#path-${nodeId}`);

      function onEnter() {
        if (targetPath) {
          targetPath.classList.add('is-active-line');
        }
      }

      function onLeave() {
        if (targetPath) {
          targetPath.classList.remove('is-active-line');
        }
      }

      node.addEventListener('mouseenter', onEnter);
      node.addEventListener('focus', onEnter);
      node.addEventListener('mouseleave', onLeave);
      node.addEventListener('blur', onLeave);
    });
  })();
</script>

<style>
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate-in {
    animation: heroFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Moving Dash Animation along Connection Lines */
  @keyframes strokeDashFlow {
    to {
      stroke-dashoffset: -16;
    }
  }

  .constellation-path {
    opacity: 0.22;
    transition: opacity 200ms ease, stroke-width 200ms ease, stroke 200ms ease;
    animation: strokeDashFlow 3s linear infinite;
  }

  /* Highlighted Line on Node Hover */
  .constellation-path.is-active-line {
    opacity: 0.75 !important;
    stroke-width: 2px !important;
    filter: drop-shadow(0 0 4px rgba(2, 132, 199, 0.7));
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-animate-in,
    .constellation-path {
      animation: none !important;
      opacity: 0.25 !important;
      transform: none !important;
    }
    .pulse-particle {
      display: none !important;
    }
  }
</style>

---
import { ArrowRight, BriefcaseBusiness, ChevronDown, Code, Download, MapPin, Sparkles } from '@lucide/astro';
import { profile } from '@/data/profile';

const allSkills = [
  'AWS', 'Azure', 'Kubernetes', 'Terraform', 'Docker', 'Helm', 'Argo CD',
  'Jenkins', 'GitHub Actions', 'Prometheus', 'Grafana', 'Elastic Stack',
  'SonarQube', 'Trivy', 'VPC', 'EKS', 'AKS', 'ECS', 'RDS', 'Linux',
  'Python', 'Bash', 'Ansible', 'Jira', 'ServiceNow', 'CI/CD', 'GitOps',
  'IAM', 'ALB', 'Route 53', 'CloudFormation', 'Catchpoint', 'Dynatrace'
];
// Duplicate for seamless infinite scroll
const marqueeSkills = [...allSkills, ...allSkills];

const gitChips = [
  { label: 'main', cls: 'git-chip--violet' },
  { label: '→ checkout -b feat/ci', cls: '' },
  { label: 'pipeline.yml', cls: 'git-chip--cyan' },
  { label: '✓ checks passing', cls: 'git-chip--green' },
  { label: '● secure', cls: 'git-chip--green' },
  { label: 'merge → main', cls: 'git-chip--violet' },
  { label: 'v2.0.0', cls: 'git-chip--cyan' },
  { label: '✓ deployed', cls: 'git-chip--green' },
  { label: 'status: 200 OK', cls: 'git-chip--green' },
];
---

<section class="relative overflow-hidden pt-4" id="top">
  <!-- Marquee background flourish -->
  <div class="pointer-events-none absolute inset-x-0 bottom-12 opacity-[0.045] select-none" aria-hidden="true">
    <div class="marquee-outer">
      <div class="marquee-track font-mono text-sm uppercase tracking-widest text-slate-200">
        {marqueeSkills.map((skill) => (
          <span class="flex-shrink-0 whitespace-nowrap px-3">{skill}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="mx-auto grid min-h-0 max-w-7xl items-center gap-8 px-4 pb-8 pt-4 sm:gap-10 sm:px-6 sm:pb-10 sm:pt-8 lg:min-h-[calc(100vh-5.5rem)] lg:grid-cols-[1.15fr_0.85fr] lg:px-8 lg:pt-8 w-full min-w-0">

    <!-- LEFT COLUMN: Candidate Identity, Tagline, Chips & Actions -->
    <div class="reveal-up w-full min-w-0">
      <!-- 1. Eyebrow & Availability Badge (Single primary availability statement) -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
        <p class="hero-eyebrow break-words leading-relaxed text-xs uppercase tracking-widest text-cyan font-semibold">
          DevOps / Cloud Engineer
        </p>
        <span class="rounded-full border border-mint/30 bg-mint/10 px-2.5 py-0.5 font-mono text-[9px] sm:text-[10px] uppercase tracking-wider text-mint font-medium">
          ● {profile.availability}
        </span>
      </div>

      <!-- 2. Display Name — Single prominent heading -->
      <h1 class="hero-display-name mt-2.5 sm:mt-3 break-words">
        {profile.name}
      </h1>

      <!-- 3. Current-Role Credibility Line -->
      <p class="mt-2 font-mono text-[11px] sm:text-xs tracking-wide text-slate-400 w-full max-w-full">
        Currently at Genpact — Honeywell account · {profile.experience} in cloud infrastructure
      </p>

      <!-- 4. Tagline (Bio paragraph removed to avoid duplication with Whoami) -->
      <p class="hero-tagline mt-4 sm:mt-5 text-sm sm:text-base lg:text-lg leading-relaxed text-slate-300 w-full max-w-full">
        {profile.tagline}
      </p>

      <!-- 5. Info Chips Row (Reduced to 2 high-signal chips: Location & Experience) -->
      <div class="mt-5 flex flex-wrap gap-2 sm:gap-2.5 font-mono text-[11px] sm:text-xs text-slate-300 w-full text-left">
        <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3.5 py-2.5">
          <MapPin size={13} class="text-cyan flex-shrink-0" />
          <span>{profile.location}</span>
        </div>
        <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3.5 py-2.5">
          <Sparkles size={13} class="text-violet flex-shrink-0" />
          <span>{profile.experience} Experience</span>
        </div>
      </div>

      <!-- 6. PRIMARY CTAs (3 Actions) -->
      <div class="mt-6 flex flex-col sm:flex-row sm:flex-wrap gap-2.5 sm:gap-3 w-full max-w-full">
        <!-- 1. Let's connect — PRIMARY -->
        <a
          href="/#contact"
          id="hero-cta-connect"
          class="inline-flex items-center justify-between sm:justify-center gap-2 rounded-[12px] bg-cyan px-5 py-3 text-sm sm:text-base font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-white text-center w-full sm:w-auto"
        >
          <span>Let's connect</span> <ArrowRight size={16} />
        </a>
        <!-- 2. View the work — TERTIARY -->
        <a
          href="/projects"
          id="hero-cta-work"
          class="inline-flex items-center justify-between sm:justify-center gap-2 rounded-[12px] border border-white/10 bg-white/[0.03] px-5 py-3 text-sm sm:text-base font-medium text-white transition hover:-translate-y-0.5 hover:border-violet/45 text-center w-full sm:w-auto"
        >
          <span>View the work</span> <ArrowRight size={16} class="sm:hidden" />
        </a>
        <!-- 3. Resume — SECONDARY -->
        <a
          href={profile.resume}
          id="hero-cta-resume"
          class="inline-flex items-center justify-between sm:justify-center gap-2 rounded-[12px] bg-cyan/15 border border-cyan/40 px-5 py-3 text-sm sm:text-base font-semibold text-cyan transition hover:-translate-y-0.5 hover:bg-cyan/25 hover:border-cyan/60 text-center w-full sm:w-auto"
        >
          <span><Download size={15} class="inline mr-1.5" />Resume</span>
        </a>
      </div>

      <!-- 7. SECONDARY BUTTONS (Reduced to LinkedIn & GitHub) -->
      <div class="mt-3 flex flex-wrap items-center gap-2 sm:gap-2.5 w-full max-w-full">
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          class="inline-flex items-center justify-center gap-1.5 rounded-[10px] border border-violet/30 bg-white/[0.03] px-3.5 py-2 text-xs sm:text-sm font-medium text-slate-300 transition hover:-translate-y-0.5 hover:border-violet/55 hover:text-white"
        >
          <BriefcaseBusiness size={14} /> LinkedIn
        </a>
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 rounded-[10px] border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs sm:text-sm font-medium text-slate-300 transition hover:-translate-y-0.5 hover:border-white/25 hover:text-white"
        >
          <Code size={14} /> GitHub
        </a>
      </div>

      <!-- 8. Scroll cue -->
      <a href="/#about" class="scroll-cue mt-6 sm:mt-8 inline-flex" aria-label="Scroll to About section">
        <ChevronDown size={14} />&nbsp;scroll down
      </a>
    </div>

    <!-- RIGHT COLUMN — Profile Photo & Deploy Monitor Dashboard -->
    <div class="relative reveal-up w-full min-w-0 lg:pt-2" style="animation-delay: 120ms;">
      <div class="w-full max-w-full lg:max-w-lg mx-auto lg:ml-auto space-y-4">
        
        <!-- Profile Photo Card (De-cluttered: no redundant available pill) -->
        <div class="flex flex-col sm:flex-row items-center sm:items-center gap-4 sm:gap-5 rounded-[22px] border border-white/10 bg-panel2/85 p-4 sm:p-5 shadow-xl backdrop-blur-md">
          <!-- Photo frame (128-144px) -->
          <div class="relative aspect-square w-32 sm:w-36 flex-shrink-0 overflow-hidden rounded-2xl border-2 border-white/15 bg-panel2 shadow-2xl">
            <img
              class="h-full w-full object-cover object-center"
              src={profile.photo}
              alt="Chandu Venna - DevOps / Cloud Engineer"
              loading="eager"
            />
            <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center rounded-full border border-white/15 bg-ink/95 px-2 py-0.5 font-mono text-[9px] uppercase tracking-widest text-slate-200 shadow-md backdrop-blur-md">
                verified ✓
              </span>
            </div>
          </div>

          <!-- Identity Details -->
          <div class="min-w-0 flex-1 text-center sm:text-left space-y-1">
            <h2 class="text-lg sm:text-xl font-semibold text-white tracking-tight">{profile.name}</h2>
            <p class="font-mono text-xs text-cyan font-medium">{profile.title}</p>
            <p class="font-mono text-[11px] text-slate-400">Genpact · Honeywell account</p>
          </div>
        </div>

        <!-- Deploy Monitor Widget Area -->
        <div>
          <!-- Caption -->
          <p class="mb-2 font-mono text-[10px] sm:text-[11px] tracking-wide text-slate-500 text-center lg:text-left">
            Live-style snapshot of a Kubernetes production environment I manage
          </p>

          <!-- Relocated slim Git chip strip (Item 5) -->
          <div class="mb-3 git-strip" aria-hidden="true">
            {gitChips.map((chip) => (
              <span class:list={['git-chip', chip.cls]}>{chip.label}</span>
            ))}
          </div>

          <!-- Terminal Panel -->
          <div class="w-full rounded-[20px] sm:rounded-[22px] border border-white/10 bg-panel2/90 p-4 sm:p-5 shadow-2xl backdrop-blur-md min-w-0 box-border overflow-hidden">
            <!-- Terminal Header -->
            <div class="flex items-center justify-between border-b border-white/[0.08] pb-3">
              <div class="flex items-center gap-2 min-w-0">
                <span class="status-dot red flex-shrink-0"></span>
                <span class="status-dot amber flex-shrink-0"></span>
                <span class="status-dot green flex-shrink-0"></span>
                <span class="ml-1 font-mono text-[10px] sm:text-[11px] uppercase tracking-widest text-slate-300 truncate">deploy-monitor // k8s-prod</span>
              </div>
              <span class="rounded-full border border-mint/30 bg-mint/10 px-2 py-0.5 font-mono text-[8px] sm:text-[9px] uppercase tracking-widest text-mint font-semibold flex-shrink-0">
                ● healthy
              </span>
            </div>

            <!-- Command Line -->
            <div class="mt-3 font-mono text-[11px] sm:text-xs text-slate-300 truncate">
              <span class="text-mint">$</span> <span class="text-cyan">kubectl</span> get pods -n production
            </div>

            <!-- Pods Status List -->
            <div class="mt-2.5 space-y-1.5 font-mono text-[10px] sm:text-[11px]">
              <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3 py-1.5 sm:py-2 border border-white/[0.04]">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="h-1.5 w-1.5 rounded-full bg-mint flex-shrink-0"></span>
                  <span class="text-slate-200 truncate">api-service-prod</span>
                </div>
                <div class="flex items-center gap-2 text-slate-400 flex-shrink-0">
                  <span>3/3</span>
                  <span class="text-mint font-medium">Running</span>
                </div>
              </div>

              <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3 py-1.5 sm:py-2 border border-white/[0.04]">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="h-1.5 w-1.5 rounded-full bg-mint flex-shrink-0"></span>
                  <span class="text-slate-200 truncate">auth-microservice</span>
                </div>
                <div class="flex items-center gap-2 text-slate-400 flex-shrink-0">
                  <span>2/2</span>
                  <span class="text-mint font-medium">Running</span>
                </div>
              </div>

              <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3 py-1.5 sm:py-2 border border-white/[0.04]">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="h-1.5 w-1.5 rounded-full bg-mint flex-shrink-0"></span>
                  <span class="text-slate-200 truncate">ingress-alb-controller</span>
                </div>
                <div class="flex items-center gap-2 text-slate-400 flex-shrink-0">
                  <span>2/2</span>
                  <span class="text-mint font-medium">Running</span>
                </div>
              </div>

              <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3 py-1.5 sm:py-2 border border-white/[0.04]">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="h-1.5 w-1.5 rounded-full bg-cyan flex-shrink-0"></span>
                  <span class="text-slate-200 truncate">prometheus-collector</span>
                </div>
                <div class="flex items-center gap-2 text-slate-400 flex-shrink-0">
                  <span>1/1</span>
                  <span class="text-cyan font-medium">Healthy</span>
                </div>
              </div>
            </div>

            <!-- Telemetry & Deploy Metrics Grid -->
            <div class="mt-3 grid grid-cols-2 gap-2 pt-2.5 border-t border-white/[0.08]">
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2 flex flex-col justify-between">
                <span class="block font-mono text-[8px] sm:text-[9px] uppercase tracking-wider text-muted">deployment</span>
                <span class="mt-0.5 block font-mono text-[10px] sm:text-xs font-semibold text-mint">zero-downtime deploys</span>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2 flex flex-col justify-between">
                <span class="block font-mono text-[8px] sm:text-[9px] uppercase tracking-wider text-muted">gitops sync</span>
                <span class="mt-0.5 block font-mono text-[10px] sm:text-xs font-semibold text-cyan">Argo CD · in-sync</span>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2 flex flex-col justify-between">
                <span class="block font-mono text-[8px] sm:text-[9px] uppercase tracking-wider text-muted">iac state</span>
                <span class="mt-0.5 block font-mono text-[10px] sm:text-xs font-semibold text-slate-200">Terraform · 0 drift</span>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2 flex flex-col justify-between">
                <span class="block font-mono text-[8px] sm:text-[9px] uppercase tracking-wider text-muted">cluster health</span>
                <span class="mt-0.5 block font-mono text-[10px] sm:text-xs font-semibold text-mint">cluster: healthy</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Scroll cue -->
      <div class="mt-6 text-center sm:hidden">
        <a href="/#about" class="scroll-cue inline-flex" aria-label="Scroll to About section">
          <ChevronDown size={14} />&nbsp;scroll down
        </a>
      </div>
    </div>
  </div>
</section>

---
import {
  ArrowRight,
  BriefcaseBusiness,
  CodeXml,
  Download,
  Layers,
  Mail,
  MapPin,
  ShieldCheck,
  Sparkles
} from '@lucide/astro';
import { profile } from '@/data/profile';
import TechIcon from '@/components/TechIcon.astro';

// Structured 5-Stage DevOps Engineering Pipeline Flow
const pipelineStages = [
  {
    id: 'stage-cloud',
    stageNumber: '01',
    stageName: 'Cloud Platforms',
    shortName: 'Cloud',
    accent: 'cyan',
    technologies: [
      { id: 'aws', name: 'AWS', domain: 'Public Cloud', accent: 'cyan', connections: ['terraform', 'ansible', 'kubernetes', 'azure'] },
      { id: 'azure', name: 'Azure', domain: 'Public Cloud', accent: 'cyan', connections: ['terraform', 'ansible', 'kubernetes', 'aws'] }
    ]
  },
  {
    id: 'stage-iac',
    stageNumber: '02',
    stageName: 'Infrastructure as Code',
    shortName: 'IaC',
    accent: 'violet',
    technologies: [
      { id: 'terraform', name: 'Terraform', domain: 'Cloud IaC', accent: 'violet', connections: ['aws', 'azure', 'kubernetes', 'docker'] },
      { id: 'ansible', name: 'Ansible', domain: 'Config Mgmt', accent: 'violet', connections: ['aws', 'azure', 'docker', 'linux'] }
    ]
  },
  {
    id: 'stage-containers',
    stageNumber: '03',
    stageName: 'Containers & Platform',
    shortName: 'Containers',
    accent: 'cyan',
    technologies: [
      { id: 'docker', name: 'Docker', domain: 'OCI Runtime', accent: 'cyan', connections: ['kubernetes', 'githubactions', 'jenkins', 'terraform'] },
      { id: 'kubernetes', name: 'Kubernetes', domain: 'Orchestration', accent: 'cyan', connections: ['docker', 'helm', 'argocd', 'prometheus', 'aws', 'azure', 'terraform'] },
      { id: 'helm', name: 'Helm', domain: 'K8s Packages', accent: 'cyan', connections: ['kubernetes', 'argocd'] }
    ]
  },
  {
    id: 'stage-delivery',
    stageNumber: '04',
    stageName: 'CI/CD & GitOps Delivery',
    shortName: 'Delivery',
    accent: 'violet',
    technologies: [
      { id: 'githubactions', name: 'GitHub Actions', domain: 'CI Workflows', accent: 'violet', connections: ['docker', 'jenkins', 'argocd', 'sonarqube'] },
      { id: 'jenkins', name: 'Jenkins', domain: 'CI Pipelines', accent: 'cyan', connections: ['docker', 'githubactions', 'argocd'] },
      { id: 'argocd', name: 'Argo CD', domain: 'GitOps Sync', accent: 'mint', connections: ['kubernetes', 'helm', 'githubactions', 'jenkins'] }
    ]
  },
  {
    id: 'stage-observability',
    stageNumber: '05',
    stageName: 'Observability & APM',
    shortName: 'Observability',
    accent: 'mint',
    technologies: [
      { id: 'prometheus', name: 'Prometheus', domain: 'Metrics & Alerting', accent: 'mint', connections: ['kubernetes', 'grafana', 'dynatrace'] },
      { id: 'grafana', name: 'Grafana', domain: 'Dashboards', accent: 'mint', connections: ['prometheus', 'elastic', 'dynatrace'] },
      { id: 'dynatrace', name: 'Dynatrace', domain: 'Full-Stack APM', accent: 'mint', connections: ['kubernetes', 'grafana', 'prometheus'] },
      { id: 'elastic', name: 'Elasticsearch', domain: 'Log Telemetry', accent: 'mint', connections: ['grafana', 'kubernetes', 'prometheus'] }
    ]
  }
];

// Flat list for desktop canvas placement
const desktopTechNodes = [
  // Stage 1: Cloud (Top Left & Top Right)
  { id: 'aws', name: 'AWS', tag: 'Cloud', stage: '01 Cloud', accent: 'cyan', x: 80, y: 70, connections: ['terraform', 'ansible', 'kubernetes'] },
  { id: 'azure', name: 'Azure', tag: 'Cloud', stage: '01 Cloud', accent: 'cyan', x: 460, y: 70, connections: ['terraform', 'ansible', 'kubernetes'] },

  // Stage 2: IaC (Mid Top Left & Mid Top Right)
  { id: 'terraform', name: 'Terraform', tag: 'IaC', stage: '02 IaC', accent: 'violet', x: 190, y: 55, connections: ['aws', 'azure', 'kubernetes', 'docker'] },
  { id: 'ansible', name: 'Ansible', tag: 'IaC', stage: '02 IaC', accent: 'violet', x: 350, y: 55, connections: ['aws', 'azure', 'docker'] },

  // Stage 3: Containers (Left & Right Flanks)
  { id: 'docker', name: 'Docker', tag: 'Containers', stage: '03 Platform', accent: 'cyan', x: 65, y: 235, connections: ['kubernetes', 'githubactions', 'jenkins', 'terraform'] },
  { id: 'kubernetes', name: 'Kubernetes', tag: 'Orchestration', stage: '03 Platform', accent: 'cyan', x: 475, y: 235, connections: ['docker', 'helm', 'argocd', 'prometheus', 'aws', 'azure', 'terraform'] },
  { id: 'helm', name: 'Helm', tag: 'Packages', stage: '03 Platform', accent: 'cyan', x: 475, y: 345, connections: ['kubernetes', 'argocd'] },

  // Stage 4: CI/CD & Delivery (Bottom Left & Mid Bottom)
  { id: 'githubactions', name: 'GitHub Actions', tag: 'CI/CD', stage: '04 Delivery', accent: 'violet', x: 85, y: 395, connections: ['docker', 'jenkins', 'argocd'] },
  { id: 'jenkins', name: 'Jenkins', tag: 'CI/CD', stage: '04 Delivery', accent: 'cyan', x: 195, y: 440, connections: ['docker', 'githubactions', 'argocd'] },
  { id: 'argocd', name: 'Argo CD', tag: 'GitOps', stage: '04 Delivery', accent: 'mint', x: 345, y: 440, connections: ['kubernetes', 'helm', 'githubactions', 'jenkins'] },

  // Stage 5: Observability (Center Bottom & Bottom Right)
  { id: 'prometheus', name: 'Prometheus', tag: 'Metrics', stage: '05 Observability', accent: 'mint', x: 450, y: 435, connections: ['kubernetes', 'grafana', 'dynatrace'] },
  { id: 'grafana', name: 'Grafana', tag: 'Dashboards', stage: '05 Observability', accent: 'mint', x: 270, y: 355, connections: ['prometheus', 'elastic', 'dynatrace', 'kubernetes'] }
];
---

<section class="relative overflow-hidden pt-6 sm:pt-10 lg:pt-14 pb-12 sm:pb-16 lg:pb-24" id="top">

  <!-- Ambient Lighting Mesh (Light/Dark adaptive) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 left-1/4 h-[550px] w-[550px] rounded-full bg-cyan/[0.07] dark:bg-cyan/[0.08] blur-[130px]"></div>
    <div class="absolute top-1/3 right-0 h-[500px] w-[500px] rounded-full bg-violet/[0.06] dark:bg-violet/[0.08] blur-[130px]"></div>
    <div class="absolute -bottom-20 left-1/3 h-[400px] w-[400px] rounded-full bg-mint/[0.04] dark:bg-mint/[0.05] blur-[120px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0">

    <!-- Hero Grid: Left Column (Identity, Value Proposition, Proof Points, CTAs) + Right Column (DevOps Engineering Pipeline Flow) -->
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1.15fr] lg:gap-12 xl:gap-16">

      <!-- ========================================================================= -->
      <!-- LEFT COLUMN: Editorial Identity, Proven Value & High-Contrast CTAs       -->
      <!-- ========================================================================= -->
      <div class="space-y-6 sm:space-y-7">

        <!-- 1. Live Availability & Location Status Badge -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2.5" style="animation-delay: 0ms;">
          <span class="inline-flex items-center gap-2 rounded-full border border-mint/40 bg-mint/[0.08] px-3.5 py-1 font-mono text-[11px] font-semibold text-mint">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
            </span>
            <span>Available for DevOps &amp; Cloud Roles</span>
          </span>

          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">
            <MapPin size={13} class="text-cyan flex-shrink-0" />
            <span>{profile.location}</span>
          </span>
        </div>

        <!-- 2. Masterpiece Typographic Name & Title -->
        <div class="hero-animate-in space-y-3" style="animation-delay: 80ms;">
          <div class="space-y-1">
            <span class="block font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] text-cyan font-bold">
              Engineering Portfolio
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight font-display leading-[0.98] text-slate-900 dark:text-white">
              <span class="block">CHANDU</span>
              <span class="block bg-gradient-to-r from-cyan via-violet to-mint bg-clip-text text-transparent">
                VENNA
              </span>
            </h1>
          </div>

          <!-- Professional Designation Pill Bar -->
          <div class="flex items-center gap-3 pt-1">
            <div class="h-1 w-12 rounded-full bg-gradient-to-r from-cyan to-violet"></div>
            <p class="text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 dark:text-slate-200 font-display">
              DevOps &amp; Cloud Engineer
            </p>
          </div>
        </div>

        <!-- 3. Value Proposition -->
        <div class="hero-animate-in space-y-4" style="animation-delay: 150ms;">
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl font-normal">
            Building reliable cloud infrastructure, Kubernetes platforms, and automated delivery systems across AWS and Azure.
          </p>
        </div>

        <!-- ========================================================================= -->
        <!-- MOBILE-ONLY PROFILE + PIPELINE (Follows Exact Mobile Sequence Required)   -->
        <!-- ========================================================================= -->
        <div class="block lg:hidden space-y-5 pt-1 pb-1">

          <!-- Standalone Mobile Profile Picture Anchor (Never Hidden!) -->
          <div class="flex items-center gap-4 p-4 rounded-2xl border border-slate-200/90 dark:border-white/[0.08] bg-white/80 dark:bg-panel2/80 backdrop-blur-md shadow-sm">
            <div class="relative flex-shrink-0">
              <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-cyan via-violet to-mint opacity-60 blur-sm"></div>
              <div class="relative h-16 w-16 overflow-hidden rounded-2xl border-2 border-white dark:border-white/20 bg-slate-100 dark:bg-panel shadow-md">
                <img
                  src={profile.photo}
                  alt={profile.name}
                  class="h-full w-full object-cover object-center"
                  loading="eager"
                  width="64"
                  height="64"
                />
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="font-display font-bold text-base text-slate-900 dark:text-white truncate">
                  {profile.name}
                </span>
                <span class="inline-flex items-center rounded-full bg-mint/10 px-2 py-0.5 font-mono text-[9px] font-bold text-mint">
                  ● 5+ Yrs Ops
                </span>
              </div>
              <p class="font-mono text-xs text-slate-600 dark:text-slate-300 truncate">
                DevOps &amp; Cloud Platform Engineer
              </p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5">
                AWS · Azure · Kubernetes · Terraform
              </p>
            </div>
          </div>

          <!-- Mobile DevOps Engineering Pipeline Flow Cards -->
          <div class="rounded-2xl border border-slate-200/90 dark:border-white/[0.08] bg-slate-50/90 dark:bg-panel/90 p-4 space-y-3">
            <div class="flex items-center justify-between px-0.5">
              <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                DevOps Pipeline Flow
              </span>
              <span class="font-mono text-[9px] text-mint uppercase tracking-wider">
                ● 5 Stages
              </span>
            </div>

            <div class="space-y-2.5">
              {pipelineStages.map((stage, idx) => (
                <div class="flex flex-col gap-1.5 p-2.5 rounded-xl border border-slate-200/80 dark:border-white/[0.06] bg-white dark:bg-panel2 shadow-2xs">
                  <div class="flex items-center justify-between text-[10px] font-mono">
                    <span class="font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                      <span class={stage.accent === 'mint' ? 'text-mint' : stage.accent === 'violet' ? 'text-violet' : 'text-cyan'}>
                        {stage.stageNumber}
                      </span>
                      <span>{stage.stageName}</span>
                    </span>
                    {idx < pipelineStages.length - 1 && (
                      <span class="text-slate-400 dark:text-slate-500">↓</span>
                    )}
                  </div>
                  <div class="flex flex-wrap gap-1.5 pt-0.5">
                    {stage.technologies.map((t) => (
                      <span class="inline-flex items-center gap-1 rounded-lg border border-slate-200/60 dark:border-white/5 bg-slate-100/70 dark:bg-white/[0.03] px-2 py-1 text-[11px] font-medium text-slate-800 dark:text-slate-200">
                        <TechIcon name={t.id} size={14} />
                        <span>{t.name}</span>
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>

        <!-- 4. Resume-Verified Proof Points (Max 3 Points) -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2 pt-1 font-mono text-xs text-slate-600 dark:text-slate-300" style="animation-delay: 200ms;">
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <ShieldCheck size={13} class="text-cyan" />
            <span>5+ Yrs Production Ops</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <Layers size={13} class="text-violet" />
            <span>Multi-AZ K8s &amp; IaC</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <Sparkles size={13} class="text-mint" />
            <span>60% Faster Deployments</span>
          </span>
        </div>

        <!-- 5. High-Contrast Primary & Secondary CTAs -->
        <div class="hero-animate-in pt-1 flex flex-wrap items-center gap-3.5" style="animation-delay: 240ms;">
          <!-- Primary CTA -->
          <a
            href="/projects"
            class="group inline-flex items-center gap-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-ink px-6 py-3.5 text-sm sm:text-base font-semibold shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Explore Case Studies</span>
            <ArrowRight size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
          </a>

          <!-- Secondary CTA -->
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-300 dark:border-white/15 bg-white dark:bg-white/[0.04] text-slate-800 dark:text-slate-200 px-5 py-3.5 text-sm sm:text-base font-semibold transition-all duration-200 hover:border-slate-400 dark:hover:border-white/30 hover:bg-slate-50 dark:hover:bg-white/[0.08] active:scale-[0.98] shadow-sm"
          >
            <Download size={16} />
            <span>Resume</span>
          </a>
        </div>

        <!-- 6. Compact Social & Direct Contact Channels -->
        <div class="hero-animate-in pt-1 flex items-center gap-4 text-xs font-medium text-slate-600 dark:text-slate-400" style="animation-delay: 290ms;">
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-slate-950 dark:hover:text-white transition-colors"
            aria-label="GitHub Profile"
          >
            <CodeXml size={16} class="text-slate-500 dark:text-slate-400" />
            <span>GitHub</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-violet transition-colors"
            aria-label="LinkedIn Profile"
          >
            <BriefcaseBusiness size={16} class="text-slate-500 dark:text-slate-400" />
            <span>LinkedIn</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={`mailto:${profile.email}`}
            class="flex items-center gap-1.5 hover:text-cyan transition-colors"
            aria-label="Send Email"
          >
            <Mail size={16} class="text-slate-500 dark:text-slate-400" />
            <span>Email</span>
          </a>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- RIGHT COLUMN: Desktop DevOps Engineering Pipeline Flow Canvas             -->
      <!-- ========================================================================= -->
      <div class="hero-animate-in relative hidden lg:block" style="animation-delay: 150ms;">

        <div class="relative w-full h-[510px] select-none rounded-3xl border border-slate-200/90 dark:border-white/[0.08] bg-slate-50/50 dark:bg-panel/60 backdrop-blur-xl p-4 overflow-hidden shadow-xl" id="devops-pipeline-canvas">

          <!-- Pipeline Stage Tiers Watermark Grid -->
          <div class="pointer-events-none absolute inset-0 p-6 flex flex-col justify-between opacity-40 dark:opacity-25 font-mono text-[9px] tracking-widest uppercase" aria-hidden="true">
            <div class="flex justify-between border-b border-dashed border-slate-300 dark:border-white/10 pb-1 text-cyan">
              <span>01 Cloud Infrastructure</span>
              <span>AWS &amp; Azure Provisioning</span>
            </div>
            <div class="flex justify-between border-b border-dashed border-slate-300 dark:border-white/10 pb-1 text-violet">
              <span>02 Infrastructure as Code</span>
              <span>Declarative Terraform &amp; Ansible</span>
            </div>
            <div class="flex justify-between border-b border-dashed border-slate-300 dark:border-white/10 pb-1 text-cyan">
              <span>03 Container Platform</span>
              <span>Docker · Kubernetes · Helm</span>
            </div>
            <div class="flex justify-between border-b border-dashed border-slate-300 dark:border-white/10 pb-1 text-violet">
              <span>04 CI/CD &amp; GitOps Delivery</span>
              <span>Automated Build · Test · Argo CD Sync</span>
            </div>
            <div class="flex justify-between text-mint">
              <span>05 Continuous Observability</span>
              <span>Prometheus · Grafana · Dynatrace Telemetry</span>
            </div>
          </div>

          <!-- SVG Vector Pipeline Connection Mesh & Pulse Pathways -->
          <svg
            class="absolute inset-0 h-full w-full pointer-events-none overflow-visible z-0"
            viewBox="0 0 540 500"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            id="pipeline-svg-mesh"
          >
            <defs>
              <linearGradient id="flow-cyan" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0284C7" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#6366F1" stop-opacity="0.3" />
              </linearGradient>
              <linearGradient id="flow-violet" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#6366F1" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#059669" stop-opacity="0.3" />
              </linearGradient>
              <linearGradient id="flow-mint" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#059669" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#0284C7" stop-opacity="0.3" />
              </linearGradient>

              <!-- Radial glow filter for animated packets -->
              <filter id="packet-glow" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="2.5" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- STAGE 1 -> STAGE 2: Cloud to IaC -->
            <path id="path-aws-tf" data-from="aws" data-to="terraform" d="M 80 70 Q 130 60, 190 55" class="pipeline-path" stroke="url(#flow-cyan)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-azure-ansible" data-from="azure" data-to="ansible" d="M 460 70 Q 410 60, 350 55" class="pipeline-path" stroke="url(#flow-cyan)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-tf-ansible" data-from="terraform" data-to="ansible" d="M 190 55 L 350 55" class="pipeline-path" stroke="url(#flow-violet)" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- STAGE 2 -> CENTER ANCHOR (CHANDU VENNA) -->
            <path id="path-tf-profile" data-from="terraform" data-to="profile" d="M 190 55 Q 220 120, 270 190" class="pipeline-path" stroke="url(#flow-cyan)" stroke-width="1.5" />
            <path id="path-ansible-profile" data-from="ansible" data-to="profile" d="M 350 55 Q 320 120, 270 190" class="pipeline-path" stroke="url(#flow-violet)" stroke-width="1.5" />

            <!-- STAGE 2 -> STAGE 3: IaC to Containers -->
            <path id="path-tf-docker" data-from="terraform" data-to="docker" d="M 190 55 Q 100 130, 65 235" class="pipeline-path" stroke="url(#flow-cyan)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-tf-k8s" data-from="terraform" data-to="kubernetes" d="M 190 55 Q 340 110, 475 235" class="pipeline-path" stroke="url(#flow-cyan)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-profile-docker" data-from="profile" data-to="docker" d="M 215 235 L 65 235" class="pipeline-path" stroke="url(#flow-cyan)" stroke-width="1.5" />
            <path id="path-profile-k8s" data-from="profile" data-to="kubernetes" d="M 325 235 L 475 235" class="pipeline-path" stroke="url(#flow-cyan)" stroke-width="1.5" />
            <path id="path-k8s-helm" data-from="kubernetes" data-to="helm" d="M 475 235 L 475 345" class="pipeline-path" stroke="url(#flow-cyan)" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- STAGE 3 -> STAGE 4: Containers to Delivery (GHA, Jenkins, ArgoCD) -->
            <path id="path-docker-gha" data-from="docker" data-to="githubactions" d="M 65 235 Q 70 320, 85 395" class="pipeline-path" stroke="url(#flow-violet)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-gha-jenkins" data-from="githubactions" data-to="jenkins" d="M 85 395 Q 140 425, 195 440" class="pipeline-path" stroke="url(#flow-violet)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-jenkins-argocd" data-from="jenkins" data-to="argocd" d="M 195 440 L 345 440" class="pipeline-path" stroke="url(#flow-violet)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-argocd-k8s" data-from="argocd" data-to="kubernetes" d="M 345 440 Q 420 380, 475 235" class="pipeline-path" stroke="url(#flow-mint)" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- STAGE 3 & 4 -> STAGE 5: Observability Feedback Loop -->
            <path id="path-k8s-prom" data-from="kubernetes" data-to="prometheus" d="M 475 235 Q 490 350, 450 435" class="pipeline-path" stroke="url(#flow-mint)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-prom-grafana" data-from="prometheus" data-to="grafana" d="M 450 435 Q 360 400, 270 355" class="pipeline-path" stroke="url(#flow-mint)" stroke-width="1.5" stroke-dasharray="4 4" />
            <path id="path-grafana-profile" data-from="grafana" data-to="profile" d="M 270 355 L 270 285" class="pipeline-path" stroke="url(#flow-mint)" stroke-width="1.5" />

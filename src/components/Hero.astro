---
import {
  ArrowRight,
  BriefcaseBusiness,
  CodeXml,
  Download,
  Layers,
  Mail,
  MapPin,
  ShieldCheck,
  Sparkles,
  Terminal
} from '@lucide/astro';
import { profile } from '@/data/profile';
import { allTechnologies } from '@/data/technologies';
import TechIcon from '@/components/TechIcon.astro';

// Grouping technologies by architectural domain for the interactive ecosystem
const ecosystemGroups = [
  {
    domain: 'Cloud & Infrastructure',
    accent: 'cyan',
    tools: allTechnologies.filter(t => ['aws', 'azure', 'terraform', 'ansible'].includes(t.id))
  },
  {
    domain: 'Containers & GitOps',
    accent: 'violet',
    tools: allTechnologies.filter(t => ['kubernetes', 'docker', 'helm', 'argocd'].includes(t.id))
  },
  {
    domain: 'CI/CD & Observability',
    accent: 'mint',
    tools: allTechnologies.filter(t => ['githubactions', 'jenkins', 'prometheus', 'grafana'].includes(t.id))
  },
  {
    domain: 'SecOps & Core Systems',
    accent: 'cyan',
    tools: allTechnologies.filter(t => ['sonarqube', 'trivy', 'elastic', 'linux', 'dynatrace', 'python'].includes(t.id))
  }
];
---

<section class="relative overflow-hidden pt-6 sm:pt-10 lg:pt-14 pb-12 sm:pb-16 lg:pb-20" id="top">

  <!-- Subtle Ambient Lighting Mesh (Light/Dark adaptive) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 left-1/4 h-[550px] w-[550px] rounded-full bg-cyan/[0.07] dark:bg-cyan/[0.08] blur-[130px]"></div>
    <div class="absolute top-1/3 right-0 h-[500px] w-[500px] rounded-full bg-violet/[0.06] dark:bg-violet/[0.08] blur-[130px]"></div>
    <div class="absolute -bottom-20 left-1/3 h-[400px] w-[400px] rounded-full bg-mint/[0.04] dark:bg-mint/[0.05] blur-[120px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0">

    <!-- Hero Grid: Left Column (Editorial Identity & CTAs) + Right Column (Unified Technical Console) -->
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-12 xl:gap-16">

      <!-- ========================================================================= -->
      <!-- LEFT COLUMN: Command-Line Editorial Identity & Value Proposition         -->
      <!-- ========================================================================= -->
      <div class="space-y-6 sm:space-y-7">

        <!-- 1. Live Availability & Location Status Badge -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2.5" style="animation-delay: 0ms;">
          <span class="inline-flex items-center gap-2 rounded-full border border-mint/40 bg-mint/[0.08] px-3.5 py-1 font-mono text-[11px] font-semibold text-mint">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
            </span>
            <span>Available for DevOps &amp; Cloud Roles</span>
          </span>

          <span class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">
            <MapPin size={13} class="text-cyan flex-shrink-0" />
            <span>{profile.location}</span>
          </span>
        </div>

        <!-- 2. Masterpiece Typographic Name & Title -->
        <div class="hero-animate-in space-y-3" style="animation-delay: 80ms;">
          <div class="space-y-1">
            <span class="block font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] text-cyan font-bold">
              Engineering Portfolio
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight font-display leading-[0.98] text-slate-900 dark:text-white">
              <span class="block">CHANDU</span>
              <span class="block bg-gradient-to-r from-cyan via-violet to-mint bg-clip-text text-transparent">
                VENNA
              </span>
            </h1>
          </div>

          <!-- Professional Designation Pill Bar -->
          <div class="flex items-center gap-3 pt-1">
            <div class="h-1 w-12 rounded-full bg-gradient-to-r from-cyan to-violet"></div>
            <p class="text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 dark:text-slate-200 font-display">
              DevOps &amp; Cloud Engineer
            </p>
          </div>
        </div>

        <!-- 3. Value Proposition & Key Signals Strip -->
        <div class="hero-animate-in space-y-4" style="animation-delay: 150ms;">
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl font-normal">
            Building resilient multi-region cloud infrastructure, enterprise Kubernetes platforms, and zero-downtime GitOps automation across AWS &amp; Azure.
          </p>

          <!-- Core Signals Row -->
          <div class="flex flex-wrap items-center gap-2 pt-1 font-mono text-xs text-slate-600 dark:text-slate-300">
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
              <ShieldCheck size={13} class="text-cyan" />
              <span>5+ Yrs Production Ops</span>
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
              <Layers size={13} class="text-violet" />
              <span>Multi-AZ K8s &amp; IaC</span>
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
              <Sparkles size={13} class="text-mint" />
              <span>60% Faster Deployments</span>
            </span>
          </div>
        </div>

        <!-- 4. High-Contrast Primary & Secondary CTAs -->
        <div class="hero-animate-in pt-1 flex flex-wrap items-center gap-3.5" style="animation-delay: 220ms;">
          <!-- Primary CTA -->
          <a
            href="/projects"
            class="group inline-flex items-center gap-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-ink px-6 py-3.5 text-sm sm:text-base font-semibold shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Explore Case Studies</span>
            <ArrowRight size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
          </a>

          <!-- Secondary CTA -->
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-300 dark:border-white/15 bg-white dark:bg-white/[0.04] text-slate-800 dark:text-slate-200 px-5 py-3.5 text-sm sm:text-base font-semibold transition-all duration-200 hover:border-slate-400 dark:hover:border-white/30 hover:bg-slate-50 dark:hover:bg-white/[0.08] active:scale-[0.98] shadow-sm"
          >
            <Download size={16} />
            <span>Resume</span>
          </a>
        </div>

        <!-- 5. Compact Social & Direct Contact Channels -->
        <div class="hero-animate-in pt-1 flex items-center gap-4 text-xs font-medium text-slate-600 dark:text-slate-400" style="animation-delay: 290ms;">
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-slate-950 dark:hover:text-white transition-colors"
            aria-label="GitHub Profile"
          >
            <CodeXml size={16} class="text-slate-500 dark:text-slate-400" />
            <span>GitHub</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-violet transition-colors"
            aria-label="LinkedIn Profile"
          >
            <BriefcaseBusiness size={16} class="text-slate-500 dark:text-slate-400" />
            <span>LinkedIn</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={`mailto:${profile.email}`}
            class="flex items-center gap-1.5 hover:text-cyan transition-colors"
            aria-label="Send Email"
          >
            <Mail size={16} class="text-slate-500 dark:text-slate-400" />
            <span>Email</span>
          </a>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- RIGHT COLUMN: Unified Technical Console & Focal Architectural Anchor     -->
      <!-- ========================================================================= -->
      <div class="hero-animate-in relative" style="animation-delay: 150ms;">

        <!-- Architectural Glass Console Container -->
        <div class="relative rounded-3xl border border-slate-200/90 dark:border-white/[0.09] bg-white/80 dark:bg-panel/85 backdrop-blur-xl p-5 sm:p-6 shadow-xl lg:shadow-2xl overflow-hidden">

          <!-- Subtle Circuit Graphic Background -->
          <div class="pointer-events-none absolute inset-0 opacity-[0.03] dark:opacity-[0.06]" aria-hidden="true">
            <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
              <defs>
                <pattern id="hero-grid-pat" width="32" height="32" patternUnits="userSpaceOnUse">
                  <path d="M0 32 L32 32 M32 0 L32 32" fill="none" stroke="currentColor" stroke-width="1" />
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#hero-grid-pat)" />
            </svg>
          </div>

          <!-- Console Header Bar -->
          <div class="relative flex items-center justify-between border-b border-slate-200/80 dark:border-white/[0.08] pb-4 mb-5">
            <div class="flex items-center gap-2.5">
              <span class="flex h-2 w-2 rounded-full bg-mint"></span>
              <span class="font-mono text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.16em] text-slate-800 dark:text-slate-200">
                Production Ecosystem
              </span>
            </div>
            <div class="flex items-center gap-2 font-mono text-[9px] sm:text-[10px] text-slate-500 dark:text-slate-400">
              <Terminal size={12} class="text-cyan" />
              <span>18 Verified Tools</span>
            </div>
          </div>

          <!-- Profile Anchor Row (Focal Portrait + Experience Highlights) -->
          <div class="relative flex items-center gap-4 sm:gap-5 pb-5 border-b border-slate-200/80 dark:border-white/[0.08]">

            <!-- Focal Portrait with Multi-Layered Halo -->
            <div class="relative flex-shrink-0 group">
              <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-cyan via-violet to-mint opacity-60 blur-md transition duration-500 group-hover:opacity-90"></div>
              <div class="relative h-20 w-20 sm:h-24 sm:w-24 overflow-hidden rounded-2xl border-2 border-white dark:border-white/20 bg-slate-100 dark:bg-panel2 shadow-md">
                <img
                  src={profile.photo}
                  alt={profile.name}
                  class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                  loading="eager"
                  width="96"
                  height="96"
                />
              </div>
            </div>

            <!-- Identity & Specialization Micro-Summary -->
            <div class="min-w-0 flex-1 space-y-1">
              <div class="flex items-center gap-2">
                <span class="font-display font-bold text-sm sm:text-base text-slate-900 dark:text-white truncate">
                  {profile.name}
                </span>
                <span class="inline-flex items-center rounded-full bg-cyan/10 px-2 py-0.5 font-mono text-[9px] font-bold text-cyan">
                  5+ YRS
                </span>
              </div>
              <p class="font-mono text-[11px] text-slate-600 dark:text-slate-300 truncate">
                DevOps &amp; Cloud Engineer
              </p>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
                Specialized in Amazon EKS, Azure AKS, Terraform IaC &amp; Argo CD GitOps pipelines.
              </p>
            </div>

          </div>

          <!-- Interactive Domain-Grouped Technology Ecosystem -->
          <div class="relative mt-5 space-y-4">
            {ecosystemGroups.map((group) => (
              <div class="space-y-2">

                <!-- Domain Group Header -->
                <div class="flex items-center justify-between px-0.5">
                  <span class="font-mono text-[9.5px] sm:text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    {group.domain}
                  </span>
                  <span class="h-[1px] flex-1 bg-slate-200/60 dark:bg-white/[0.05] ml-3"></span>
                </div>

                <!-- Domain Technology Grid -->
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                  {group.tools.map((tech) => (
                    <div
                      class:list={[
                        "group relative flex items-center gap-2 rounded-xl border p-2 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm cursor-default",
                        tech.isPrimary
                          ? "border-cyan/30 dark:border-cyan/35 bg-slate-100/90 dark:bg-white/[0.05] hover:border-cyan/60 dark:hover:border-cyan/50 hover:bg-white dark:hover:bg-white/[0.08]"
                          : "border-slate-200/80 dark:border-white/[0.07] bg-slate-50/80 dark:bg-white/[0.025] hover:border-slate-300 dark:hover:border-white/20 hover:bg-slate-100/90 dark:hover:bg-white/[0.06]"
                      ]}
                      title={`${tech.name} · ${tech.category} — ${tech.shortDesc}`}
                    >
                      <!-- Authentic Brand SVG Icon -->
                      <span class="flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                        <TechIcon name={tech.id} size={18} />
                      </span>

                      <!-- Tech Name & Tag -->
                      <div class="min-w-0 flex-1">
                        <span class="block text-[11.5px] font-bold text-slate-900 dark:text-white truncate font-display leading-tight">
                          {tech.name}
                        </span>
                        <span class="block font-mono text-[8px] text-slate-500 dark:text-slate-400 uppercase tracking-wider truncate mt-0.5">
                          {tech.tag}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>

              </div>
            ))}
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<style>
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate-in {
    animation: heroFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-animate-in {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

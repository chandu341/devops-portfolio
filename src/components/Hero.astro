---
import {
  ArrowRight,
  BriefcaseBusiness,
  CodeXml,
  Download,
  Layers,
  Mail,
  MapPin,
  ShieldCheck,
  Sparkles
} from '@lucide/astro';
import { profile } from '@/data/profile';
import TechIcon from '@/components/TechIcon.astro';

// Structured 7-Stage DevOps Delivery Pipeline Flow
// 01 Cloud -> 02 IaC -> 03 Containers -> 04 Platform -> 05 CI/CD -> 06 GitOps -> 07 Observability
const pipelineStages = [
  {
    stage: '01',
    name: 'Cloud Infrastructure',
    shortName: 'Cloud',
    tag: 'FOUNDATION',
    domain: 'Public Cloud & VPC',
    accent: 'cyan',
    accentColor: '#38BDF8',
    accentGlow: 'rgba(56, 189, 248, 0.38)',
    accentBorder: 'rgba(56, 189, 248, 0.5)',
    technologies: [
      { id: 'aws', name: 'AWS' },
      { id: 'azure', name: 'Azure' }
    ],
    highlight: 'Multi-AZ VPCs, EKS, EC2, S3, RDS & IAM security',
    delay: '0s',
    x: 95,
    y: 75
  },
  {
    stage: '02',
    name: 'Infrastructure as Code',
    shortName: 'IaC',
    tag: 'PROVISIONING',
    domain: 'Declarative State',
    accent: 'violet',
    accentColor: '#818CF8',
    accentGlow: 'rgba(129, 140, 248, 0.38)',
    accentBorder: 'rgba(129, 140, 248, 0.5)',
    technologies: [
      { id: 'terraform', name: 'Terraform' },
      { id: 'ansible', name: 'Ansible' }
    ],
    highlight: 'Automated cloud provisioning, modules & state locks',
    delay: '1.4s',
    x: 320,
    y: 75
  },
  {
    stage: '03',
    name: 'Containers',
    shortName: 'Containers',
    tag: 'PACKAGING',
    domain: 'Immutable Runtime',
    accent: 'cyan',
    accentColor: '#38BDF8',
    accentGlow: 'rgba(56, 189, 248, 0.38)',
    accentBorder: 'rgba(56, 189, 248, 0.5)',
    technologies: [
      { id: 'docker', name: 'Docker' }
    ],
    highlight: 'Multi-stage OCI builds & minimal attack surfaces',
    delay: '2.8s',
    x: 545,
    y: 75
  },
  {
    stage: '04',
    name: 'Orchestration',
    shortName: 'Platform',
    tag: 'PLATFORM',
    domain: 'Kubernetes Platform',
    accent: 'cyan',
    accentColor: '#38BDF8',
    accentGlow: 'rgba(56, 189, 248, 0.38)',
    accentBorder: 'rgba(56, 189, 248, 0.5)',
    technologies: [
      { id: 'kubernetes', name: 'Kubernetes' },
      { id: 'helm', name: 'Helm' }
    ],
    highlight: 'EKS/AKS clusters, 12+ microservices & ALB ingress',
    delay: '4.2s',
    x: 545,
    y: 255
  },
  {
    stage: '05',
    name: 'CI/CD Automation',
    shortName: 'CI / CD',
    tag: 'DELIVERY',
    domain: 'Automated Pipelines',
    accent: 'violet',
    accentColor: '#818CF8',
    accentGlow: 'rgba(129, 140, 248, 0.38)',
    accentBorder: 'rgba(129, 140, 248, 0.5)',
    technologies: [
      { id: 'githubactions', name: 'GitHub Actions' },
      { id: 'jenkins', name: 'Jenkins' }
    ],
    highlight: 'Automated test, SonarQube quality & Trivy security gates',
    delay: '5.6s',
    x: 320,
    y: 255
  },
  {
    stage: '06',
    name: 'GitOps Delivery',
    shortName: 'GitOps',
    tag: 'GITOPS',
    domain: 'Declarative Sync',
    accent: 'mint',
    accentColor: '#34D399',
    accentGlow: 'rgba(52, 211, 153, 0.38)',
    accentBorder: 'rgba(52, 211, 153, 0.5)',
    technologies: [
      { id: 'argocd', name: 'Argo CD' }
    ],
    highlight: 'Zero-downtime releases & automated cluster sync',
    delay: '7.0s',
    x: 95,
    y: 255
  },
  {
    stage: '07',
    name: 'Observability & Telemetry',
    shortName: 'Telemetry',
    tag: 'OBSERVE',
    domain: 'APM, Logs & Synthetics',
    accent: 'mint',
    accentColor: '#34D399',
    accentGlow: 'rgba(52, 211, 153, 0.38)',
    accentBorder: 'rgba(52, 211, 153, 0.5)',
    technologies: [
      { id: 'prometheus', name: 'Prometheus' },
      { id: 'grafana', name: 'Grafana' },
      { id: 'dynatrace', name: 'Dynatrace' },
      { id: 'elastic', name: 'Elastic Stack' }
    ],
    highlight: 'Dynatrace APM, Catchpoint synthetics & fast RCA',
    delay: '8.4s',
    x: 320,
    y: 435
  }
];

// Continuous SVG Pipeline Circuit Path for Desktop (640x520)
const desktopCircuitPath = 'M 95 75 L 320 75 L 545 75 C 625 75, 625 255, 545 255 L 320 255 L 95 255 C 15 255, 15 435, 95 435 L 320 435 L 545 435';
---

<section class="relative overflow-hidden pt-6 sm:pt-10 lg:pt-14 pb-12 sm:pb-16 lg:pb-24" id="top">

  <!-- Layered Ambient Depth Field -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <!-- Primary atmospheric orb - top left -->
    <div class="hero-orb hero-orb--cyan absolute -top-40 -left-16 h-[800px] w-[800px] rounded-full"></div>
    <!-- Secondary orb - right center -->
    <div class="hero-orb hero-orb--violet absolute top-1/4 -right-24 h-[700px] w-[700px] rounded-full"></div>
    <!-- Tertiary orb - bottom -->
    <div class="hero-orb hero-orb--mint absolute -bottom-28 left-1/3 h-[600px] w-[600px] rounded-full"></div>
    <!-- Engineering grid overlay -->
    <div class="absolute inset-0 hero-grid-pattern opacity-[0.055] dark:opacity-[0.14]"></div>
    <!-- Radial vignette top -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_55%_at_50%_0%,rgba(56,189,248,0.04)_0%,transparent_65%)] dark:bg-[radial-gradient(ellipse_70%_55%_at_50%_0%,rgba(56,189,248,0.09)_0%,transparent_65%)]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0">

    <!-- Main Hero Layout: Left Column (Identity) + Right Column (Pipeline) -->
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1.15fr] lg:gap-12 xl:gap-14">

      <!-- ========================================================================= -->
      <!-- LEFT COLUMN: Editorial Identity, Profile Anchor & High-Contrast CTAs      -->
      <!-- ========================================================================= -->
      <div class="space-y-6 sm:space-y-7">

        <!-- 1. Live Availability & Location Status Badge -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2.5" style="animation-delay: 0ms;">
          <span class="inline-flex items-center gap-2 rounded-full border border-mint/40 bg-mint/[0.08] px-3.5 py-1 font-mono text-[11px] font-semibold text-mint">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
            </span>
            <span>Available for DevOps &amp; Cloud Roles</span>
          </span>

          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">
            <MapPin size={13} class="text-cyan flex-shrink-0" />
            <span>{profile.location}</span>
          </span>
        </div>

        <!-- 2. Integrated Human Profile Anchor + Typographic Name -->
        <div class="hero-animate-in space-y-4" style="animation-delay: 80ms;">

          <div class="flex items-start gap-4 sm:gap-5">
            <!-- Engineer Profile Portrait with Layered Glow Halo -->
            <div class="relative flex-shrink-0 group hero-profile-anchor">
              <!-- Animated ambient halo (always visible, subtle breathing) -->
              <div class="hero-profile-halo absolute -inset-4 rounded-[26px] blur-2xl"></div>
              <!-- Primary gradient halo border -->
              <div class="absolute -inset-[2.5px] rounded-2xl bg-gradient-to-tr from-cyan via-violet to-mint opacity-70 dark:opacity-85 blur-[3px] transition-all duration-500 group-hover:opacity-100 group-hover:blur-[5px]"></div>
              <!-- Inner border ring -->
              <div class="absolute -inset-[1px] rounded-2xl bg-gradient-to-tr from-cyan/80 via-violet/60 to-mint/80 opacity-60 dark:opacity-75"></div>
              <!-- Photo container -->
              <div class="relative h-[72px] w-[72px] sm:h-[84px] sm:w-[84px] rounded-2xl bg-slate-100 dark:bg-panel shadow-2xl overflow-hidden">
                <img
                  src={profile.photo}
                  alt={profile.name}
                  class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.08]"
                  loading="eager"
                  width="84"
                  height="84"
                />
                <!-- Subtle inner luminance overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/10 to-transparent pointer-events-none"></div>
              </div>
              <!-- Experience badge -->
              <div class="absolute -bottom-2.5 -right-1.5 rounded-full border border-slate-200/90 dark:border-white/20 bg-white/98 dark:bg-slate-900/95 px-2 py-0.5 shadow-lg flex items-center gap-1.5 backdrop-blur-sm">
                <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse" aria-hidden="true"></span>
                <span class="font-mono text-[8.5px] font-bold text-slate-800 dark:text-slate-200">5+ YRS</span>
              </div>
            </div>

            <!-- Typographic Name & Eyebrow Category -->
            <div class="space-y-1 min-w-0 flex-1">
              <span class="block font-mono text-[11px] sm:text-xs uppercase tracking-[0.22em] text-cyan font-bold">
                Engineering Portfolio
              </span>
              <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-[3.4rem] font-black tracking-tight font-display leading-[1.05] text-slate-900 dark:text-white">
                <span class="inline sm:block">Chandu</span>{' '}
                <span class="inline sm:block hero-name-gradient">
                  Venna
                </span>
              </h1>
            </div>
          </div>

          <!-- Professional Designation Rule -->
          <div class="flex items-center gap-3 pt-1">
            <div class="h-px w-14 rounded-full bg-gradient-to-r from-cyan to-violet"></div>
            <p class="text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 dark:text-slate-100 font-display tracking-tight">
              DevOps &amp; Cloud Engineer
            </p>
          </div>
        </div>

        <!-- 3. Value Proposition Statement -->
        <div class="hero-animate-in" style="animation-delay: 150ms;">
          <p class="text-base sm:text-[1.05rem] text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl">
            Building reliable cloud infrastructure, Kubernetes platforms, and automated delivery systems across AWS and Azure.
          </p>
        </div>

        <!-- 4. Resume-Verified Proof Points -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2 pt-1 font-mono text-xs" style="animation-delay: 200ms;">
          <span class="hero-proof-pill">
            <ShieldCheck size={13} class="text-cyan" />
            <span>5+ Yrs Production Ops</span>
          </span>
          <span class="hero-proof-pill">
            <Layers size={13} class="text-violet" />
            <span>Multi-AZ K8s &amp; IaC</span>
          </span>
          <span class="hero-proof-pill">
            <Sparkles size={13} class="text-mint" />
            <span>60% Faster Deployments</span>
          </span>
        </div>

        <!-- 5. High-Contrast Primary & Secondary CTAs -->
        <div class="hero-animate-in pt-1 flex flex-wrap items-center gap-3.5" style="animation-delay: 240ms;">
          <!-- Primary CTA -->
          <a
            href="/projects"
            class="hero-cta-primary group inline-flex items-center gap-2.5"
          >
            <span>Explore Case Studies</span>
            <ArrowRight size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
          </a>

          <!-- Secondary CTA -->
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-cta-secondary inline-flex items-center gap-2"
          >
            <Download size={16} />
            <span>Resume</span>
          </a>
        </div>

        <!-- 6. Social & Direct Contact Channels -->
        <div class="hero-animate-in pt-1 flex items-center gap-4 text-xs font-medium text-slate-600 dark:text-slate-400" style="animation-delay: 290ms;">
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-slate-950 dark:hover:text-white transition-colors duration-200"
            aria-label="GitHub Profile"
          >
            <CodeXml size={16} class="text-slate-400 dark:text-slate-500" />
            <span>GitHub</span>
          </a>
          <span class="text-slate-200 dark:text-slate-700">/</span>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-violet transition-colors duration-200"
            aria-label="LinkedIn Profile"
          >
            <BriefcaseBusiness size={16} class="text-slate-400 dark:text-slate-500" />
            <span>LinkedIn</span>
          </a>
          <span class="text-slate-200 dark:text-slate-700">/</span>
          <a
            href={`mailto:${profile.email}`}
            class="flex items-center gap-1.5 hover:text-cyan transition-colors duration-200"
            aria-label="Send Email"
          >
            <Mail size={16} class="text-slate-400 dark:text-slate-500" />
            <span>Email</span>
          </a>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- RIGHT COLUMN: Animated DevOps Delivery Pipeline (Desktop 1024px+)         -->
      <!-- ========================================================================= -->
      <div class="hero-animate-in relative hidden lg:block" style="animation-delay: 150ms;">

        <!-- Pipeline Glass Console Window -->
        <div
          class="pipeline-console-panel relative w-full rounded-3xl overflow-hidden"
          id="devops-pipeline-console"
          role="region"
          aria-label="Interactive DevOps Delivery Pipeline Animation"
        >
          <!-- Background depth layers inside the console -->
          <div class="absolute inset-0 rounded-3xl overflow-hidden pointer-events-none" aria-hidden="true">
            <div class="absolute inset-0 bg-gradient-to-br from-slate-50/97 via-white/92 to-slate-50/97 dark:from-[#0C1320]/97 dark:via-[#090E18]/92 dark:to-[#0C1320]/97"></div>
            <!-- Top radial glow inside panel -->
            <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full bg-cyan/[0.03] dark:bg-cyan/[0.05] blur-3xl"></div>
            <!-- Bottom radial glow inside panel -->
            <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-[500px] h-[300px] rounded-full bg-mint/[0.025] dark:bg-mint/[0.04] blur-3xl"></div>
            <!-- Micro dot grid inside console -->
            <div class="absolute inset-0 hero-dot-grid opacity-[0.035] dark:opacity-[0.07]"></div>
          </div>

          <!-- Console inner border with gradient shimmer -->
          <div class="absolute inset-0 rounded-3xl pointer-events-none" aria-hidden="true">
            <div class="absolute inset-0 rounded-3xl ring-1 ring-slate-200/80 dark:ring-white/[0.06]"></div>
            <div class="absolute inset-0 rounded-3xl bg-gradient-to-b from-white/50 to-transparent dark:from-white/[0.03] dark:to-transparent opacity-60"></div>
          </div>

          <div class="relative z-10 p-5 sm:p-6">
            <!-- Top Console Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-200/70 dark:border-white/[0.06] mb-3">
              <div class="flex items-center gap-2.5">
                <!-- Traffic lights -->
                <div class="flex items-center gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-red-400/80 dark:bg-[#FF5F57]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80 dark:bg-[#FEBC2E]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-green-400/80 dark:bg-[#28C840]"></span>
                </div>
                <span class="font-mono text-[10px] uppercase tracking-widest text-slate-400 dark:text-slate-500 ml-1">
                  devops-pipeline.sh
                </span>
              </div>

              <div class="flex items-center gap-2 font-mono text-[10px] text-slate-500 dark:text-slate-400">
                <span class="inline-flex items-center gap-1 rounded-md bg-cyan/10 dark:bg-cyan/[0.12] px-2 py-0.5 text-cyan font-bold border border-cyan/20">
                  7 STAGES
                </span>
                <span class="hidden xl:inline">
                  <span class="inline-flex items-center gap-1 text-mint font-semibold">
                    <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse"></span>
                    60% Faster Velocity
                  </span>
                </span>
              </div>
            </div>

            <!-- =================================================================== -->
            <!-- DESKTOP PIPELINE CANVAS: SVG Track + Sequential Traveling Pulses   -->
            <!-- =================================================================== -->
            <div class="relative w-full h-[470px] select-none">

              <!-- SVG Circuit Tracks & Animated Data Streams -->
              <svg
                class="absolute inset-0 h-full w-full pointer-events-none overflow-visible z-0"
                viewBox="0 0 640 480"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <defs>
                  <!-- Main signal glow filter -->
                  <filter id="signal-glow" x="-100%" y="-100%" width="300%" height="300%">
                    <feGaussianBlur stdDeviation="5" result="blur1"/>
                    <feGaussianBlur stdDeviation="2.5" result="blur2"/>
                    <feMerge>
                      <feMergeNode in="blur1"/>
                      <feMergeNode in="blur2"/>
                      <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                  </filter>

                  <!-- Node glow filter -->
                  <filter id="node-glow" x="-60%" y="-60%" width="220%" height="220%">
                    <feGaussianBlur stdDeviation="7" result="coloredBlur"/>
                    <feMerge>
                      <feMergeNode in="coloredBlur"/>
                      <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                  </filter>

                  <!-- Track outer glow filter (depth layer) -->
                  <filter id="track-glow" x="-20%" y="-200%" width="140%" height="500%">
                    <feGaussianBlur stdDeviation="3" result="glow"/>
                    <feMerge>
                      <feMergeNode in="glow"/>
                      <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                  </filter>

                  <!-- Linear gradient for the active glowing track -->
                  <linearGradient id="track-flow-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.95" />
                    <stop offset="40%" stop-color="#818CF8" stop-opacity="0.9" />
                    <stop offset="100%" stop-color="#34D399" stop-opacity="0.95" />
                  </linearGradient>

                  <!-- Glow version of track gradient -->
                  <linearGradient id="track-glow-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.3" />
                    <stop offset="40%" stop-color="#818CF8" stop-opacity="0.25" />
                    <stop offset="100%" stop-color="#34D399" stop-opacity="0.3" />
                  </linearGradient>

                  <!-- Primary signal particle gradient (white-hot center) -->
                  <radialGradient id="signal-particle-fill" cx="50%" cy="35%" r="65%">
                    <stop offset="0%" stop-color="#FFFFFF" />
                    <stop offset="35%" stop-color="#A5EBFF" />
                    <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.5" />
                  </radialGradient>

                  <!-- Trailing particle gradient (violet) -->
                  <radialGradient id="trail-particle-fill" cx="50%" cy="35%" r="65%">
                    <stop offset="0%" stop-color="#E0D8FF" />
                    <stop offset="100%" stop-color="#818CF8" stop-opacity="0.4" />
                  </radialGradient>

                  <!-- Mint micro trail -->
                  <radialGradient id="mint-particle-fill" cx="50%" cy="35%" r="65%">
                    <stop offset="0%" stop-color="#AFFFDB" />
                    <stop offset="100%" stop-color="#34D399" stop-opacity="0.4" />
                  </radialGradient>
                </defs>

                <!-- Outermost ghost track (deepest depth layer, thick blur) -->
                <path
                  d={desktopCircuitPath}
                  stroke="url(#track-glow-gradient)"
                  stroke-width="10"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  opacity="0.45"
                  filter="url(#track-glow)"
                  class="dark:opacity-[0.55]"
                />

                <!-- Mid depth track (solid base) -->
                <path
                  d={desktopCircuitPath}
                  class="stroke-slate-300/40 dark:stroke-white/[0.06]"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

                <!-- Active gradient track (luminous core) -->
                <path
                  d={desktopCircuitPath}
                  stroke="url(#track-flow-gradient)"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  opacity="0.75"
                  class="dark:opacity-[0.9]"
                />

                <!-- Flowing dashed pulse (marching ants effect) -->
                <path
                  d={desktopCircuitPath}
                  stroke="url(#track-flow-gradient)"
                  stroke-width="1.5"
                  stroke-dasharray="6 14"
                  class="pipeline-circuit-flow"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

                <!-- Primary luminous data signal (lead particle) -->
                <circle
                  r="6"
                  fill="url(#signal-particle-fill)"
                  filter="url(#signal-glow)"
                  class="pipeline-signal-particle"
                >
                  <animateMotion
                    dur="10s"
                    repeatCount="indefinite"
                    path={desktopCircuitPath}
                    rotate="auto"
                  />
                </circle>

                <!-- Secondary trailing packet (violet) -->
                <circle
                  r="4"
                  fill="url(#trail-particle-fill)"
                  opacity="0.8"
                  filter="url(#signal-glow)"
                  class="pipeline-signal-particle"
                >
                  <animateMotion
                    dur="10s"
                    begin="-0.55s"
                    repeatCount="indefinite"
                    path={desktopCircuitPath}
                    rotate="auto"
                  />
                </circle>

                <!-- Tertiary micro-packet (mint) -->
                <circle
                  r="2.5"
                  fill="url(#mint-particle-fill)"
                  opacity="0.65"
                  filter="url(#signal-glow)"
                  class="pipeline-signal-particle"
                >
                  <animateMotion
                    dur="10s"
                    begin="-1.1s"
                    repeatCount="indefinite"
                    path={desktopCircuitPath}
                    rotate="auto"
                  />
                </circle>
              </svg>

              <!-- =================================================================== -->
              <!-- 7 SEQUENTIALLY POSITIONED & ANIMATED DEVOPS STAGE CAPSULES          -->
              <!-- =================================================================== -->
              {pipelineStages.map((stage) => (
                <div
                  class="pipeline-node-wrapper absolute z-10 -translate-x-1/2 -translate-y-1/2 group cursor-pointer"
                  style={`left: ${(stage.x / 640) * 100}%; top: ${(stage.y / 480) * 100}%;`}
                  data-stage-id={stage.stage}
                  data-accent={stage.accent}
                  tabindex="0"
                  role="button"
                  aria-label={`Stage ${stage.stage}: ${stage.name} (${stage.tag}) - ${stage.highlight}`}
                >
                  <!-- Hover ambient glow halo (behind capsule) -->
                  <div
                    class="pipeline-node-glow absolute -inset-4 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-2xl pointer-events-none"
                    style={`background: radial-gradient(ellipse 80% 80%, ${stage.accentGlow} 0%, transparent 70%);`}
                  ></div>

                  <!-- Sequential activation pulse halo (synced with signal particle) -->
                  <div
                    class="pipeline-node-pulse-ring absolute -inset-2 rounded-3xl pointer-events-none"
                    style={`border: 1.5px solid ${stage.accentColor}; animation-delay: ${stage.delay};`}
                  ></div>

                  <!-- Stage Interactive Capsule -->
                  <div
                    class:list={[
                      "pipeline-stage-capsule relative flex flex-col gap-1.5 rounded-2xl p-2.5 sm:p-3",
                      "transition-all duration-300 backdrop-blur-md",
                      "min-w-[145px] max-w-[170px]",

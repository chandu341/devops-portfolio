---
import { ArrowRight, ChevronDown, Code, Download } from '@lucide/astro';
import { profile } from '@/data/profile';

const allSkills = [
  'AWS', 'Azure', 'Kubernetes', 'Terraform', 'Docker', 'Helm', 'Argo CD',
  'Jenkins', 'GitHub Actions', 'Prometheus', 'Grafana', 'Elastic Stack',
  'SonarQube', 'Trivy', 'VPC', 'EKS', 'AKS', 'ECS', 'RDS', 'Linux',
  'Python', 'Bash', 'Ansible', 'Jira', 'ServiceNow', 'CI/CD', 'GitOps',
  'IAM', 'ALB', 'Route 53', 'CloudFormation', 'Catchpoint', 'Dynatrace'
];
// Duplicate for seamless infinite scroll
const marqueeSkills = [...allSkills, ...allSkills];

const gitChips = [
  { label: 'main', cls: 'git-chip--violet' },
  { label: '→ checkout -b feat/ci', cls: '' },
  { label: 'pipeline.yml', cls: 'git-chip--cyan' },
  { label: '✓ checks passing', cls: 'git-chip--green' },
  { label: '● secure', cls: 'git-chip--green' },
  { label: 'merge → main', cls: 'git-chip--violet' },
  { label: 'v2.0.0', cls: 'git-chip--cyan' },
  { label: '✓ deployed', cls: 'git-chip--green' },
  { label: 'status: 200 OK', cls: 'git-chip--green' },
];
---

<section class="relative overflow-hidden pt-4" id="top">
  <!-- Marquee background flourish -->
  <div class="pointer-events-none absolute inset-x-0 bottom-12 opacity-[0.055] select-none" aria-hidden="true">
    <div class="marquee-outer">
      <div class="marquee-track font-mono text-sm uppercase tracking-widest text-slate-200">
        {marqueeSkills.map((skill) => (
          <span class="flex-shrink-0 whitespace-nowrap px-3">{skill}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="mx-auto grid min-h-0 max-w-7xl items-center gap-8 px-4 pb-8 pt-4 sm:gap-10 sm:px-6 sm:pb-10 sm:pt-10 lg:min-h-[calc(100vh-5.5rem)] lg:grid-cols-[1fr_0.9fr] lg:px-8 lg:pt-8">

    <!-- LEFT COLUMN -->
    <div class="reveal-up">
      <!-- Eyebrow -->
      <p class="hero-eyebrow">
        DevOps &amp; Cloud Engineer &nbsp;·&nbsp; ap-south-1 / Bengaluru
      </p>

      <!-- Display name -->
      <h1 class="hero-display-name mt-4 sm:mt-5">
        {profile.name}
      </h1>

      <!-- Tagline -->
      <p class="hero-tagline mt-4 sm:mt-5">
        {profile.tagline}
      </p>

      <!-- CTAs -->
      <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-2.5 sm:gap-3">
        <a
          href="/#contact"
          id="hero-cta-connect"
          class="inline-flex items-center justify-center gap-2 rounded-[12px] bg-cyan px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-white"
        >
          Let's connect <ArrowRight size={16} />
        </a>
        <a
          href="/projects"
          id="hero-cta-work"
          class="inline-flex items-center justify-center gap-2 rounded-[12px] border border-white/12 bg-white/[0.045] px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base font-semibold text-white transition hover:-translate-y-0.5 hover:border-violet/45"
        >
          View the work
        </a>
        <a
          href={profile.resume}
          id="hero-cta-resume"
          class="inline-flex items-center justify-center gap-2 rounded-[12px] border border-white/12 bg-white/[0.045] px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan/45"
        >
          <Download size={16} /> Resume
        </a>
        <a
          href={profile.github}
          id="hero-cta-github"
          class="inline-flex items-center justify-center gap-2 rounded-[12px] border border-white/12 bg-white/[0.045] px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base font-semibold text-white transition hover:-translate-y-0.5 hover:border-violet/45"
        >
          <Code size={16} /> GitHub
        </a>
      </div>

      <!-- Status meta block -->
      <div class="mt-6 sm:mt-7 status-meta-block">
        <span><span class="s-label">status</span><span class="s-live">● operational</span></span>
        <span><span class="s-label">region</span>ap-south-1 · Bengaluru</span>
        <span><span class="s-label">since</span>2021 · 5y+ uptime</span>
        <span><span class="s-label">local</span><span id="hero-clock" class="s-live">--:--:--</span></span>
      </div>

      <!-- Git chip strip -->
      <div class="mt-6 git-strip" aria-hidden="true">
        {gitChips.map((chip) => (
          <span class:list={['git-chip', chip.cls]}>{chip.label}</span>
        ))}
      </div>

      <!-- Scroll cue -->
      <a href="/#about" class="scroll-cue mt-8 inline-flex" aria-label="Scroll to About section">
        <ChevronDown size={14} />&nbsp;scroll down
      </a>
    </div>

    <!-- RIGHT COLUMN — DEPLOY-MONITOR / Production System Dashboard -->
    <div class="relative reveal-up lg:pt-4" style="animation-delay: 120ms;">
      <div class="max-w-lg mx-auto lg:mx-0 rounded-[22px] border border-white/10 bg-panel2/90 p-5 sm:p-6 shadow-2xl backdrop-blur-md">
        <!-- Terminal Header -->
        <div class="flex items-center justify-between border-b border-white/[0.08] pb-3.5">
          <div class="flex items-center gap-2">
            <span class="status-dot red"></span>
            <span class="status-dot amber"></span>
            <span class="status-dot green"></span>
            <span class="ml-1 font-mono text-[11px] uppercase tracking-widest text-slate-300">deploy-monitor // k8s-prod</span>
          </div>
          <span class="rounded-full border border-mint/30 bg-mint/10 px-2.5 py-0.5 font-mono text-[9px] uppercase tracking-widest text-mint font-semibold">
            ● healthy
          </span>
        </div>

        <!-- Command Line -->
        <div class="mt-4 font-mono text-xs text-slate-300">
          <span class="text-mint">$</span> <span class="text-cyan">kubectl</span> get pods -n production
        </div>

        <!-- Pods Status List -->
        <div class="mt-3.5 space-y-2 font-mono text-[11px]">
          <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3.5 py-2.5 border border-white/[0.04]">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-mint"></span>
              <span class="text-slate-200">api-service-prod</span>
            </div>
            <div class="flex items-center gap-3 text-slate-400">
              <span>3/3</span>
              <span class="text-mint font-medium">Running</span>
            </div>
          </div>

          <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3.5 py-2.5 border border-white/[0.04]">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-mint"></span>
              <span class="text-slate-200">auth-microservice</span>
            </div>
            <div class="flex items-center gap-3 text-slate-400">
              <span>2/2</span>
              <span class="text-mint font-medium">Running</span>
            </div>
          </div>

          <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3.5 py-2.5 border border-white/[0.04]">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-mint"></span>
              <span class="text-slate-200">ingress-alb-controller</span>
            </div>
            <div class="flex items-center gap-3 text-slate-400">
              <span>2/2</span>
              <span class="text-mint font-medium">Running</span>
            </div>
          </div>

          <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3.5 py-2.5 border border-white/[0.04]">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-cyan"></span>
              <span class="text-slate-200">prometheus-collector</span>
            </div>
            <div class="flex items-center gap-3 text-slate-400">
              <span>1/1</span>
              <span class="text-cyan font-medium">Healthy</span>
            </div>
          </div>
        </div>

        <!-- Telemetry & Deploy Metrics Grid -->
        <div class="mt-4 grid grid-cols-2 gap-2.5 pt-3 border-t border-white/[0.08]">
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2.5">
            <span class="block font-mono text-[9px] uppercase tracking-wider text-muted">deployment</span>
            <span class="mt-0.5 block font-mono text-xs font-semibold text-mint">zero-downtime</span>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2.5">
            <span class="block font-mono text-[9px] uppercase tracking-wider text-muted">gitops sync</span>
            <span class="mt-0.5 block font-mono text-xs font-semibold text-cyan">Argo CD · in-sync</span>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2.5">
            <span class="block font-mono text-[9px] uppercase tracking-wider text-muted">iac state</span>
            <span class="mt-0.5 block font-mono text-xs font-semibold text-slate-200">Terraform · 0 drift</span>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2.5">
            <span class="block font-mono text-[9px] uppercase tracking-wider text-muted">cluster health</span>
            <span class="mt-0.5 block font-mono text-xs font-semibold text-mint">99.9% uptime</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Hero live clock
  (function () {
    var el = document.getElementById('hero-clock');
    if (!el) return;
    function tick() {
      var now = new Date();
      var h = String(now.getHours()).padStart(2, '0');
      var m = String(now.getMinutes()).padStart(2, '0');
      var s = String(now.getSeconds()).padStart(2, '0');
      el.textContent = h + ':' + m + ':' + s;
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

---
import {
  ArrowRight,
  BriefcaseBusiness,
  CodeXml,
  Download,
  Layers,
  Mail,
  MapPin,
  ShieldCheck,
  Sparkles
} from '@lucide/astro';
import { profile } from '@/data/profile';
import TechIcon from '@/components/TechIcon.astro';

// Structured 7-Stage DevOps Delivery Pipeline Flow
// 01 Cloud -> 02 IaC -> 03 Containers -> 04 Platform -> 05 CI/CD -> 06 GitOps -> 07 Observability
const pipelineStages = [
  {
    stage: '01',
    name: 'Cloud Infrastructure',
    shortName: 'Cloud',
    tag: 'FOUNDATION',
    domain: 'Public Cloud & VPC',
    accent: 'cyan',
    accentColor: '#0284C7',
    accentGlow: 'rgba(2, 132, 199, 0.4)',
    technologies: [
      { id: 'aws', name: 'AWS' },
      { id: 'azure', name: 'Azure' }
    ],
    highlight: 'Multi-AZ VPCs, EKS, EC2, S3, RDS & IAM security',
    delay: '0s',
    // Desktop layout coordinates (in 640x520 canvas)
    x: 95,
    y: 75
  },
  {
    stage: '02',
    name: 'Infrastructure as Code',
    shortName: 'IaC',
    tag: 'PROVISIONING',
    domain: 'Declarative State',
    accent: 'violet',
    accentColor: '#6366F1',
    accentGlow: 'rgba(99, 102, 241, 0.4)',
    technologies: [
      { id: 'terraform', name: 'Terraform' },
      { id: 'ansible', name: 'Ansible' }
    ],
    highlight: 'Automated cloud provisioning, modules & state locks',
    delay: '1.4s',
    x: 320,
    y: 75
  },
  {
    stage: '03',
    name: 'Containers',
    shortName: 'Containers',
    tag: 'PACKAGING',
    domain: 'Immutable Runtime',
    accent: 'cyan',
    accentColor: '#0284C7',
    accentGlow: 'rgba(2, 132, 199, 0.4)',
    technologies: [
      { id: 'docker', name: 'Docker' }
    ],
    highlight: 'Multi-stage OCI builds & minimal attack surfaces',
    delay: '2.8s',
    x: 545,
    y: 75
  },
  {
    stage: '04',
    name: 'Orchestration',
    shortName: 'Platform',
    tag: 'PLATFORM',
    domain: 'Kubernetes Platform',
    accent: 'cyan',
    accentColor: '#0284C7',
    accentGlow: 'rgba(2, 132, 199, 0.4)',
    technologies: [
      { id: 'kubernetes', name: 'Kubernetes' },
      { id: 'helm', name: 'Helm' }
    ],
    highlight: 'EKS/AKS clusters, 12+ microservices & ALB ingress',
    delay: '4.2s',
    x: 545,
    y: 255
  },
  {
    stage: '05',
    name: 'CI/CD Automation',
    shortName: 'CI / CD',
    tag: 'DELIVERY',
    domain: 'Automated Pipelines',
    accent: 'violet',
    accentColor: '#6366F1',
    accentGlow: 'rgba(99, 102, 241, 0.4)',
    technologies: [
      { id: 'githubactions', name: 'GitHub Actions' },
      { id: 'jenkins', name: 'Jenkins' }
    ],
    highlight: 'Automated test, SonarQube quality & Trivy security gates',
    delay: '5.6s',
    x: 320,
    y: 255
  },
  {
    stage: '06',
    name: 'GitOps Delivery',
    shortName: 'GitOps',
    tag: 'GITOPS',
    domain: 'Declarative Sync',
    accent: 'mint',
    accentColor: '#059669',
    accentGlow: 'rgba(5, 150, 105, 0.4)',
    technologies: [
      { id: 'argocd', name: 'Argo CD' }
    ],
    highlight: 'Zero-downtime releases & automated cluster sync',
    delay: '7.0s',
    x: 95,
    y: 255
  },
  {
    stage: '07',
    name: 'Observability & Telemetry',
    shortName: 'Telemetry',
    tag: 'OBSERVE',
    domain: 'APM, Logs & Synthetics',
    accent: 'mint',
    accentColor: '#059669',
    accentGlow: 'rgba(5, 150, 105, 0.4)',
    technologies: [
      { id: 'prometheus', name: 'Prometheus' },
      { id: 'grafana', name: 'Grafana' },
      { id: 'dynatrace', name: 'Dynatrace' },
      { id: 'elastic', name: 'Elastic Stack' }
    ],
    highlight: 'Dynatrace APM, Catchpoint synthetics & fast RCA',
    delay: '8.4s',
    x: 320,
    y: 435
  }
];

// Continuous SVG Pipeline Circuit Path for Desktop (640x520)
// Starts at Stage 01 (95, 75) -> Stage 02 (320, 75) -> Stage 03 (545, 75)
// -> Curves down right to Row 2 -> Stage 04 (545, 255) -> Stage 05 (320, 255) -> Stage 06 (95, 255)
// -> Curves down left to Row 3 -> Stage 07 (320, 435) -> (545, 435)
const desktopCircuitPath = 'M 95 75 L 320 75 L 545 75 C 625 75, 625 255, 545 255 L 320 255 L 95 255 C 15 255, 15 435, 95 435 L 320 435 L 545 435';
---

<section class="relative overflow-hidden pt-6 sm:pt-10 lg:pt-14 pb-12 sm:pb-16 lg:pb-24" id="top">

  <!-- Ambient Background Glow Mesh (Theme-adaptive) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 left-1/4 h-[550px] w-[550px] rounded-full bg-cyan/[0.07] dark:bg-cyan/[0.08] blur-[130px]"></div>
    <div class="absolute top-1/3 right-0 h-[500px] w-[500px] rounded-full bg-violet/[0.06] dark:bg-violet/[0.08] blur-[130px]"></div>
    <div class="absolute -bottom-20 left-1/3 h-[400px] w-[400px] rounded-full bg-mint/[0.04] dark:bg-mint/[0.05] blur-[120px]"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-10 dark:opacity-20"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0">

    <!-- Main Hero Layout: Left Column (Identity, Profile Anchor, Proofs, CTAs) + Right Column (DevOps Pipeline) -->
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1.15fr] lg:gap-12 xl:gap-14">

      <!-- ========================================================================= -->
      <!-- LEFT COLUMN: Editorial Identity, Profile Anchor & High-Contrast CTAs      -->
      <!-- ========================================================================= -->
      <div class="space-y-6 sm:space-y-7">

        <!-- 1. Live Availability & Location Status Badge -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2.5" style="animation-delay: 0ms;">
          <span class="inline-flex items-center gap-2 rounded-full border border-mint/40 bg-mint/[0.08] px-3.5 py-1 font-mono text-[11px] font-semibold text-mint">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
            </span>
            <span>Available for DevOps &amp; Cloud Roles</span>
          </span>

          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">
            <MapPin size={13} class="text-cyan flex-shrink-0" />
            <span>{profile.location}</span>
          </span>
        </div>

        <!-- 2. Integrated Human Profile Anchor + Masterpiece Typographic Name -->
        <div class="hero-animate-in space-y-4" style="animation-delay: 80ms;">

          <div class="flex items-start gap-4 sm:gap-5">
            <!-- Engineer Profile Portrait Anchor -->
            <div class="relative flex-shrink-0 group">
              <div class="absolute -inset-1.5 rounded-2xl bg-gradient-to-tr from-cyan via-violet to-mint opacity-60 blur-md transition duration-500 group-hover:opacity-90"></div>
              <div class="relative h-16 w-16 sm:h-20 sm:w-20 rounded-2xl border-2 border-white dark:border-white/20 bg-slate-100 dark:bg-panel shadow-lg overflow-hidden ring-2 ring-slate-900/5 dark:ring-white/10">
                <img
                  src={profile.photo}
                  alt={profile.name}
                  class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                  loading="eager"
                  width="80"
                  height="80"
                />
              </div>
              <div class="absolute -bottom-2 -right-1 rounded-full border border-slate-300 dark:border-white/20 bg-white/95 dark:bg-slate-900/95 px-1.5 py-0.5 shadow-sm flex items-center gap-1">
                <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse" aria-hidden="true"></span>
                <span class="font-mono text-[8.5px] font-bold text-slate-800 dark:text-slate-200">5+ YRS</span>
              </div>
            </div>

            <!-- Typographic Name & Category -->
            <div class="space-y-1 min-w-0 flex-1">
              <span class="block font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] text-cyan font-bold">
                Engineering Portfolio
              </span>
              <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-black tracking-tight font-display leading-[1.08] text-slate-900 dark:text-white">
                <span class="inline sm:block">Chandu</span>{' '}
                <span class="inline sm:block bg-gradient-to-r from-cyan via-violet to-mint bg-clip-text text-transparent">
                  Venna
                </span>
              </h1>
            </div>
          </div>

          <!-- Professional Designation Pill Bar -->
          <div class="flex items-center gap-3 pt-1">
            <div class="h-1 w-12 rounded-full bg-gradient-to-r from-cyan to-violet"></div>
            <p class="text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 dark:text-slate-200 font-display">
              DevOps &amp; Cloud Engineer
            </p>
          </div>
        </div>

        <!-- 3. Value Proposition Statement -->
        <div class="hero-animate-in space-y-4" style="animation-delay: 150ms;">
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl font-normal">
            Building reliable cloud infrastructure, Kubernetes platforms, and automated delivery systems across AWS and Azure.
          </p>
        </div>

        <!-- 4. Resume-Verified Proof Points (Max 3 Points) -->
        <div class="hero-animate-in flex flex-wrap items-center gap-2 pt-1 font-mono text-xs text-slate-600 dark:text-slate-300" style="animation-delay: 200ms;">
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <ShieldCheck size={13} class="text-cyan" />
            <span>5+ Yrs Production Ops</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <Layers size={13} class="text-violet" />
            <span>Multi-AZ K8s &amp; IaC</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-white/10 bg-slate-100/80 dark:bg-white/[0.04] px-2.5 py-1">
            <Sparkles size={13} class="text-mint" />
            <span>60% Faster Deployments</span>
          </span>
        </div>

        <!-- 5. High-Contrast Primary & Secondary CTAs -->
        <div class="hero-animate-in pt-1 flex flex-wrap items-center gap-3.5" style="animation-delay: 240ms;">
          <!-- Primary CTA -->
          <a
            href="/projects"
            class="group inline-flex items-center gap-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-ink px-6 py-3.5 text-sm sm:text-base font-semibold shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Explore Case Studies</span>
            <ArrowRight size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
          </a>

          <!-- Secondary CTA -->
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-300 dark:border-white/15 bg-white dark:bg-white/[0.04] text-slate-800 dark:text-slate-200 px-5 py-3.5 text-sm sm:text-base font-semibold transition-all duration-200 hover:border-slate-400 dark:hover:border-white/30 hover:bg-slate-50 dark:hover:bg-white/[0.08] active:scale-[0.98] shadow-sm"
          >
            <Download size={16} />
            <span>Resume</span>
          </a>
        </div>

        <!-- 6. Compact Social & Direct Contact Channels -->
        <div class="hero-animate-in pt-1 flex items-center gap-4 text-xs font-medium text-slate-600 dark:text-slate-400" style="animation-delay: 290ms;">
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-slate-950 dark:hover:text-white transition-colors"
            aria-label="GitHub Profile"
          >
            <CodeXml size={16} class="text-slate-500 dark:text-slate-400" />
            <span>GitHub</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 hover:text-violet transition-colors"
            aria-label="LinkedIn Profile"
          >
            <BriefcaseBusiness size={16} class="text-slate-500 dark:text-slate-400" />
            <span>LinkedIn</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={`mailto:${profile.email}`}
            class="flex items-center gap-1.5 hover:text-cyan transition-colors"
            aria-label="Send Email"
          >
            <Mail size={16} class="text-slate-500 dark:text-slate-400" />
            <span>Email</span>
          </a>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- RIGHT COLUMN: Animated DevOps Delivery Pipeline (Desktop 1024px+)         -->
      <!-- ========================================================================= -->
      <div class="hero-animate-in relative hidden lg:block" style="animation-delay: 150ms;">

        <!-- Pipeline Glass Console Window -->
        <div
          class="relative w-full rounded-3xl border border-slate-200/90 dark:border-white/[0.08] bg-white/70 dark:bg-panel/75 backdrop-blur-xl p-5 sm:p-6 overflow-hidden shadow-2xl"
          id="devops-pipeline-console"
          role="region"
          aria-label="Interactive DevOps Delivery Pipeline Animation"
        >

          <!-- Top Console Header -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-200/80 dark:border-white/[0.06] mb-3">
            <div class="flex items-center gap-2.5">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan"></span>
              </span>
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
                DevOps Delivery Pipeline
              </span>
            </div>

            <div class="flex items-center gap-2 font-mono text-[10px] text-slate-500 dark:text-slate-400">
              <span class="inline-flex items-center gap-1 rounded bg-slate-100 dark:bg-white/[0.05] px-2 py-0.5 text-cyan font-bold">
                7 STAGES
              </span>
              <span class="hidden xl:inline text-slate-400 dark:text-slate-500">|</span>
              <span class="hidden xl:inline text-mint font-semibold">● 60% Faster Velocity</span>
            </div>
          </div>

          <!-- =================================================================== -->
          <!-- DESKTOP PIPELINE CANVAS: SVG Track + Sequential Traveling Pulses     -->
          <!-- =================================================================== -->
          <div class="relative w-full h-[470px] select-none">

            <!-- SVG Circuit Tracks & Animated Data Streams -->
            <svg
              class="absolute inset-0 h-full w-full pointer-events-none overflow-visible z-0"
              viewBox="0 0 640 480"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <defs>
                <!-- Glowing Filter for Signal Pulses -->
                <filter id="signal-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="3.5" result="coloredBlur"/>
                  <feMerge>
                    <feMergeNode in="coloredBlur"/>
                    <feMergeNode in="SourceGraphic"/>
                  </feMerge>
                </filter>

                <!-- Track Linear Gradients -->
                <linearGradient id="track-flow" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#0284C7" stop-opacity="0.8" />
                  <stop offset="50%" stop-color="#6366F1" stop-opacity="0.8" />
                  <stop offset="100%" stop-color="#059669" stop-opacity="0.8" />
                </linearGradient>

                <linearGradient id="signal-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#38BDF8" />
                  <stop offset="50%" stop-color="#818CF8" />
                  <stop offset="100%" stop-color="#34D399" />
                </linearGradient>
              </defs>

              <!-- Base Inactive Circuit Track -->
              <path
                d={desktopCircuitPath}
                class="stroke-slate-300/60 dark:stroke-white/[0.08]"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <!-- Flowing Dashed Pulse Track -->
              <path
                d={desktopCircuitPath}
                stroke="url(#track-flow)"
                stroke-width="2"
                stroke-dasharray="6 8"
                class="pipeline-circuit-flow"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <!-- Primary Luminous Data Particle traveling along the complete 7-stage pipeline (10s cycle) -->
              <circle
                r="5"
                fill="url(#signal-gradient)"
                filter="url(#signal-glow)"
                class="pipeline-signal-particle"
              >
                <animateMotion
                  dur="10s"
                  repeatCount="indefinite"
                  path={desktopCircuitPath}
                  rotate="auto"
                />
              </circle>

              <!-- Secondary Trailing Packet for realistic data flow sensation -->
              <circle
                r="3"
                fill="#38BDF8"
                opacity="0.7"
                filter="url(#signal-glow)"
                class="pipeline-signal-particle"
              >
                <animateMotion
                  dur="10s"
                  begin="-0.4s"
                  repeatCount="indefinite"
                  path={desktopCircuitPath}
                  rotate="auto"
                />
              </circle>
            </svg>

            <!-- =================================================================== -->
            <!-- 7 SEQUENTIALLY POSITIONED & ANIMATED DEVOPS STAGE CAPSULES          -->
            <!-- =================================================================== -->
            {pipelineStages.map((stage) => (
              <div
                class="pipeline-node-wrapper absolute z-10 -translate-x-1/2 -translate-y-1/2 group cursor-pointer transition-all duration-300"
                style={`left: ${(stage.x / 640) * 100}%; top: ${(stage.y / 480) * 100}%;`}
                data-stage-id={stage.stage}
                tabindex="0"
                role="button"
                aria-label={`Stage ${stage.stage}: ${stage.name} (${stage.tag}) - ${stage.highlight}`}
              >
                <!-- Stage Interactive Capsule -->
                <div
                  class:list={[
                    "pipeline-stage-capsule flex flex-col gap-1.5 rounded-2xl border p-2.5 sm:p-3 shadow-md transition-all duration-300 backdrop-blur-md",
                    "bg-white/95 dark:bg-panel2/95 border-slate-200/90 dark:border-white/10",
                    "hover:scale-[1.06] hover:shadow-xl hover:bg-white dark:hover:bg-panel",
                    "min-w-[145px] max-w-[170px]",
                    stage.stage === '07' && "min-w-[280px] max-w-[340px]"
                  ]}
                  style={`--stage-accent: ${stage.accentColor}; --stage-glow: ${stage.accentGlow}; animation-delay: ${stage.delay};`}
                >
                  <!-- Stage Header: Stage Number Badge + Category Tag -->
                  <div class="flex items-center justify-between gap-1">
                    <span class:list={[
                      "font-mono text-[9.5px] font-extrabold uppercase px-1.5 py-0.5 rounded-md",
                      stage.accent === 'cyan' && "bg-cyan/10 text-cyan dark:text-cyan",
                      stage.accent === 'violet' && "bg-violet/10 text-violet dark:text-violet",
                      stage.accent === 'mint' && "bg-mint/10 text-mint dark:text-mint"
                    ]}>
                      {stage.stage} · {stage.tag}
                    </span>

                    <span class="font-mono text-[8px] text-slate-400 dark:text-slate-500 uppercase tracking-tight truncate">
                      {stage.shortName}
                    </span>
                  </div>

                  <!-- Stage Technology Logos + Names -->
                  <div class="flex items-center flex-wrap gap-2 pt-0.5">
                    {stage.technologies.map((t) => (
                      <div class="flex items-center gap-1.5">
                        <span class="flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                          <TechIcon name={t.id} size={18} />
                        </span>
                        <span class="font-display font-bold text-xs text-slate-900 dark:text-white leading-tight">
                          {t.name}
                        </span>
                      </div>
                    ))}
                  </div>

                  <!-- Micro Capability Caption -->
                  <p class="text-[9.5px] leading-tight text-slate-500 dark:text-slate-400 truncate mt-0.5">
                    {stage.highlight}
                  </p>
                </div>
              </div>
            ))}

          </div>

          <!-- Bottom Telemetry Status Bar -->
          <div class="mt-2 pt-3 border-t border-slate-200/80 dark:border-white/[0.06] flex items-center justify-between text-xs font-mono">
            <div class="flex items-center gap-1 text-[10px] text-slate-500 dark:text-slate-400">
              <span class="font-bold text-slate-700 dark:text-slate-300">FLOW:</span>
              <span>Cloud</span>
              <span>→</span>
              <span>IaC</span>
              <span>→</span>
              <span>OCI</span>
              <span>→</span>
              <span>K8s</span>
              <span>→</span>
              <span>CI/CD</span>
              <span>→</span>
              <span>GitOps</span>
              <span>→</span>
              <span class="text-mint font-bold">Observe</span>
            </div>

            <div class="flex items-center gap-1.5 text-[10px] text-mint">
              <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse"></span>
              <span class="font-bold">99.9% Uptime</span>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- MOBILE / TABLET VERTICAL DEVOPS PIPELINE (< 1024px)                       -->
    <!-- ========================================================================= -->
    <div class="block lg:hidden mt-8 sm:mt-10">

      <div class="rounded-3xl border border-slate-200/90 dark:border-white/[0.08] bg-white/80 dark:bg-panel/85 backdrop-blur-xl p-4 sm:p-6 space-y-4 shadow-xl">

        <!-- Mobile Pipeline Header -->
        <div class="flex items-center justify-between pb-3 border-b border-slate-200/80 dark:border-white/[0.06]">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan"></span>
            </span>
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
              DevOps Delivery Flow
            </span>
          </div>

          <span class="font-mono text-[10px] text-cyan font-bold bg-cyan/10 px-2 py-0.5 rounded-full">
            7 Sequential Stages
          </span>
        </div>

        <!-- Vertical Flow Container with Animated Spine Line -->
        <div class="relative pl-6 sm:pl-8 space-y-3 sm:space-y-4">

          <!-- Vertical Pulsing Spine -->
          <div class="absolute left-2.5 sm:left-3.5 top-3 bottom-3 w-0.5 bg-gradient-to-b from-cyan via-violet to-mint opacity-40"></div>

          <!-- 7 Vertical Stage Cards -->
          {pipelineStages.map((stage) => (
            <div class="relative flex items-start gap-3">

              <!-- Node Anchor Dot on Vertical Spine -->
              <div class="absolute -left-6 sm:-left-8 top-3 flex items-center justify-center">
                <span class:list={[

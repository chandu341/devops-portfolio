---
import { ArrowRight, BriefcaseBusiness, ChevronDown, Code, Download } from '@lucide/astro';
import { profile } from '@/data/profile';

const allSkills = [
  'AWS', 'Azure', 'Kubernetes', 'Terraform', 'Docker', 'Helm', 'Argo CD',
  'Jenkins', 'GitHub Actions', 'Prometheus', 'Grafana', 'Elastic Stack',
  'SonarQube', 'Trivy', 'VPC', 'EKS', 'AKS', 'ECS', 'RDS', 'Linux',
  'Python', 'Bash', 'Ansible', 'Jira', 'ServiceNow', 'CI/CD', 'GitOps',
  'IAM', 'ALB', 'Route 53', 'CloudFormation', 'Catchpoint', 'Dynatrace'
];
// Duplicate for seamless infinite scroll
const marqueeSkills = [...allSkills, ...allSkills];

const gitChips = [
  { label: 'main', cls: 'git-chip--violet' },
  { label: '→ checkout -b feat/ci', cls: '' },
  { label: 'pipeline.yml', cls: 'git-chip--cyan' },
  { label: '✓ checks passing', cls: 'git-chip--green' },
  { label: '● secure', cls: 'git-chip--green' },
  { label: 'merge → main', cls: 'git-chip--violet' },
  { label: 'v2.0.0', cls: 'git-chip--cyan' },
  { label: '✓ deployed', cls: 'git-chip--green' },
  { label: 'status: 200 OK', cls: 'git-chip--green' },
];
---

<section class="relative overflow-hidden pt-4" id="top">
  <!-- Marquee background flourish -->
  <div class="pointer-events-none absolute inset-x-0 bottom-12 opacity-[0.045] select-none" aria-hidden="true">
    <div class="marquee-outer">
      <div class="marquee-track font-mono text-sm uppercase tracking-widest text-slate-200">
        {marqueeSkills.map((skill) => (
          <span class="flex-shrink-0 whitespace-nowrap px-3">{skill}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="mx-auto grid min-h-0 max-w-7xl items-center gap-8 px-4 pb-8 pt-4 sm:gap-10 sm:px-6 sm:pb-10 sm:pt-8 lg:min-h-[calc(100vh-5.5rem)] lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:pt-8 w-full max-w-full min-w-0">

    <!-- LEFT COLUMN -->
    <div class="reveal-up w-full min-w-0">
      <!-- Eyebrow: Role — rendered above name but deliberately smaller/muted -->
      <p class="hero-eyebrow break-words leading-relaxed text-xs uppercase tracking-widest text-cyan">
        DevOps &amp; Cloud Engineer
      </p>

      <!-- Display name — PRIMARY visual element -->
      <h1 class="hero-display-name mt-2 sm:mt-3 break-words">
        {profile.name}
      </h1>

      <!-- Tagline -->
      <p class="hero-tagline mt-4 sm:mt-5 text-sm sm:text-base lg:text-lg leading-relaxed text-slate-300 w-full max-w-full">
        {profile.tagline}
      </p>

      <!-- ── PRIMARY CTAs ── -->
      <div class="mt-7 sm:mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-2.5 sm:gap-3 w-full max-w-full">
        <!-- 1. Let's connect — PRIMARY -->
        <a
          href="/#contact"
          id="hero-cta-connect"
          class="inline-flex items-center justify-between sm:justify-center gap-2 rounded-[12px] bg-cyan px-5 py-3 text-sm sm:text-base font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-white text-center w-full sm:w-auto"
        >
          <span>Let's connect</span> <ArrowRight size={16} />
        </a>
        <!-- 2. View the work — SECONDARY -->
        <a
          href="/projects"
          id="hero-cta-work"
          class="inline-flex items-center justify-between sm:justify-center gap-2 rounded-[12px] border border-white/12 bg-white/[0.045] px-5 py-3 text-sm sm:text-base font-semibold text-white transition hover:-translate-y-0.5 hover:border-violet/45 text-center w-full sm:w-auto"
        >
          <span>View the work</span> <ArrowRight size={16} class="sm:hidden" />
        </a>
      </div>

      <!-- ── SECONDARY QUICK-LINKS: Resume · GitHub · LinkedIn ── -->
      <div class="mt-3 flex flex-col sm:flex-row sm:flex-wrap gap-2 sm:gap-2.5 w-full max-w-full">
        <!-- Resume — important career CTA, stands out with border-cyan -->
        <a
          href={profile.resume}
          id="hero-cta-resume"
          class="inline-flex items-center justify-between sm:justify-center gap-2 rounded-[10px] border border-cyan/35 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-200 transition hover:-translate-y-0.5 hover:border-cyan/60 hover:text-white text-center w-full sm:w-auto"
        >
          <span><Download size={14} class="inline mr-1.5" />Resume</span>
        </a>
        <!-- GitHub -->
        <a
          href={profile.github}
          id="hero-cta-github"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-between sm:justify-center gap-2 rounded-[10px] border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-300 transition hover:-translate-y-0.5 hover:border-white/25 hover:text-white text-center w-full sm:w-auto"
        >
          <span><Code size={14} class="inline mr-1.5" />GitHub</span>
        </a>
        <!-- LinkedIn — recruiter destination, surface clearly -->
        <a
          href={profile.linkedin}
          id="hero-cta-linkedin"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          class="inline-flex items-center justify-between sm:justify-center gap-2 rounded-[10px] border border-violet/30 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-300 transition hover:-translate-y-0.5 hover:border-violet/55 hover:text-white text-center w-full sm:w-auto"
        >
          <span><BriefcaseBusiness size={14} class="inline mr-1.5" />LinkedIn</span>
        </a>
      </div>

      <!-- Status meta block — recruiter-relevant info -->
      <div class="mt-6 sm:mt-7 status-meta-block">
        <span><span class="s-label">status</span><span class="s-live">● available</span></span>
        <span><span class="s-label">location</span>Bengaluru, India</span>
        <span><span class="s-label">experience</span>5+ years</span>
        <span><span class="s-label">local</span><span id="hero-clock" class="s-clock">--:--:--</span></span>
      </div>

      <!-- Git chip strip — tertiary decoration, aria-hidden -->
      <div class="mt-4 sm:mt-5 git-strip" aria-hidden="true">
        {gitChips.map((chip) => (
          <span class:list={['git-chip', chip.cls]}>{chip.label}</span>
        ))}
      </div>

      <!-- Scroll cue -->
      <a href="/#identity" class="scroll-cue mt-6 sm:mt-8 inline-flex" aria-label="Scroll to Identity section">
        <ChevronDown size={14} />&nbsp;scroll down
      </a>
    </div>

    <!-- RIGHT COLUMN — DEPLOY-MONITOR / Production System Dashboard -->
    <div class="relative reveal-up w-full min-w-0 lg:pt-4" style="animation-delay: 120ms;">
      <div class="w-full max-w-full lg:max-w-lg mx-auto lg:mx-0 rounded-[20px] sm:rounded-[22px] border border-white/10 bg-panel2/90 p-4 sm:p-6 shadow-2xl backdrop-blur-md min-w-0 box-border overflow-hidden">
        <!-- Terminal Header -->
        <div class="flex items-center justify-between border-b border-white/[0.08] pb-3 sm:pb-3.5">
          <div class="flex items-center gap-2 min-w-0">
            <span class="status-dot red flex-shrink-0"></span>
            <span class="status-dot amber flex-shrink-0"></span>
            <span class="status-dot green flex-shrink-0"></span>
            <span class="ml-1 font-mono text-[10px] sm:text-[11px] uppercase tracking-widest text-slate-300 truncate">deploy-monitor // k8s-prod</span>
          </div>
          <span class="rounded-full border border-mint/30 bg-mint/10 px-2 sm:px-2.5 py-0.5 font-mono text-[8px] sm:text-[9px] uppercase tracking-widest text-mint font-semibold flex-shrink-0">
            ● healthy
          </span>
        </div>

        <!-- Command Line -->
        <div class="mt-3 sm:mt-4 font-mono text-[11px] sm:text-xs text-slate-300 truncate">
          <span class="text-mint">$</span> <span class="text-cyan">kubectl</span> get pods -n production
        </div>

        <!-- Pods Status List -->
        <div class="mt-3 sm:mt-3.5 space-y-2 font-mono text-[10px] sm:text-[11px]">
          <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3 py-2 sm:px-3.5 sm:py-2.5 border border-white/[0.04]">
            <div class="flex items-center gap-2 min-w-0">
              <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-mint flex-shrink-0"></span>
              <span class="text-slate-200 truncate">api-service-prod</span>
            </div>
            <div class="flex items-center gap-2 sm:gap-3 text-slate-400 flex-shrink-0">
              <span>3/3</span>
              <span class="text-mint font-medium">Running</span>
            </div>
          </div>

          <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3 py-2 sm:px-3.5 sm:py-2.5 border border-white/[0.04]">
            <div class="flex items-center gap-2 min-w-0">
              <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-mint flex-shrink-0"></span>
              <span class="text-slate-200 truncate">auth-microservice</span>
            </div>
            <div class="flex items-center gap-2 sm:gap-3 text-slate-400 flex-shrink-0">
              <span>2/2</span>
              <span class="text-mint font-medium">Running</span>
            </div>
          </div>

          <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3 py-2 sm:px-3.5 sm:py-2.5 border border-white/[0.04]">
            <div class="flex items-center gap-2 min-w-0">
              <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-mint flex-shrink-0"></span>
              <span class="text-slate-200 truncate">ingress-alb-controller</span>
            </div>
            <div class="flex items-center gap-2 sm:gap-3 text-slate-400 flex-shrink-0">
              <span>2/2</span>
              <span class="text-mint font-medium">Running</span>
            </div>
          </div>

          <div class="flex items-center justify-between rounded-xl bg-white/[0.03] px-3 py-2 sm:px-3.5 sm:py-2.5 border border-white/[0.04]">
            <div class="flex items-center gap-2 min-w-0">
              <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-cyan flex-shrink-0"></span>
              <span class="text-slate-200 truncate">prometheus-collector</span>
            </div>
            <div class="flex items-center gap-2 sm:gap-3 text-slate-400 flex-shrink-0">
              <span>1/1</span>
              <span class="text-cyan font-medium">Healthy</span>
            </div>
          </div>
        </div>

        <!-- Telemetry & Deploy Metrics Grid (2x2 equal grid) -->
        <!-- Note: values below are system-state labels, not claimed production metrics -->
        <div class="mt-3.5 sm:mt-4 grid grid-cols-2 gap-2 sm:gap-2.5 pt-3 border-t border-white/[0.08]">
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2 sm:p-2.5 flex flex-col justify-between">
            <span class="block font-mono text-[8px] sm:text-[9px] uppercase tracking-wider text-muted">deployment</span>
            <span class="mt-0.5 block font-mono text-[10px] sm:text-xs font-semibold text-mint">zero-downtime deploys</span>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2 sm:p-2.5 flex flex-col justify-between">
            <span class="block font-mono text-[8px] sm:text-[9px] uppercase tracking-wider text-muted">gitops sync</span>
            <span class="mt-0.5 block font-mono text-[10px] sm:text-xs font-semibold text-cyan">Argo CD · in-sync</span>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2 sm:p-2.5 flex flex-col justify-between">
            <span class="block font-mono text-[8px] sm:text-[9px] uppercase tracking-wider text-muted">iac state</span>
            <span class="mt-0.5 block font-mono text-[10px] sm:text-xs font-semibold text-slate-200">Terraform · 0 drift</span>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2 sm:p-2.5 flex flex-col justify-between">
            <span class="block font-mono text-[8px] sm:text-[9px] uppercase tracking-wider text-muted">cluster health</span>
            <span class="mt-0.5 block font-mono text-[10px] sm:text-xs font-semibold text-mint">cluster: healthy</span>
          </div>
        </div>
      </div>

      <!-- Mobile Scroll cue -->
      <div class="mt-6 text-center sm:hidden">
        <a href="/#identity" class="scroll-cue inline-flex" aria-label="Scroll to Identity section">
          <ChevronDown size={14} />&nbsp;scroll down
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Hero live clock
  (function () {
    var el = document.getElementById('hero-clock');
    if (!el) return;
    function tick() {
      var now = new Date();
      var h = String(now.getHours()).padStart(2, '0');
      var m = String(now.getMinutes()).padStart(2, '0');
      var s = String(now.getSeconds()).padStart(2, '0');
      el.textContent = h + ':' + m + ':' + s;
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

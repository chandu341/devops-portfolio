---
import { BriefcaseBusiness, Building, Check, Code, Download, Mail, MapPin, Phone, Sparkles } from '@lucide/astro';
import { profile } from '@/data/profile';
---

<section id="identity" class="section-pad relative border-t border-white/[0.07] bg-white/[0.015]" aria-label="Identity and Profile">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 reveal-up">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.24em] text-violet">01 — identity</p>
      <h2 class="mt-2 text-3xl font-semibold text-white sm:text-4xl">Engineering profile</h2>
    </div>

    <div class="surface relative overflow-hidden rounded-[20px] sm:rounded-[24px] border border-white/[0.08] p-4 sm:p-8 lg:p-10 reveal-up w-full max-w-full min-w-0 box-border">
      <div class="grid gap-6 sm:gap-8 items-center lg:grid-cols-[240px_1fr] lg:gap-10 w-full min-w-0">
        <!-- Column 1: Primary Profile Photo (Single Source of Truth) -->
        <div class="flex justify-center flex-shrink-0">
          <div class="relative aspect-square w-36 sm:w-48 lg:w-56 overflow-hidden rounded-2xl border-2 border-white/15 bg-panel2 shadow-2xl">
            <img
              class="h-full w-full object-cover object-center"
              src={profile.photo}
              alt="Chandu Venna - DevOps / Cloud Engineer"
              loading="eager"
            />
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center rounded-full border border-white/15 bg-ink/90 px-2.5 py-0.5 font-mono text-[9px] uppercase tracking-widest text-slate-200 shadow-md backdrop-blur-md">
                verified ✓
              </span>
            </div>
          </div>
        </div>

        <!-- Column 2: Identity Information -->
        <div class="flex flex-col justify-center items-center lg:items-start text-center lg:text-left min-w-0 w-full">
          <!-- Item 6: Small line above name — use for current employer (additive info) instead of repeating title -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 sm:gap-3">
            <span class="font-mono text-[11px] sm:text-xs tracking-wide text-slate-400">Currently at Genpact — Honeywell account</span>
            <span class="rounded-full border border-mint/30 bg-mint/10 px-2.5 py-0.5 font-mono text-[9px] sm:text-[10px] uppercase tracking-wider text-mint">
              ● {profile.availability}
            </span>
          </div>

          <!-- Name — strong heading -->
          <h3 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-semibold text-white break-words w-full">{profile.name}</h3>
          <!-- Item 6: Single clear title under name — no duplication -->
          <p class="mt-1 font-mono text-xs sm:text-sm uppercase tracking-wider text-cyan w-full">{profile.title}</p>

          <p class="mt-3 sm:mt-4 max-w-2xl text-sm sm:text-base leading-relaxed text-muted text-center lg:text-left">
            {profile.summary}
          </p>

          <!-- Key Metadata Strip — Location / Experience / Availability / Employer -->
          <div class="mt-5 sm:mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4 font-mono text-xs text-slate-300 w-full text-left">
            <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3 py-2.5">
              <MapPin size={14} class="text-cyan flex-shrink-0" />
              <span class="truncate">{profile.location}</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3 py-2.5">
              <Sparkles size={14} class="text-violet flex-shrink-0" />
              <span>{profile.experience} Experience</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3 py-2.5">
              <Building size={14} class="text-cyan flex-shrink-0" />
              <span class="truncate">Genpact · Honeywell</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3 py-2.5">
              <Check size={14} class="text-mint flex-shrink-0" />
              <span class="text-mint">Available for Hire</span>
            </div>
          </div>

          <!-- Contact Action Buttons — priority: LinkedIn → GitHub → Resume → Email → Phone -->
          <!-- Item 5: Phone surfaced as visible text button -->
          <div class="mt-5 sm:mt-6 grid grid-cols-2 sm:grid-cols-3 lg:flex lg:flex-wrap items-center gap-2.5 sm:gap-3 w-full">
            <!-- 1. LinkedIn — primary recruiter destination -->
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-xl border border-violet/30 bg-white/[0.04] px-3 py-3 sm:px-4 text-xs sm:text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-violet/55 hover:bg-white/[0.08] text-center w-full lg:w-auto"
            >
              <BriefcaseBusiness size={14} /> LinkedIn
            </a>
            <!-- 2. GitHub -->
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3 py-3 sm:px-4 text-xs sm:text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-cyan/40 hover:bg-white/[0.08] text-center w-full lg:w-auto"
            >
              <Code size={14} /> GitHub
            </a>
            <!-- 3. Resume — filled white, highest visual weight -->
            <a
              href={profile.resume}
              class="inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-xl bg-white px-3 py-3 sm:px-4 text-xs sm:text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-cyan text-center w-full lg:w-auto"
            >
              <Download size={14} /> Resume
            </a>
            <!-- 4. Email -->
            <a
              href={`mailto:${profile.email}`}
              class="inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3 py-3 sm:px-4 text-xs sm:text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-mint/40 hover:bg-white/[0.08] text-center w-full lg:w-auto"
            >
              <Mail size={14} /> Email
            </a>
            <!-- 5. Phone — visible text, not just floating icon -->
            <a
              href={`tel:${profile.phone.replace(/\s+/g, '')}`}
              class="inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3 py-3 sm:px-4 text-xs sm:text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-cyan/40 hover:bg-white/[0.08] text-center w-full lg:w-auto"
            >
              <Phone size={14} /> {profile.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
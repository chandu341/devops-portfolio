---
import { BriefcaseBusiness, Check, Code, Download, Mail, MapPin, Sparkles } from '@lucide/astro';
import { profile } from '@/data/profile';
---

<section id="identity" class="section-pad relative border-t border-white/[0.07] bg-white/[0.015]" aria-label="Identity and Profile">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 reveal-up">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.24em] text-violet">01 — identity</p>
      <h2 class="mt-2 text-3xl font-semibold text-white sm:text-4xl">Engineering profile</h2>
    </div>

    <div class="surface relative overflow-hidden rounded-[24px] border border-white/[0.08] p-6 sm:p-8 lg:p-10 reveal-up">
      <div class="grid gap-8 items-center lg:grid-cols-[260px_1fr] lg:gap-12">
        <!-- Column 1: Primary Profile Photo (Single Source of Truth) -->
        <div class="flex justify-center">
          <div class="relative aspect-square w-44 sm:w-52 lg:w-64 overflow-hidden rounded-2xl border-2 border-white/15 bg-panel2 shadow-2xl">
            <img
              class="h-full w-full object-cover object-center"
              src={profile.photo}
              alt={`${profile.name} - ${profile.title}`}
              loading="eager"
            />
            <div class="absolute bottom-2.5 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center rounded-full border border-white/15 bg-ink/90 px-3 py-1 font-mono text-[9px] sm:text-[10px] uppercase tracking-widest text-slate-200 shadow-md backdrop-blur-md">
                verified ✓
              </span>
            </div>
          </div>
        </div>

        <!-- Column 2: Identity Information -->
        <div class="flex flex-col justify-center">
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-cyan">DevOps &amp; Cloud Practitioner</span>
            <span class="rounded-full border border-mint/30 bg-mint/10 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-mint">
              ● {profile.availability}
            </span>
          </div>

          <h3 class="mt-3 text-3xl sm:text-4xl font-semibold text-white">{profile.name}</h3>
          <p class="mt-1 font-mono text-sm sm:text-base uppercase tracking-wider text-slate-300">{profile.title}</p>

          <p class="mt-4 max-w-2xl text-base leading-7 text-muted">
            {profile.summary}
          </p>

          <!-- Key Metadata Strip -->
          <div class="mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-3 font-mono text-xs text-slate-300">
            <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3 py-2.5">
              <MapPin size={14} class="text-cyan flex-shrink-0" />
              <span>{profile.location}</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3 py-2.5">
              <Sparkles size={14} class="text-violet flex-shrink-0" />
              <span>{profile.experience} Experience</span>
            </div>
            <div class="flex items-center gap-2 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3 py-2.5">
              <Check size={14} class="text-mint flex-shrink-0" />
              <span class="text-mint">Available for Hire</span>
            </div>
          </div>

          <!-- Direct Action Buttons -->
          <div class="mt-6 flex flex-wrap items-center gap-2.5 sm:gap-3">
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-cyan/40 hover:bg-white/[0.08]"
            >
              <Code size={15} /> GitHub
            </a>
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-violet/40 hover:bg-white/[0.08]"
            >
              <BriefcaseBusiness size={15} /> LinkedIn
            </a>
            <a
              href={profile.resume}
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-cyan"
            >
              <Download size={15} /> Resume
            </a>
            <a
              href={`mailto:${profile.email}`}
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:border-mint/40 hover:bg-white/[0.08]"
            >
              <Mail size={15} /> Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
---
import { ExternalLink, Layers, Sparkles } from '@lucide/astro';
import ArchitectureDiagram from '@/components/ArchitectureDiagram.astro';
import { projects } from '@/data/profile';

const featuredProject = projects[0];
const secondaryProjects = projects.slice(1);
---

<section id="projects" class="section-pad" aria-label="Selected engineering case studies">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">

    <!-- Section Header -->
    <div class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 reveal-up">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
          <span class="inline-block h-1.5 w-3 rounded-full bg-cyan" aria-hidden="true"></span>
          05 — ls projects/
        </p>
        <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
          Things I've shipped.
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl font-normal">
          Enterprise cloud migrations, Kubernetes GitOps platforms, and telemetry architectures derived from verified production experience.
        </p>
      </div>

      <a
        href="/projects"
        class="self-start sm:self-auto inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-white/80 dark:bg-white/[0.04] px-4 py-2 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 hover:border-cyan/50 hover:text-cyan shadow-xs transition"
      >
        <span>All projects archive</span>
        <ExternalLink size={14} />
      </a>
    </div>

    <!-- Projects Grid: Featured 1.15fr + Side Column 0.85fr -->
    <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">

      <!-- Featured Project Card (Project 01) -->
      <article class="project-card project-card--featured surface rounded-2xl sm:rounded-3xl p-5 sm:p-7 lg:p-8 reveal-up shadow-md border border-cyan/30 dark:border-cyan/20 flex flex-col justify-between">
        <div>
          <!-- Meta Header -->
          <div class="flex items-center justify-between gap-3 border-b border-slate-200/80 dark:border-white/[0.07] pb-3.5 mb-4">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] sm:text-xs font-semibold uppercase tracking-[0.18em] text-slate-600 dark:text-slate-400">
                01 | {featuredProject.category}
              </span>
              {featuredProject.client && (
                <span class="rounded bg-cyan/10 dark:bg-cyan/15 border border-cyan/30 px-1.5 py-0.5 font-mono text-[9px] font-bold text-cyan">
                  {featuredProject.client}
                </span>
              )}
            </div>
            <span class="rounded-full bg-mint/12 px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-mint flex items-center gap-1.5 border border-mint/20">
              <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse"></span>
              deployed
            </span>
          </div>

          <!-- Project Title & Problem -->
          <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-slate-900 dark:text-white font-display">
            {featuredProject.name}
          </h3>
          <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
            {featuredProject.problem}
          </p>

          <!-- Impact Metrics Grid -->
          <div class="mt-5 grid gap-2.5 sm:grid-cols-3">
            {featuredProject.metrics.map((metric) => (
              <div class="rounded-xl bg-slate-100/90 dark:bg-ink/60 p-3 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-white/5 flex items-center gap-2">
                <Sparkles size={14} class="text-cyan flex-shrink-0" />
                <span>{metric}</span>
              </div>
            ))}
          </div>

          <!-- Architecture Visual Flow -->
          <div class="mt-5 rounded-xl sm:rounded-2xl bg-slate-950 p-3.5 sm:p-4 text-white overflow-hidden shadow-inner border border-white/10">
            <div class="flex items-center justify-between mb-3 border-b border-white/10 pb-2">
              <span class="font-mono text-[10px] text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                <Layers size={12} class="text-cyan" />
                Architecture Topology
              </span>
              <span class="font-mono text-[9px] text-cyan">AWS EKS + GitOps</span>
            </div>
            <ArchitectureDiagram groups={featuredProject.architecture} />
          </div>
        </div>

        <!-- Footer Action Link -->
        <div class="mt-6 pt-4 border-t border-slate-200/80 dark:border-white/[0.07] flex items-center justify-between">
          <div class="flex flex-wrap gap-1.5">
            {featuredProject.stack.slice(0, 5).map((tech) => (
              <span class="rounded-md bg-slate-100 dark:bg-white/[0.04] border border-slate-200 dark:border-white/5 px-2 py-0.5 text-[10px] font-mono text-slate-600 dark:text-slate-400">
                {tech}
              </span>
            ))}
          </div>
          <a
            href={`/projects/${featuredProject.slug}`}
            class="inline-flex items-center gap-2 rounded-xl bg-slate-900 dark:bg-white px-4 py-2.5 text-xs sm:text-sm font-semibold text-white dark:text-ink transition hover:-translate-y-0.5 shadow-sm flex-shrink-0"
          >
            <span>Read case study</span>
            <ExternalLink size={14} />
          </a>
        </div>
      </article>

      <!-- Secondary Projects Column (Projects 02 & 03) -->
      <div class="grid gap-5 sm:gap-6">
        {secondaryProjects.map((project, index) => (
          <article
            class="project-card surface rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-white/[0.08] p-5 sm:p-6 reveal-up flex flex-col justify-between shadow-sm transition hover:border-cyan/40"
            style={`animation-delay:${index * 80}ms`}
          >
            <div>
              <!-- Top Row -->
              <div class="flex items-center justify-between gap-3 border-b border-slate-200/80 dark:border-white/[0.07] pb-3 mb-3.5">
                <div class="flex items-center gap-2">
                  <p class="font-mono text-[10px] sm:text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-muted">
                    0{index + 2} | {project.category}
                  </p>
                  {project.client && (
                    <span class="rounded bg-violet/10 dark:bg-violet/15 border border-violet/30 px-1.5 py-0.5 font-mono text-[9px] font-bold text-violet">
                      {project.client}
                    </span>
                  )}
                </div>
                <span class="rounded-full bg-violet/10 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-violet border border-violet/20">
                  production
                </span>
              </div>

              <!-- Title & Problem -->
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white font-display">
                {project.name}
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {project.problem}
              </p>

              <!-- Metrics -->
              <div class="mt-3.5 flex flex-wrap gap-1.5">
                {project.metrics.map((metric) => (
                  <span class="rounded-lg bg-slate-100 dark:bg-white/[0.06] border border-slate-200 dark:border-white/5 px-2.5 py-1 text-[10px] uppercase tracking-[0.12em] text-slate-700 dark:text-slate-200 font-mono">
                    {metric}
                  </span>
                ))}
              </div>
            </div>

            <!-- Bottom Link -->
            <div class="mt-5 pt-3.5 border-t border-slate-200/80 dark:border-white/[0.07] flex items-center justify-between">
              <span class="font-mono text-[10px] text-slate-500 dark:text-slate-400 truncate max-w-[200px]">
                {project.stack.slice(0, 3).join(' · ')}
              </span>
              <a
                href={`/projects/${project.slug}`}
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-violet hover:text-cyan transition"
              >
                <span>Open case study</span>
                <ExternalLink size={14} />
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>

  </div>
</section>

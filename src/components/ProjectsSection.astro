---
import { CircleCheck, Layers, Sparkles } from '@lucide/astro';
import ArchitectureDiagram from '@/components/ArchitectureDiagram.astro';
import { projects } from '@/data/profile';
---

<section id="projects" class="section-pad scroll-mt-16 sm:scroll-mt-20 border-t border-slate-200 dark:border-white/[0.07]" aria-label="Production engineering projects and architecture">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">

    <!-- Section Header -->
    <div class="mb-8 sm:mb-12 reveal-up">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center gap-2">
        <span class="inline-block h-1.5 w-3 rounded-full bg-cyan" aria-hidden="true"></span>
        Production Engineering Projects
      </p>
      <h2 class="mt-2.5 sm:mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
        Projects &amp; Infrastructure Architecture
      </h2>
      <p class="mt-2 max-w-3xl text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Key production systems, enterprise cloud migrations, and Kubernetes GitOps platforms delivered across 5+ years of verified production experience.
      </p>
    </div>

    <!-- Production Projects Displayed Directly -->
    <div class="space-y-8 sm:space-y-10">
      {projects.map((project, index) => (
        <article
          class="surface rounded-2xl sm:rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-white/[0.08] shadow-sm hover:border-cyan/40 transition duration-300 reveal-up"
          style={`animation-delay: ${index * 80}ms`}
        >
          <!-- Project Top Header -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200/80 dark:border-white/[0.07] pb-4 mb-5">
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-cyan">
                0{index + 1} &nbsp;|&nbsp; {project.category}
              </span>
              {project.client && (
                <span class="rounded-lg bg-violet/10 dark:bg-violet/15 border border-violet/30 px-2 py-0.5 font-mono text-[10px] font-bold text-violet">
                  Client: {project.client}
                </span>
              )}
            </div>
            <span class="rounded-full bg-mint/10 border border-mint/25 px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-mint flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse"></span>
              Production Verified
            </span>
          </div>

          <!-- Project Title & Summary -->
          <div class="mb-6">
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-slate-900 dark:text-white font-display">
              {project.name}
            </h3>
            <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              {project.summary}
            </p>
          </div>

          <!-- Problem & Architectural Solution Grid -->
          <div class="grid gap-4 md:grid-cols-2 mb-6">
            <div class="rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/[0.05] p-4 sm:p-5">
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-amber block mb-2">
                Challenge &amp; Production Requirements
              </span>
              <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                {project.problem}
              </p>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/[0.05] p-4 sm:p-5">
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-cyan block mb-2">
                Engineering Solution &amp; Delivery
              </span>
              <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                {project.solution}
              </p>
            </div>
          </div>

          <!-- Impact Metrics Grid -->
          <div class="mb-6">
            <span class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400 block mb-2.5">
              Quantifiable Impact &amp; Results
            </span>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5">
              {project.metrics.map((metric) => (
                <div class="rounded-xl bg-slate-100/90 dark:bg-ink p-3 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-white/5 flex items-center gap-2">
                  <Sparkles size={14} class="text-mint flex-shrink-0" />
                  <span class="truncate">{metric}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Architecture Visual Topology Console -->
          <div class="mb-6 rounded-2xl bg-slate-950 p-4 sm:p-5 text-white overflow-hidden shadow-inner border border-white/10">
            <div class="flex items-center justify-between mb-3.5 border-b border-white/10 pb-2.5">
              <span class="font-mono text-[11px] text-slate-300 uppercase tracking-wider flex items-center gap-1.5 font-semibold">
                <Layers size={13} class="text-cyan" />
                Architecture Topology Flow
              </span>
              <span class="font-mono text-[10px] text-cyan font-bold">
                {project.stack.slice(0, 2).join(' + ')}
              </span>
            </div>
            <ArchitectureDiagram groups={project.architecture} />
          </div>

          <!-- Key Production Outcomes Checklist -->
          <div class="mb-6 rounded-xl bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/[0.04] p-4 sm:p-5">
            <span class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400 block mb-3">
              Verified Production Milestones
            </span>
            <div class="grid gap-2 sm:grid-cols-2">
              {project.outcomes.map((outcome) => (
                <div class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                  <CircleCheck size={15} class="text-mint flex-shrink-0 mt-0.5" />
                  <span>{outcome}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Technology Stack Badges -->
          <div class="pt-4 border-t border-slate-200/80 dark:border-white/[0.07] flex flex-wrap items-center gap-1.5">
            <span class="font-mono text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400 mr-1.5">
              Stack:
            </span>
            {project.stack.map((tech) => (
              <span class="rounded-lg bg-slate-100 dark:bg-white/[0.05] border border-slate-200 dark:border-white/10 px-2.5 py-1 text-xs font-mono text-slate-700 dark:text-slate-300 font-medium">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

---
import { Moon, Sun } from '@lucide/astro';

interface Props {
  class?: string;
  id?: string;
}

const { class: className = '', id = 'theme-toggle-btn' } = Astro.props;
---

<button
  id={id}
  type="button"
  aria-label="Toggle dark and light theme"
  class:list={[
    "theme-toggle-btn relative inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-300/80 dark:border-white/10 bg-slate-100 dark:bg-white/[0.04] text-slate-700 dark:text-slate-200 transition-all duration-300 hover:scale-105 hover:border-cyan/50 dark:hover:border-cyan/50 hover:bg-slate-200/80 dark:hover:bg-white/[0.08] focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan shadow-sm cursor-pointer",
    className
  ]}
>
  <!-- Sun Icon (visible in Dark mode to switch to Light) -->
  <span class="theme-icon-sun pointer-events-none absolute transition-all duration-300 transform scale-0 rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100 text-amber-400">
    <Sun size={17} />
  </span>
  
  <!-- Moon Icon (visible in Light mode to switch to Dark) -->
  <span class="theme-icon-moon pointer-events-none absolute transition-all duration-300 transform scale-100 rotate-0 opacity-100 dark:scale-0 dark:-rotate-90 dark:opacity-0 text-slate-700">
    <Moon size={16} />
  </span>
</button>

<script is:inline>
  (function () {
    // Prevent multiple registrations across multiple component instances
    if (window.__themeToggleScriptLoaded) return;
    window.__themeToggleScriptLoaded = true;

    function getTheme() {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    }

    function setTheme(theme) {
      const isDark = theme === 'dark';
      if (isDark) {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      }
      window.dispatchEvent(new CustomEvent('theme-changed', { detail: { isDark } }));
    }

    // Global delegated click listener for all theme toggle buttons
    document.addEventListener('click', function (e) {
      const target = e.target;
      const toggleBtn = target && target.closest ? target.closest('.theme-toggle-btn') : null;
      if (!toggleBtn) return;
      
      e.preventDefault();
      e.stopPropagation();
      const currentTheme = getTheme();
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
      setTheme(nextTheme);
    });
  })();
</script>

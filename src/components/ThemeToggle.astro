---
import { Sun, Moon } from '@lucide/astro';

interface Props {
  class?: string;
  id?: string;
}

const { class: className = '', id = 'theme-toggle-btn' } = Astro.props;
---

<button
  id={id}
  type="button"
  class:list={[
    "theme-toggle-button relative inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-300/80 dark:border-white/10 bg-slate-100 dark:bg-white/[0.04] text-slate-700 dark:text-slate-200 transition-all duration-300 hover:border-violet/50 dark:hover:border-violet/50 hover:bg-slate-200/80 dark:hover:bg-white/[0.08] focus:outline-none focus-visible:ring-2 focus-visible:ring-violet shadow-sm cursor-pointer overflow-hidden",
    className
  ]}
  aria-label="Toggle dark and light theme"
  title="Toggle dark / light theme"
>
  <!-- Moon Icon (Visible in Light mode to switch to Dark) -->
  <span class="theme-icon-moon-wrap flex items-center justify-center transition-all duration-300 dark:opacity-0 dark:scale-0 dark:rotate-90 opacity-100 scale-100 rotate-0">
    <Moon size={17} class="text-slate-800 transition-transform duration-300 hover:-rotate-12" />
  </span>

  <!-- Sun Icon (Visible in Dark mode to switch to Light) -->
  <span class="theme-icon-sun-wrap absolute flex items-center justify-center transition-all duration-300 opacity-0 scale-0 -rotate-90 dark:opacity-100 dark:scale-100 dark:rotate-0">
    <Sun size={17} class="text-amber-300 transition-transform duration-300 hover:rotate-45" />
  </span>
</button>

<script is:inline>
  (function () {
    if (window.__themeToggleLoaded) return;
    window.__themeToggleLoaded = true;

    var PALETTES = {
      DARK: 'obsidian-violet',
      LIGHT: 'cloud-daylight'
    };

    function getCurrentTheme() {
      var storedPalette = localStorage.getItem('portfolio-palette');
      if (storedPalette === 'midnight-cloud' || storedPalette === 'graphite-copper') {
        storedPalette = PALETTES.DARK;
        localStorage.setItem('portfolio-palette', storedPalette);
      }

      if (storedPalette === PALETTES.LIGHT || storedPalette === PALETTES.DARK) {
        return storedPalette === PALETTES.DARK ? 'dark' : 'light';
      }

      var storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark' || storedTheme === 'light') {
        return storedTheme;
      }

      var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      return systemDark ? 'dark' : 'light';
    }

    function setTheme(mode, dispatch) {
      var isDark = mode === 'dark';
      var palette = isDark ? PALETTES.DARK : PALETTES.LIGHT;

      document.documentElement.setAttribute('data-palette', palette);
      document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');

      if (isDark) {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        localStorage.setItem('portfolio-palette', PALETTES.DARK);
      } else {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        localStorage.setItem('portfolio-palette', PALETTES.LIGHT);
      }

      // Update meta theme-color
      var metaThemeColor = document.querySelector('meta[name="theme-color"]');
      if (metaThemeColor) {
        metaThemeColor.setAttribute('content', isDark ? '#0B0B10' : '#F4F8FA');
      }

      // Update button aria-labels
      document.querySelectorAll('.theme-toggle-button').forEach(function (btn) {
        btn.setAttribute(
          'aria-label',
          isDark ? 'Switch to Light Mode (Cloud Daylight)' : 'Switch to Dark Mode (Obsidian Violet)'
        );
      });

      if (dispatch !== false) {
        window.dispatchEvent(
          new CustomEvent('theme-changed', {
            detail: { isDark: isDark, mode: isDark ? 'dark' : 'light' }
          })
        );
        window.dispatchEvent(
          new CustomEvent('palette-changed', {
            detail: {
              palette: palette,
              isDark: isDark,
              primary: isDark ? '#9B7BF0' : '#0284C7',
              secondary: isDark ? '#6C8CE0' : '#059669'
            }
          })
        );
      }
    }

    function toggleTheme() {
      var current = getCurrentTheme();
      var next = current === 'dark' ? 'light' : 'dark';
      setTheme(next, true);
    }

    // Attach click listeners to all theme toggle buttons
    document.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('.theme-toggle-button') : null;
      if (btn) {
        e.preventDefault();
        toggleTheme();
      }
    });

    // Listen to system theme preference changes if user hasn't explicitly set one
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      if (!localStorage.getItem('theme') && !localStorage.getItem('portfolio-palette')) {
        setTheme(e.matches ? 'dark' : 'light', true);
      }
    });

    // Initial sync
    var initialMode = getCurrentTheme();
    setTheme(initialMode, false);
  })();
</script>

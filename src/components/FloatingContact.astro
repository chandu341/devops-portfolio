---
import { MessageSquare } from '@lucide/astro';
---

<div id="floating-contact" class="fixed right-4 bottom-5 z-40 sm:right-6 sm:bottom-6">
  <a
    href="#contact"
    id="floating-trigger-btn"
    aria-label="Scroll to Contact section"
    class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-white/15 bg-slate-900 dark:bg-white text-white dark:text-ink px-4 py-2.5 text-xs font-semibold shadow-lg hover:shadow-xl transition-all duration-200 hover:scale-105 active:scale-95 group"
  >
    <MessageSquare size={14} class="text-cyan dark:text-ink transition-transform duration-200 group-hover:scale-110" />
    <span>Let's Talk</span>
    <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse" aria-hidden="true"></span>
  </a>
</div>


---
import {
  ArrowUpRight,
  BriefcaseBusiness,
  Check,
  Copy,
  Download,
  Mail,
  MapPin,
  MessageCircle,
  Phone,
  Sparkles
} from '@lucide/astro';
import { profile } from '@/data/profile';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section id="contact" class:list={["section-pad scroll-mt-16 sm:scroll-mt-20 relative overflow-hidden border-t border-slate-200 dark:border-white/[0.07] bg-slate-50/60 dark:bg-ink", className]} aria-label="Contact and Communication">
  <!-- Ambient Glow -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute bottom-0 right-1/4 h-[350px] w-[350px] rounded-full bg-cyan/[0.05] dark:bg-cyan/[0.07] blur-[100px]"></div>
    <div class="absolute top-1/4 left-10 h-[300px] w-[300px] rounded-full bg-violet/[0.04] dark:bg-violet/[0.06] blur-[90px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full min-w-0 box-border">

    <!-- Section Header -->
    <div class="mb-8 sm:mb-10 text-center max-w-3xl mx-auto reveal-up">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-violet dark:text-violet inline-flex items-center justify-center gap-2">
        <span class="inline-block h-1.5 w-3 rounded-full bg-cyan" aria-hidden="true"></span>
        Direct Communication &amp; Inquiries
      </p>
      <h2 class="mt-2.5 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
        Let's Connect &amp; Collaborate
      </h2>
      <p class="mt-2.5 text-sm sm:text-base text-slate-600 dark:text-slate-300 font-normal leading-relaxed">
        Looking for a verified DevOps | Cloud | SRE Engineer for high-availability cloud architecture, Kubernetes GitOps platforms, or full-time opportunities? Connect directly through the channels below.
      </p>
    </div>

    <!-- Unified Contact Hub -->
    <div class="max-w-4xl mx-auto surface rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-white/[0.08] p-5 sm:p-7 shadow-sm reveal-up">

      <!-- Status Header Bar -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-5 mb-5 border-b border-slate-200/80 dark:border-white/[0.07]">
        <div class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-mint/10 text-mint flex-shrink-0">
            <Sparkles size={16} />
          </span>
          <div>
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-mint animate-pulse"></span>
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Active Status: Available for Hire</span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">DevOps | Cloud | SRE Engineering roles</p>
          </div>
        </div>
        <div class="flex items-center gap-1.5 font-mono text-xs text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-white/[0.04] px-3 py-1.5 rounded-xl border border-slate-200/60 dark:border-white/5">
          <MapPin size={13} class="text-violet" />
          <span>Bengaluru, India (Remote / Hybrid)</span>
        </div>
      </div>

      <!-- Compact Channels Grid -->
      <div class="grid gap-3.5 sm:grid-cols-2">

        <!-- 1. LinkedIn -->
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl border border-slate-200/90 dark:border-white/[0.07] bg-white/80 dark:bg-white/[0.02] p-4 transition-all duration-200 hover:border-violet/50 hover:bg-violet/[0.03] flex items-center justify-between gap-3"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="grid h-10 w-10 place-items-center rounded-xl bg-violet/10 text-violet flex-shrink-0 group-hover:scale-105 transition-transform">
              <BriefcaseBusiness size={20} />
            </div>
            <div class="min-w-0">
              <span class="block text-sm font-bold text-slate-900 dark:text-white font-display">LinkedIn</span>
              <span class="block font-mono text-xs text-slate-600 dark:text-slate-300 truncate">in/im-chanduvenna</span>
            </div>
          </div>
          <span class="inline-flex items-center gap-1 font-mono text-[11px] font-semibold text-violet bg-violet/10 border border-violet/20 px-2.5 py-1 rounded-lg flex-shrink-0">
            <span>Connect</span>
            <ArrowUpRight size={12} />
          </span>
        </a>

        <!-- 2. WhatsApp Direct Chat -->
        <a
          href={profile.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl border border-slate-200/90 dark:border-white/[0.07] bg-white/80 dark:bg-white/[0.02] p-4 transition-all duration-200 hover:border-mint/50 hover:bg-mint/[0.03] flex items-center justify-between gap-3"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="grid h-10 w-10 place-items-center rounded-xl bg-mint/10 text-mint flex-shrink-0 group-hover:scale-105 transition-transform">
              <MessageCircle size={20} />
            </div>
            <div class="min-w-0">
              <span class="block text-sm font-bold text-slate-900 dark:text-white font-display">WhatsApp</span>
              <span class="block font-mono text-xs text-slate-600 dark:text-slate-300 truncate">+91 96660 32664</span>
            </div>
          </div>
          <span class="inline-flex items-center gap-1 font-mono text-[11px] font-semibold text-mint bg-mint/10 border border-mint/20 px-2.5 py-1 rounded-lg flex-shrink-0">
            <span>Instant Chat</span>
            <ArrowUpRight size={12} />
          </span>
        </a>

        <!-- 3. Direct Email Channel with Copy -->
        <div class="rounded-xl border border-slate-200/90 dark:border-white/[0.07] bg-white/80 dark:bg-white/[0.02] p-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="grid h-10 w-10 place-items-center rounded-xl bg-cyan/10 text-cyan flex-shrink-0">
              <Mail size={20} />
            </div>
            <div class="min-w-0">
              <span class="block text-sm font-bold text-slate-900 dark:text-white font-display">Direct Email</span>
              <a href={`mailto:${profile.email}`} class="block font-mono text-xs text-cyan hover:underline truncate">
                {profile.email}
              </a>
            </div>
          </div>
          <button
            type="button"
            id="quick-copy-email-btn"
            aria-label="Copy email address"
            class="inline-flex items-center gap-1 rounded-lg border border-slate-300 dark:border-white/15 bg-slate-100 dark:bg-white/[0.05] px-2.5 py-1 font-mono text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:border-cyan hover:text-cyan transition-colors cursor-pointer flex-shrink-0"
          >
            <Copy size={12} id="copy-icon" />
            <Check size={12} id="check-icon" class="hidden text-mint" />
            <span id="quick-copy-text">Copy</span>
          </button>
        </div>

        <!-- 4. Direct Phone -->
        {profile.showPhone && (
          <a
            href={`tel:${profile.phone.replace(/\s+/g, '')}`}
            class="group rounded-xl border border-slate-200/90 dark:border-white/[0.07] bg-white/80 dark:bg-white/[0.02] p-4 transition-all duration-200 hover:border-cyan/50 hover:bg-cyan/[0.03] flex items-center justify-between gap-3"
          >
            <div class="flex items-center gap-3 min-w-0">
              <div class="grid h-10 w-10 place-items-center rounded-xl bg-cyan/10 text-cyan flex-shrink-0 group-hover:scale-105 transition-transform">
                <Phone size={20} />
              </div>
              <div class="min-w-0">
                <span class="block text-sm font-bold text-slate-900 dark:text-white font-display">Direct Phone</span>
                <span class="block font-mono text-xs text-slate-600 dark:text-slate-300 truncate">{profile.phone}</span>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 font-mono text-[11px] font-semibold text-cyan bg-cyan/10 border border-cyan/20 px-2.5 py-1 rounded-lg flex-shrink-0">
              <span>Call</span>
              <ArrowUpRight size={12} />
            </span>
          </a>
        )}

      </div>

      <!-- Resume Download Banner -->
      <div class="mt-4 pt-4 border-t border-slate-200/80 dark:border-white/[0.07] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="p-2 rounded-lg bg-amber/10 text-amber flex-shrink-0">
            <Download size={16} />
          </span>
          <div>
            <span class="block text-xs font-bold text-slate-900 dark:text-white font-display">Verified Technical Resume</span>
            <span class="block font-mono text-[11px] text-slate-600 dark:text-slate-400">PDF format · 5+ years enterprise DevOps experience</span>
          </div>
        </div>
        <a
          href={profile.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-xl border border-amber/40 bg-amber/10 hover:bg-amber/20 text-amber px-3.5 py-2 font-mono text-xs font-bold transition shadow-xs flex-shrink-0"
        >
          <Download size={13} />
          <span>Download Resume</span>
        </a>
      </div>

    </div>

  </div>
</section>

<!-- Client-Side Copy Email Script -->
<script is:inline define:vars={{ targetEmail: profile.email }}>
  (function () {
    var copyBtn = document.getElementById('quick-copy-email-btn');
    var copyText = document.getElementById('quick-copy-text');
    var copyIcon = document.getElementById('copy-icon');
    var checkIcon = document.getElementById('check-icon');

    if (!copyBtn || !copyText) return;

    copyBtn.addEventListener('click', function () {
      navigator.clipboard.writeText(targetEmail).then(function () {
        copyText.textContent = 'Copied!';
        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');
        copyBtn.classList.add('border-mint', 'text-mint');

        setTimeout(function () {
          copyText.textContent = 'Copy';
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
          copyBtn.classList.remove('border-mint', 'text-mint');
        }, 2200);
      }).catch(function (err) {
        console.error('Copy failed:', err);
      });
    });
  })();
</script>

---
import { ArrowUp, BookOpen, BriefcaseBusiness, Code, FolderGit2, Mail, Phone } from '@lucide/astro';
import { profile } from '@/data/profile';
---

<footer class="border-t border-slate-200 dark:border-white/[0.07] bg-white dark:bg-ink transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-10 border-b border-slate-200 dark:border-white/[0.07]">

      <!-- Col 1: Identity & Bio -->
      <div class="space-y-3">
        <a href="/#top" class="group flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-slate-900 dark:bg-white text-xs font-bold text-white dark:text-ink transition-all group-hover:scale-105 shadow-sm">
            CV
          </span>
          <div>
            <span class="block text-base font-bold text-slate-900 dark:text-white font-display">{profile.name}</span>
            <span class="block font-mono text-[10px] uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">DevOps &amp; Cloud Engineer</span>
          </div>
        </a>
        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400 max-w-sm">
          {profile.tagline}
        </p>
      </div>

      <!-- Col 2: Quick Links & Case Studies -->
      <div class="space-y-3">
        <p class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white">Navigation &amp; Deep Dives</p>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li>
            <a href="/projects" class="inline-flex items-center gap-1.5 hover:text-cyan transition-colors">
              <FolderGit2 size={13} class="text-violet" />
              <span>Project Case Studies Archive</span>
            </a>
          </li>
          <li>
            <a href="/engineering" class="inline-flex items-center gap-1.5 hover:text-cyan transition-colors">
              <BookOpen size={13} class="text-cyan" />
              <span>DevOps Playbooks &amp; Incident Runbooks</span>
            </a>
          </li>
          <li>
            <a href="/#experience" class="inline-flex items-center gap-1.5 hover:text-cyan transition-colors">
              <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>
              <span>Career History (GENPACT · Honeywell &amp; GE)</span>
            </a>
          </li>
          <li>
            <a href="/#skills" class="inline-flex items-center gap-1.5 hover:text-cyan transition-colors">
              <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
              <span>Toolchain &amp; Declarative Stack</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Direct Connect & Resume -->
      <div class="space-y-3">
        <p class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white">Direct Connect</p>
        <div class="flex flex-wrap items-center gap-2">
          <a class="rounded-xl p-2.5 border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.03] text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-white/[0.08] hover:text-slate-950 dark:hover:text-white transition shadow-2xs" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Code size={16} /></a>
          <a class="rounded-xl p-2.5 border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.03] text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-white/[0.08] hover:text-slate-950 dark:hover:text-white transition shadow-2xs" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><BriefcaseBusiness size={16} /></a>
          <a class="rounded-xl p-2.5 border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.03] text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-white/[0.08] hover:text-slate-950 dark:hover:text-white transition shadow-2xs" href={`mailto:${profile.email}`} aria-label="Email"><Mail size={16} /></a>
          <a class="rounded-xl p-2.5 border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.03] text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-white/[0.08] hover:text-slate-950 dark:hover:text-white transition shadow-2xs" href={`tel:${profile.phone.replace(/\s+/g, '')}`} aria-label="Phone"><Phone size={16} /></a>
        </div>
        <div class="pt-1 flex items-center gap-2">
          <a class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 dark:border-white/15 bg-slate-900 dark:bg-white text-white dark:text-ink px-4 py-2 text-xs font-semibold shadow-sm transition hover:scale-105" href={profile.resume}>Download Resume</a>
          <a class="inline-flex items-center gap-1 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.03] px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:border-cyan hover:text-cyan transition" href="#top">
            <ArrowUp size={13} /> Top
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Status -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
      <p>&copy; {new Date().getFullYear()} {profile.name}. All rights reserved.</p>
      <p class="font-mono text-[11px] uppercase tracking-[0.16em]">
        deployed from Bengaluru, India &nbsp;·&nbsp; status: <span class="text-mint font-semibold">operational</span>
      </p>
    </div>
  </div>
</footer>

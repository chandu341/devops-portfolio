---
import { ArrowUp } from '@lucide/astro';
import { profile } from '@/data/profile';
---

<footer class="border-t border-slate-200 dark:border-white/[0.07] bg-white dark:bg-ink transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Top Row: Identity & Quick Back to Top -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200/80 dark:border-white/[0.07]">
      <a href="/#top" class="group flex items-center gap-3" aria-label="Back to top">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-slate-900 dark:bg-white text-xs font-bold text-white dark:text-ink transition-all group-hover:scale-105 shadow-sm flex-shrink-0">
          CV
        </span>
        <div>
          <span class="block text-sm sm:text-base font-bold text-slate-900 dark:text-white font-display">{profile.name}</span>
          <span class="block font-mono text-[9px] sm:text-[10px] uppercase tracking-[0.16em] text-cyan font-semibold">DevOps | Cloud | SRE Engineer</span>
        </div>
      </a>

      <!-- Clean Back to Top Trigger -->
      <a
        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/[0.04] px-3.5 py-1.5 font-mono text-xs font-semibold text-slate-700 dark:text-slate-300 hover:border-cyan hover:text-cyan transition shadow-2xs cursor-pointer"
        href="#top"
        aria-label="Scroll back to top"
      >
        <ArrowUp size={14} />
        <span>Back to Top</span>
      </a>
    </div>

    <!-- Bottom Row: Copyright & Status -->
    <div class="pt-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 text-xs text-slate-600 dark:text-slate-400">
      <p>&copy; {new Date().getFullYear()} {profile.name}. All rights reserved.</p>
      <p class="font-mono text-[11px] uppercase tracking-[0.16em]">
        Bengaluru, India &nbsp;·&nbsp; status: <span class="text-mint font-semibold">available for hire</span>
      </p>
    </div>
  </div>
</footer>
